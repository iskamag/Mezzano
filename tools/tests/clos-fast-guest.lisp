;;;; Regression checks for the CLOS dispatch/boxed-slot x86-64 fast paths.
(defpackage :clos-fast-test (:use :cl) (:export :run))
(in-package :clos-fast-test)
(defclass box ()
  ((x :initarg :x :initform 1 :type fixnum :accessor box-x)
   (y :accessor box-y)
   (shared :allocation :class :initform 17 :accessor box-shared)))
(defclass child (box) ())
(defclass other (box) ())
(defclass callable () ((x :initform 23 :accessor callable-x))
  (:metaclass mezzano.clos:funcallable-standard-class))
(defclass unbound-box () ((x :accessor unbound-x)))
(defmethod slot-unbound ((class standard-class) (object unbound-box) name)
  (declare (ignore class object name))
  (values :unbound :extra))
(defgeneric identify (object))
(defmethod identify ((object t)) :built-in)
(defmethod identify ((object box)) :box)
(defmethod identify ((object child)) :child)
(defmethod identify ((object callable)) :callable)

(defun signals (type thunk)
  (handler-case (progn (funcall thunk) nil)
    (error (condition) (typep condition type))))

(defun compare-lookup (table object expected)
  (assert (eql expected (mezzano.clos::single-dispatch-emf-entry-by-object table object)))
  #+x86-64
  (assert (eql expected (mezzano.clos::single-dispatch-emf-entry-by-object-slow table object))))

(defun check-tables ()
  (let* ((object (make-instance 'box))
         (class (class-of object))
         (table (mezzano.clos::make-single-dispatch-emf-table #'identify))
         (hash (mezzano.internals::layout-hash (mezzano.internals::%instance-layout object))))
    (compare-lookup table object nil)
    (setf (mezzano.clos::single-dispatch-emf-entry table class) 0)
    (compare-lookup table object 0)
    (compare-lookup table (make-instance 'child) nil)
    (setf (mezzano.clos::single-dispatch-emf-entry table (class-of 42)) :integer)
    (compare-lookup table 42 :integer)
    (compare-lookup table object 0)
    ;; Exercise the collision recurrence and tombstones deterministically.
    (let ((storage (make-array 16 :initial-element nil))
          (slot (logand hash #xffffffff)) (perturb hash) (offsets nil))
      (loop until (= (length offsets) 4)
            do (pushnew (logand slot 15) offsets)
               (setf slot (logand #xffffffff (+ (* slot 5) perturb 1))
                     perturb (ash perturb -5)))
      (setf offsets (nreverse offsets))
      (setf (svref storage (first offsets)) t
            (svref storage (second offsets))
            (mezzano.extensions:make-weak-pointer (find-class 'child) :value :wrong)
            (svref storage (third offsets))
            (mezzano.extensions:make-weak-pointer class :value :collision))
      (setf (mezzano.clos::fast-class-hash-table-table
             (mezzano.clos::single-dispatch-emf-table-table table)) storage)
      (compare-lookup table object :collision)
      (setf (svref storage (third offsets))
            (mezzano.extensions:make-weak-pointer class :value :replacement))
      (compare-lookup table object :replacement)
      (setf (svref storage (third offsets)) t)
      (compare-lookup table object nil))
    (mezzano.clos::clear-single-dispatch-emf-table table)
    (compare-lookup table object nil)))

(defun check-slots-and-redefinition ()
  (let ((object (make-instance 'child :x 41)) (second (make-instance 'box))
        (callable (make-instance 'callable)))
    (mezzano.clos:set-funcallable-instance-function callable (lambda (x) (+ x 1)))
    (assert (= (funcall callable 2) 3))
    (assert (= (callable-x callable) 23))
    (assert (equal (multiple-value-list (setf (callable-x callable) 29)) '(29)))
    (assert (equal (multiple-value-list (box-x object)) '(41)))
    (assert (equal (multiple-value-list (setf (box-x object) 42)) '(42)))
    (assert (= (box-shared object) 17))
    (setf (box-shared object) 19)
    (assert (= (box-shared second) 19))
    (setf (box-shared object) 17)
    (assert (signals 'type-error (lambda () (setf (box-x object) :invalid))))
    (assert (= (box-x object) 42))
    (assert (signals 'unbound-slot (lambda () (box-y object))))
    (assert (equal (multiple-value-list (unbound-x (make-instance 'unbound-box))) '(:unbound)))
    (setf (box-y object) nil)
    (assert (equal (multiple-value-list (box-y object)) '(nil)))
    (dotimes (i 100)
      (assert (eq (identify object) :child))
      (assert (eq (identify second) :box))
      (assert (eq (identify callable) :callable))
      (assert (eq (identify 1) :built-in)))
    ;; Populate caches, then replace and remove a method on an unchanged class.
    (eval '(defmethod identify ((object child)) :changed))
    (assert (eq (identify object) :changed))
    (remove-method #'identify (find-method #'identify nil (list (find-class 'child))))
    (assert (eq (identify object) :box))
    (eval '(defmethod identify ((object child)) :child))
    ;; Class redefinition changes slot positions; the first read migrates the
    ;; old instance, subsequent reads exercise the superseded-instance path.
    (eval '(defclass child (box) ((added :initform 73 :accessor child-added))))
    (assert (= (box-x object) 42))
    (assert (= (slot-value object 'added) 73))
    (setf (box-x object) 43)
    (assert (= (box-x object) 43))
    (assert (eq (identify object) :child))
    (change-class object 'other)
    (assert (= (box-x object) 43))
    (assert (eq (identify object) :box))
    (setf (box-x object) 44)
    (assert (= (box-x object) 44))
    (mezzano.internals::gc :full t)
    (assert (= (box-x object) 44))
    (assert (eq (identify object) :box))))

(defun check-during-gc ()
  (let* ((object (make-instance 'box :x 42))
         (stop nil) (done nil) (failure nil) (iterations 0)
         (worker (mezzano.supervisor:make-thread
                  (lambda ()
                    (unwind-protect
                         (handler-case
                             (loop until stop do
                               (assert (= (box-x object) 42))
                               (setf (box-x object) 42)
                               (assert (eq (identify object) :box))
                               (incf iterations))
                           (error (c) (setf failure c)))
                      (setf done t)))
                  :name "CLOS fast paths under GC")))
    (declare (ignore worker))
    (unwind-protect
         (dotimes (i 3) (sleep 0.05) (mezzano.internals::gc :full t))
      (setf stop t))
    (loop repeat 500 until done do (sleep 0.01))
    (assert done)
    (assert (null failure) () "Worker failed: ~A" failure)
    (assert (plusp iterations))
    (format t "Concurrent access/GC: ~D iterations.~%" iterations)))

(defun run ()
  (check-tables)
  (check-slots-and-redefinition)
  (check-during-gc)
  (format t "CLOS FAST PATH TESTS PASSED~%"))
(run)
