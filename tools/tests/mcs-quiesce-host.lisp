;;; Run with: sbcl --script tools/tests/mcs-quiesce-host.lisp
;;; Execute the production scheduling inhibitor, quiesce handlers and finish
;;; function with synthetic CPU/thread state and a private-stack marker.
(defpackage :sys.int (:use :cl) (:export :%atomic-fixnum-add-symbol :msr))
(defpackage :mezzano.supervisor (:use :cl))
(in-package :mezzano.supervisor)
(defvar *events* nil)
(in-package :sys.int)
(defun %atomic-fixnum-add-symbol (symbol delta)
  (push :ack mezzano.supervisor::*events*)
  (incf (symbol-value symbol) delta))
(defun msr (register) (declare (ignore register)) 0)
(defun (setf msr) (value register) (declare (ignore register)) value)
(in-package :mezzano.supervisor)
(defstruct cpu (inhibit-scheduling 0) preemption-pending quiesce-deferred
               quiesce-ack-pending)
(defstruct thread state)
(defvar *cpu* (make-cpu))
(defvar *current* (make-thread :state :active))
(defvar *idle* (make-thread :state :runnable))
(defvar *non-quiescent-cpus-remaining* 1)
(defvar *on-private-stack* nil)
(defvar *deferred-ipi-count* 0)
(defvar *lapic-msr-base* 0)
(defconstant +msr-ia32-gs-base+ 0)
(defun local-cpu () *cpu*)
(defun current-thread () *current*)
(defun local-cpu-idle-thread () *idle*)
(defun preemption-timer-reset (value) (push (list :timer value) *events*))
(defun send-deferred-quiesce-ipi () (incf *deferred-ipi-count*))
(defun lapic-eoi () (push :eoi *events*))
(defun acquire-global-thread-lock () (push :acquire *events*))
(defun release-global-thread-lock ()
  (unless *on-private-stack* (error "MCS released on old stack"))
  (push :release *events*))
(defun push-run-queue (thread) (declare (ignore thread)) (push :enqueue *events*))
(defun save-fpu-state (thread) (declare (ignore thread)))
(defun save-interrupted-state (thread frame) (declare (ignore thread frame)))
(defun %%restore-full-save-thread (thread) (declare (ignore thread)) (push :restore *events*))
(defun %%restore-partial-save-thread (thread) (declare (ignore thread)) (push :restore *events*))
(defun thread-full-save-p (thread) (declare (ignore thread)) t)
(defun %%switch-to-thread-common (old new)
  (declare (ignore old))
  (push :switch *events*)
  (let ((*on-private-stack* t))
    (%%finish-switch-on-cpu-stack new)))
(defun sys.int::lisp-object-address (object) (declare (ignore object)) 0)
(defmacro safe-without-interrupts (() &body body) `(progn ,@body))
(defmacro ensure (condition &rest args) `(unless ,condition (error "Ensure failed: ~A" (list ,@args))))
(defmacro check (condition message) `(unless ,condition (error ,message)))
(defun load-defun (file name)
  (with-open-file (s (merge-pathnames file *load-truename*))
    (loop for pos = (file-position s)
          for line = (read-line s nil)
          while line
          when (search (format nil "(defun ~A " (string-downcase name)) line)
            do (file-position s pos) (eval (read s)) (return t))))
(load-defun "../../supervisor/thread.lisp" "ALLOW-LOCAL-CPU-SCHEDULING")
(load-defun "../../supervisor/thread.lisp" "%%FINISH-SWITCH-ON-CPU-STACK")

(defun reset-state (&optional (inhibited 0))
  (setf *cpu* (make-cpu :inhibit-scheduling inhibited)
        *current* (make-thread :state :active)
        *idle* (make-thread :state :runnable)
        *non-quiescent-cpus-remaining* 1
        *events* nil
        *on-private-stack* nil
        *deferred-ipi-count* 0))

(dolist (architecture '("x86-64" "arm64"))
  (let ((file (format nil "../../supervisor/~A/cpu.lisp" architecture)))
    (load-defun file "QUIESCE-IPI-HANDLER")
    (reset-state 2)
    (if (string= architecture "x86-64")
        (quiesce-ipi-handler nil nil)
        (quiesce-ipi-handler nil))
    (check (and (= *non-quiescent-cpus-remaining* 1)
                (cpu-quiesce-deferred *cpu*)
                (eq (thread-state *current*) :active)
                (not (member :acquire *events*)))
           "Quiesce switched a CPU-affine thread")
    (allow-local-cpu-scheduling)
    (check (and (= *deferred-ipi-count* 0)
                (= (cpu-inhibit-scheduling *cpu*) 1)
                (cpu-quiesce-deferred *cpu*))
           "Nested inhibitor retried quiesce too early")
    (allow-local-cpu-scheduling)
    (check (and (= *deferred-ipi-count* 1)
                (zerop (cpu-inhibit-scheduling *cpu*))
                (not (cpu-quiesce-deferred *cpu*)))
           "Outer inhibitor did not retry quiesce")
    (if (string= architecture "x86-64")
        (quiesce-ipi-handler nil nil)
        (quiesce-ipi-handler nil))
    (check (and (= *non-quiescent-cpus-remaining* 0)
                (not (cpu-quiesce-ack-pending *cpu*))
                (equal (subseq (reverse *events*) (- (length *events*) 4))
                       '(:switch :release :ack :restore)))
           "Quiesce acknowledged before private-stack MCS release")
    (reset-state)
    (setf *current* *idle*)
    (if (string= architecture "x86-64")
        (quiesce-ipi-handler nil nil)
        (quiesce-ipi-handler nil))
    (check (and (= *non-quiescent-cpus-remaining* 0)
                (not (member :acquire *events*)))
           "Already-idle CPU failed immediate acknowledgment")))
(format t "MCS quiesce host: x86/ARM defer, retry, private-stack ack, idle ack passed~%")
