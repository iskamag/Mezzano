;;;; Execute the actual source entry and inhibition/release owners against
;;;; controlled scheduler primitives. This tests Lisp control/ownership, not
;;;; native CPU quiescence, residency, allocation freedom or VM execution.
;;;; From the Mezzano source directory:
;;;; sbcl --no-sysinit --no-userinit --script tools/tests/world-stop-host.lisp
(defpackage :world-stop-test-atomic (:use))
(defpackage :world-stop-host-test
  (:use :cl)
  (:local-nicknames (:sys.int :world-stop-test-atomic)))
(in-package :world-stop-host-test)

(defparameter *source-root*
  (merge-pathnames "../../" *load-truename*))
(defvar *checks* 0)
(defun check (test)
  (incf *checks*)
  (unless test (error "World-stop host check ~D failed" *checks*)))

(defstruct (test-thread (:conc-name thread-))
  thread-pool (allow-with-footholds t) (inhibit-footholds 0))
(defstruct queue entries)
(defconstant +thread-inhibit-footholds+ 0)
(defvar *self*)
(defvar *current*)
(defvar *world-stopper*)
(defvar *pseudo-atomic*)
(defvar *pending-world-stoppers*)
(defvar *pending-pseudo-atomics*)
(defvar *pseudo-atomic-thread-count*)
(defvar *stage*)
(defvar *events*)
(defvar *mutation*)
(defvar *pending-foothold*)
(defvar *panic-state*)
(defvar *interrupts-enabled*)
(defun current-thread () *current*)
(defun panic (&rest message)
  ;; The real PANIC never unwinds. The controlled escape exposes its entry
  ;; state; it supplies no evidence about native panic output or halting.
  (setf *panic-state*
        (list :owner *world-stopper* :inhibited (thread-inhibit-footholds *self*)
              :allow (thread-allow-with-footholds *self*)
              :pool (thread-thread-pool *self*) :mutation *mutation*))
  (throw 'panic message))
(defun ensure-interrupts-enabled ()
  (unless *interrupts-enabled* (panic "Interrupts disabled")))
(defun fail-at (stage)
  (when (eq *stage* stage) (throw 'aborted stage)))
(defun inhibited-p ()
  (and (plusp (thread-inhibit-footholds *self*))
       (null (thread-allow-with-footholds *self*))
       (null (thread-thread-pool *self*))))
(setf (fdefinition 'sys.int::%atomic-fixnum-add-object)
      (lambda (thread offset delta)
        (check (= offset +thread-inhibit-footholds+))
        (prog1 (thread-inhibit-footholds thread)
          (incf (thread-inhibit-footholds thread) delta))))
(defun run-pending-footholds ()
  ;; Real PANIC cannot unwind into this cleanup; discard only the host escape
  ;; artifact. Its inhibition state was already captured at the panic entry.
  (when *panic-state* (return-from run-pending-footholds))
  (push :foothold-check *events*)
  (when *pending-foothold*
    (check (not (eq *world-stopper* *self*)))
    (check (zerop (thread-inhibit-footholds *self*)))
    (check (eq :pool (thread-thread-pool *self*)))
    (throw 'terminated :after-release)))
(defun %stop-the-world (sp fp)
  (declare (ignore sp fp))
  (push :acquire *events*)
  (check (inhibited-p))
  (fail-at :before-acquire)
  (setf *world-stopper* *self*)
  (fail-at :after-acquire))
(defun quiesce-cpus-for-world-stop ()
  (push :quiesce *events*)
  (check (and (eq *world-stopper* *self*) (inhibited-p)))
  (fail-at :quiesce))
(defun %call-on-wired-stack-without-interrupts (entry ignored)
  (declare (ignore ignored))
  (check (inhibited-p))
  (when (eq entry #'%resume-the-world)
    (push :resume *events*)
    (fail-at :before-resume))
  (funcall entry nil nil)
  (when (eq entry #'%resume-the-world) (fail-at :after-resume)))
(defun acquire-stw-locks () (push :lock *events*))
(defun release-stw-locks () (push :unlock *events*))
(defun wait-queue-empty-p (queue) (null (queue-entries queue)))
(defun pop-wait-queue (queue) (pop (queue-entries queue)))
(defun wake-thread-1 (thread)
  (push (list :wake thread) *events*)
  (fail-at :wake))
(defun broadcast-wakeup-ipi ()
  (push :notify *events*)
  (check (inhibited-p))
  (fail-at :notify))

(defun source-definition (file kind name)
  ;; Read exactly the production definition. Earlier native #. forms and
  ;; unrelated cross-reader state are outside this host control harness.
  (with-open-file (in (merge-pathnames file *source-root*))
    (let* ((text (make-string (file-length in)))
           (prefix (format nil "(~A ~A " (string-downcase kind) (string-downcase name))))
      (read-sequence text in)
      (let ((start (search prefix text)))
        (unless start (error "No source definition ~A in ~A" name file))
        (let ((*package* (find-package :world-stop-host-test)))
          (read-from-string text nil nil :start start))))))
(eval (source-definition "supervisor/sync.lisp" "defmacro" "inhibit-thread-pool-blocking-hijack"))
(eval (source-definition "supervisor/thread.lisp" "defmacro" "without-footholds"))
(eval (source-definition "supervisor/thread.lisp" "defmacro" "with-footholds"))
(eval (source-definition "supervisor/thread.lisp" "defun" "%resume-the-world"))
(eval (source-definition "supervisor/thread.lisp" "defun" "call-with-world-stopped-or-panic"))

(defun run-case (thunk &key stage queued pending-pa pending-foothold
                       pseudo-atomic nested (interrupts-enabled t))
  (let* ((*self* (make-test-thread :thread-pool :pool)) (*current* *self*)
         (*world-stopper* (when nested *self*)) (*pseudo-atomic* pseudo-atomic)
         (*pending-world-stoppers* (make-queue :entries queued))
         (*pending-pseudo-atomics* (make-queue :entries pending-pa))
         (*pseudo-atomic-thread-count* 0) (*stage* stage) (*events* nil)
         (*mutation* nil) (*pending-foothold* pending-foothold)
         (*panic-state* nil) (*interrupts-enabled* interrupts-enabled))
    (let ((result
            (catch 'terminated
              (catch 'aborted
                (catch 'panic
                  (handler-case
                      (multiple-value-list (call-with-world-stopped-or-panic thunk))
                    (error () :escaped-error)))))))
      (values result *panic-state* (reverse *events*) *world-stopper*
              *pseudo-atomic-thread-count* *pending-pseudo-atomics*))))

(defun ordinary-body ()
  (push :body *events*)
  (check (and (eq *world-stopper* *self*) (inhibited-p)))
  (with-footholds
    (check (inhibited-p)))
  (setf *mutation* :visible)
  (values 17 nil :third))

(multiple-value-bind (values panic events owner count pending)
    (run-case #'ordinary-body :pending-pa '(:a :b))
  (check (equal '(17 nil :third) values))
  (check (null panic))
  (check (null owner))
  (check (= 2 count))
  (check (null (queue-entries pending)))
  (check (equal '(:acquire :quiesce :body :resume :lock (:wake :a) (:wake :b)
                  :unlock :notify :foothold-check) events)))
(multiple-value-bind (values panic events owner count pending)
    (run-case #'ordinary-body :queued '(:next-stopper) :pending-pa '(:a))
  (check (equal '(17 nil :third) values))
  (check (null panic))
  (check (eq :next-stopper owner))
  (check (zerop count))
  (check (equal '(:a) (queue-entries pending)))
  (check (member '(:wake :next-stopper) events :test #'equal)))
(multiple-value-bind (values panic)
    (run-case (lambda () (values)))
  (check (null values)) (check (null panic)))
(multiple-value-bind (values panic)
    (run-case (lambda () (values 1 2 3 4 5 6 7)))
  (check (equal '(1 2 3 4 5 6 7) values)) (check (null panic)))

;; Failure before ownership is established must also remain inside the fatal
;; boundary. Once acquired, no failed pre-release path calls the resume owner.
(dolist (stage '(:before-acquire :after-acquire :quiesce :before-resume))
  (multiple-value-bind (result panic events owner)
      (run-case #'ordinary-body :stage stage)
    (declare (ignore result owner))
    (check panic)
    (check (plusp (getf panic :inhibited)))
    (check (null (getf panic :allow)))
    (check (null (getf panic :pool)))
    (unless (eq stage :before-resume) (check (not (member :resume events))))))
(dolist (body (list (lambda () (setf *mutation* :visible) (error "failed mutation"))
                   (lambda () (setf *mutation* :visible) (throw 'aborted :body))))
  (multiple-value-bind (result panic events)
      (run-case body)
    (declare (ignore result))
    (check panic)
    (check (eq :visible (getf panic :mutation)))
    (check (getf panic :owner))
    (check (null (getf panic :pool)))
    (check (not (member :resume events)))))
;; A normal-returning body cannot authorize release of somebody else's stop.
(dolist (body (list (lambda () (setf *world-stopper* :other))
                   (lambda () (setf *current* :other))))
  (multiple-value-bind (result panic events)
      (run-case body)
    (declare (ignore result))
    (check panic) (check (not (member :resume events)))))

;; Once release has started, a failure is a fatal machine boundary; it cannot
;; be reported as retention of an old software stop after a queued handoff.
(dolist (stage '(:wake :after-resume :notify))
  (multiple-value-bind (result panic events owner)
      (run-case #'ordinary-body :stage stage :queued '(:next-stopper))
    (declare (ignore result))
    (check panic)
    (check (eq :next-stopper owner))
    (check (eq :next-stopper (getf panic :owner)))
    (check (member :resume events))
    (check (not (member :foothold-check events)))))
(multiple-value-bind (result panic events owner)
    (run-case #'ordinary-body :pending-foothold t)
  (check (eq :after-release result)) (check (null panic)) (check (null owner))
  (check (member :notify events)))
(dolist (options '((:nested t) (:pseudo-atomic t) (:interrupts-enabled nil)))
  (multiple-value-bind (result panic events)
      (apply #'run-case #'ordinary-body options)
    (declare (ignore result))
    (check panic) (check (not (member :acquire events)))))
(format t "WORLD-STOP HOST PASSED: ~D checks (source control only).~%" *checks*)
