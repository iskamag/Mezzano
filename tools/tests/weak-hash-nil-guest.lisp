(defpackage :mezzano.weak-hash-nil-test (:use :cl) (:export :run))
(in-package :mezzano.weak-hash-nil-test)

(defun check-absent (table)
  (multiple-value-bind (value presentp) (gethash nil table :missing)
    (assert (eq value :missing))
    (assert (not presentp)))
  (assert (not (remhash nil table))))

(defun install-ephemeral-value (table)
  (setf (gethash nil table) (vector 1 2 3))
  nil)

(defun run ()
  (dolist (test '(eq eql equal equalp))
    (dolist (weakness '(:key :value :key-or-value :key-and-value))
      (dolist (synchronized '(nil t))
        (let ((table (make-hash-table :test test :weakness weakness
                                      :synchronized synchronized)))
          (check-absent table)
          ;; Same hash and slot on both lookups: deletion leaves a tombstone.
          (setf (gethash nil table) :first)
          (assert (eq (gethash nil table) :first))
          (assert (remhash nil table))
          (check-absent table)
          (setf (gethash nil table) :second)
          (mezzano.internals::gc)
          (assert (eq (gethash nil table) :second))
          (mezzano.internals::gc :full t)
          (assert (eq (gethash nil table) :second))
          (assert (remhash nil table))
          (check-absent table)))))
  ;; A dead weak pointer also returns NIL as its key. It must behave as an
  ;; absent entry, including REMHASH, rather than matching the live NIL key.
  (dolist (test '(eq eql equal equalp))
    (dolist (weakness '(:value :key-and-value))
      (let ((table (make-hash-table :test test :weakness weakness)))
        (install-ephemeral-value table)
        (mezzano.internals::gc :full t)
        (check-absent table)
        (setf (gethash nil table) :replacement)
        (assert (eq (gethash nil table) :replacement)))))
  (format t "~&WEAK-HASH-NIL-TEST-PASSED tombstone-configurations=32 dead-entry-configurations=8~%")
  :passed)
