;;; Run with: sbcl --script tools/tests/acpi-madt-host.lisp
;;; Execute the real MADT parser against bounded synthetic physical memory.

(defpackage :sys.int (:use :cl) (:export #:make-simple-vector))
(in-package :sys.int)
(defun make-simple-vector (length &optional area)
  (declare (ignore area))
  (make-array length))

(defpackage :mezzano.supervisor (:use :cl))
(in-package :mezzano.supervisor)

(defstruct acpi-table-header address length)
(defstruct (acpi-madt-table (:include acpi-table-header))
  local-interrupt-controller-address flags controllers)
(defstruct acpi-madt-processor-lapic acpi-processor-id apic-id flags)
(defstruct acpi-madt-ioapic id address global-system-interrupt-base)
(defstruct acpi-madt-interrupt-source-override bus source global-system-interrupt flags)
(defstruct acpi-madt-nmi-source flags global-system-interrupt)
(defstruct acpi-madt-lapic-nmi acpi-processor-id flags lapic-lintn)
(defstruct acpi-madt-lapic-address-override address)
(defstruct acpi-madt-processor-x2apic x2apic-id flags acpi-processor-uid)

(define-condition madt-panic (error) ())
(defun panic (message)
  (declare (ignore message))
  (error 'madt-panic))

(defvar *memory*)
(defun read-physical (address width)
  (unless (<= (+ address width) (length *memory*))
    (error "Parser read past synthetic memory at ~D" address))
  (loop for i below width
        sum (ash (aref *memory* (+ address i)) (* i 8))))
(defun physical-memref-unsigned-byte-8 (address &optional offset)
  (read-physical (+ address (or offset 0)) 1))
(defun physical-memref-unsigned-byte-16 (address &optional offset)
  (read-physical (+ address (* (or offset 0) 2)) 2))
(defun physical-memref-unsigned-byte-32 (address &optional offset)
  (read-physical (+ address (* (or offset 0) 4)) 4))
(defun physical-memref-unsigned-byte-64 (address &optional offset)
  (read-physical (+ address (* (or offset 0) 8)) 8))
(defun read-acpi-table-header (table)
  (setf (acpi-table-header-length table) (physical-memref-unsigned-byte-32 4))
  table)

(let ((source (merge-pathnames "../../supervisor/acpi.lisp" *load-truename*)))
  (with-open-file (stream source)
    (loop for position = (file-position stream)
          for line = (read-line stream nil)
          while line
          when (or (search "(defun madt-entry-minimum-length " line)
                   (search "(defun read-acpi-madt-table " line))
            do (file-position stream position)
               (eval (read stream)))))

(defun put-le (bytes offset value width)
  (dotimes (i width)
    (setf (aref bytes (+ offset i)) (ldb (byte 8 (* i 8)) value)))
  bytes)
(defun entry (type length &rest fields)
  (let ((bytes (make-array length :element-type '(unsigned-byte 8) :initial-element 0)))
    (setf (aref bytes 0) type (aref bytes 1) length)
    (dolist (field fields)
      (destructuring-bind (offset value width) field
        (put-le bytes offset value width)))
    bytes))
(defun table-memory (&rest entries)
  (let* ((length (+ 44 (reduce #'+ entries :key #'length :initial-value 0)))
         (bytes (make-array length :element-type '(unsigned-byte 8) :initial-element 0))
         (offset 44))
    (put-le bytes 4 length 4)
    (dolist (entry entries)
      (replace bytes entry :start1 offset)
      (incf offset (length entry)))
    bytes))
(defun check (condition message)
  (unless condition (error "~A" message)))
(defun expect-panic (bytes)
  (let ((*memory* bytes))
    (handler-case
        (progn (read-acpi-madt-table 0)
               (error "Expected a MADT panic"))
      (madt-panic () t))))

(let* ((unknown (entry 42 2))
       (lapic (entry 0 8 '(2 3 1) '(3 7 1) '(4 1 4)))
       (x2apic (entry 9 16 '(4 #x12345678 4) '(8 1 4) '(12 #xabcdef 4)))
       (ioapic (entry 1 12 '(2 2 1) '(4 #xfec00000 4) '(8 32 4)))
       (source (entry 2 10 '(2 0 1) '(3 9 1) '(4 33 4) '(8 3 2)))
       (nmi (entry 3 8 '(2 3 2) '(4 34 4)))
       (lapic-nmi (entry 4 6 '(2 3 1) '(3 3 2) '(5 1 1)))
       (override (entry 5 12 '(4 #xfee00000 8)))
       (*memory* (table-memory unknown lapic x2apic ioapic source nmi lapic-nmi override unknown))
       (controllers (acpi-madt-table-controllers (read-acpi-madt-table 0))))
  (check (= (length controllers) 7) "Unknown entries shifted recognized MADT entries")
  (check (= (acpi-madt-processor-lapic-apic-id (aref controllers 0)) 7) "LAPIC decoded incorrectly")
  (check (= (acpi-madt-processor-x2apic-x2apic-id (aref controllers 1)) #x12345678)
         "x2APIC ID decoded incorrectly")
  (check (= (acpi-madt-processor-x2apic-acpi-processor-uid (aref controllers 1)) #xabcdef)
         "x2APIC UID decoded incorrectly")
  (check (= (acpi-madt-ioapic-global-system-interrupt-base (aref controllers 2)) 32)
         "IOAPIC decoded incorrectly")
  (check (and (acpi-madt-interrupt-source-override-p (aref controllers 3))
              (acpi-madt-nmi-source-p (aref controllers 4))
              (acpi-madt-lapic-nmi-p (aref controllers 5))
              (acpi-madt-lapic-address-override-p (aref controllers 6)))
         "Recognized MADT layouts shifted"))

(let ((bytes (table-memory)))
  (put-le bytes 4 43 4)
  (expect-panic bytes))

;;; Malformed known entries, zero length, truncated entry header, and overrun.
(expect-panic (table-memory (entry 9 15)))
(expect-panic (table-memory (entry 0 7)))
(let ((bytes (table-memory (entry 42 2))))
  (setf (aref bytes 45) 0)
  (expect-panic bytes))
(let ((bytes (table-memory)))
  (setf *memory* (concatenate '(vector (unsigned-byte 8)) bytes #(9)))
  (put-le *memory* 4 45 4)
  (expect-panic *memory*))
(let ((bytes (table-memory (entry 42 2))))
  (setf (aref bytes 45) 3)
  (expect-panic bytes))

(format t "ACPI MADT host parser: valid layouts and malformed bounds passed~%")
