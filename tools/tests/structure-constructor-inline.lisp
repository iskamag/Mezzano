;;;; Load in a running image. Tests default inlining, without INLINE at callers.
(defpackage :mezzano.structure-constructor-inline-test (:use :cl))
(in-package :mezzano.structure-constructor-inline-test)
(defvar *events* nil)
(defun record-event (value) (push value *events*) value)
(defun run ()
  (eval '(defstruct pair (left (record-event :left)) (right (record-event :right))))
  (assert (mezzano.compiler::function-inline-info 'make-pair))
  (let ((caller (compile nil '(lambda ()
                               (declare (optimize (speed 3) (safety 0)))
                               (make-pair :right (record-event :argument)))))
        (duplicates (compile nil '(lambda ()
                                   (make-pair :left (record-event :first)
                                              :left (record-event :second)
                                              :right nil))))
        (future-key (compile nil '(lambda () (make-pair :extra 17))))
        (dynamic-key (compile nil '(lambda (key value) (make-pair key value))))
        (notinline (compile nil '(lambda ()
                                  (declare (notinline make-pair))
                                  (make-pair :left nil :right nil)))))
    (let* ((*events* nil) (object (funcall caller)))
      (assert (equal (reverse *events*) '(:argument :left)))
      (assert (eq (pair-left object) :left))
      (assert (eq (pair-right object) :argument)))
    (let* ((*events* nil) (object (funcall duplicates)))
      (assert (equal (reverse *events*) '(:first :second)))
      (assert (eq (pair-left object) :first))
      (assert (null (pair-right object))))
    (assert (null (pair-left (funcall notinline))))
    (assert (handler-case (progn (funcall future-key) nil)
              (program-error () t)))
    ;; A saved inlined constructor must use new defaults and storage.
    (eval '(defstruct pair (left (record-event :new-left)) right (extra 42)))
    (let* ((*events* nil) (object (funcall caller)))
      (assert (equal (reverse *events*) '(:argument :new-left)))
      (assert (eq (pair-left object) :new-left))
      (assert (eq (pair-right object) :argument))
      (assert (= (funcall (symbol-function 'pair-extra) object) 42)))
    (assert (= (funcall (symbol-function 'pair-extra) (funcall future-key)) 17))
    (assert (= (funcall (symbol-function 'pair-extra) (funcall dynamic-key :extra 18)) 18))
    (let ((object (funcall notinline)))
      (assert (null (pair-left object)))
      (assert (= (funcall (symbol-function 'pair-extra) object) 42))))
  (format t "~&STRUCTURE-CONSTRUCTOR-INLINE-PASSED~%"))
(run)
