;;;; Regenerate weak-table functions without redefining the hash-table structs.
(in-package :mezzano.internals)
(eval-when (:compile-toplevel)
  (with-open-file (stream (merge-pathnames "system/hash-table.lisp" *mezzano-source-path*))
    (loop for form = (read stream nil :eof)
          until (eq form :eof)
          when (and (consp form) (eq (car form) 'eval-when)
                    (consp (third form)) (eq (car (third form)) 'defun)
                    (eq (second (third form)) 'probe-hash-table-slot))
            do (eval form) (return)
          finally (error "PROBE-HASH-TABLE-SLOT definition not found"))))
(define-optimized-hash-table-functions-internal standard-eq eq eq-hash t)
(define-optimized-hash-table-functions-internal standard-eql eql eql-hash t)
(define-optimized-hash-table-functions-internal standard-equal equal sxhash t)
(define-optimized-hash-table-functions-internal standard-equalp equalp equalp-hash t)
