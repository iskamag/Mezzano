;;; Run with: sbcl --script tools/tests/pr220-gic-target-host.lisp
;;; Execute the actual directed GIC sender with a non-enumeration target mask.

(defpackage :mezzano.supervisor (:use :cl))
(in-package :mezzano.supervisor)

(defstruct arm64-cpu gic-target-mask)
(defconstant +gicd-sgir+ #xF00)
(defconstant +gicd-itargetsr0+ #x800)
(defconstant +gic-sgi-all-but-self+ (ash 1 24))
(defconstant +gic-sgi-self-only+ (ash 2 24))
(defconstant +gicc-ctlr+ 0)
(defconstant +gicc-pmr+ 4)
(defconstant +panic-sgi-id+ 1)
(defconstant +wakeup-sgi-id+ 2)
(defconstant +quiesce-sgi-id+ 3)
(defconstant +magic-button-sgi-id+ 4)
(defvar *last-register* nil)
(defvar *last-value* nil)
(defvar *writes* nil)
(defvar *gic-distributor-base* 0)
(defvar *cpu-count* 8)
(defvar *local-target* #x20)
(defvar *local-cpu* (make-arm64-cpu))
(defmacro ensure (test &optional message)
  `(assert ,test () ,@(when message `("~A" ,message))))
(defun %dsb.ishst () nil)
(defun gic-max-cpu () *cpu-count*)
(defun gic-dist-reg (register)
  (assert (= register +gicd-itargetsr0+))
  *local-target*)
(defun local-cpu () *local-cpu*)
(defun (setf gic-cpui-reg) (value register)
  (declare (ignore register))
  value)
(defun gic-unmask-interrupt (vector) vector)
(defun (setf gic-dist-reg) (value register)
  (setf *last-register* register *last-value* value)
  (push (list register value) *writes*)
  value)

(with-open-file (stream (merge-pathnames "../../supervisor/arm64/gic.lisp"
                                         *load-truename*))
  (loop for position = (file-position stream)
        for line = (read-line stream nil)
        while line
        when (or (search "(defun send-ipi-to-cpu " line)
                 (search "(defun send-ipi-to-all " line)
                 (search "(defun configure-gic-cpu " line))
          do (file-position stream position)
             (eval (read stream))))

(configure-gic-cpu)
(assert (= (arm64-cpu-gic-target-mask *local-cpu*) #x20))
(let ((*cpu-count* 1) (*local-target* 0))
  (configure-gic-cpu)
  (assert (= (arm64-cpu-gic-target-mask *local-cpu*) 1)))
(setf (arm64-cpu-gic-target-mask *local-cpu*) #x20)

(setf *writes* nil)
(send-ipi-to-all 3)
(assert (equal (reverse *writes*)
               (list (list +gicd-sgir+ (logior +gic-sgi-all-but-self+ 3)))))
(setf *writes* nil)
(send-ipi-to-all 3 :including-self t)
(assert (equal (reverse *writes*)
               (list (list +gicd-sgir+ (logior +gic-sgi-all-but-self+ 3))
                     (list +gicd-sgir+ (logior +gic-sgi-self-only+ 3)))))

(let ((cpu (make-arm64-cpu :gic-target-mask #x20)))
  (send-ipi-to-cpu cpu 2)
  (assert (= *last-register* +gicd-sgir+))
  (assert (= *last-value* (logior (ash #x20 16) 2)))
  (setf (arm64-cpu-gic-target-mask cpu) 0)
  (assert (handler-case (progn (send-ipi-to-cpu cpu 2) nil)
            (error () t))))
(format t "PASS: GIC target discovery, directed SGI, and including-self broadcast.~%")
