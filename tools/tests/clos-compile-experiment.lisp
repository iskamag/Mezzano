;;;; Diagnostic A/B on the actual compiler workload. All function changes are
;;;; restored by UNWIND-PROTECT. No global optimization proclamations are changed.
(in-package :clos-compile)

(defun read-clos-definitions (names)
  (let ((*package* (find-package :mezzano.clos)) (result nil))
    (with-open-file (s "SYS:SOURCE;SYSTEM;CLOS;CLOSETTE.LISP")
      (loop for form = (read s nil :eof) until (eq form :eof)
            when (and (consp form) (eq (car form) 'defun)
                      (member (second form) names :test #'equal))
              do (push form result)))
    result))

(defun policy-experiment ()
  (let* ((names '(mezzano.clos::fast-slot-read mezzano.clos:standard-instance-access))
         (forms (read-clos-definitions names))
         (originals (mapcar (lambda (name) (cons name (fdefinition name))) names))
         (variants nil))
    (dolist (policy '((:debug0 (speed 3) (safety 3) (debug 0))
                      (:safety1 (speed 3) (safety 1) (debug 0))))
      (push (cons (car policy)
                  (mapcar (lambda (form)
                            (cons (second form)
                                  (compile nil `(lambda ,(third form)
                                                  (declare (optimize ,@(cdr policy)))
                                                  ,@(cdddr form))))) forms))
            variants))
    (push (cons :baseline originals) variants)
    (unwind-protect
         (progn
           (dotimes (rep 4)
             (dolist (variant (if (evenp rep) variants (reverse variants)))
               (dolist (entry (cdr variant))
                 (setf (fdefinition (car entry)) (cdr entry)))
               (compile-workload)
               (format t "VARIANT ~S REP ~D~%" (car variant) rep)
               (let* ((self (mezzano.supervisor:current-thread))
                      (bytes (mezzano.supervisor:thread-bytes-consed self))
                      (gc mezzano.internals::*gc-time*)
                      (cpu (mezzano.supervisor:thread-run-time self))
                      (start (get-internal-real-time)))
                 (compile-workload 5)
                 (format t "wall-ticks=~D cpu-ticks=~D bytes=~D gc-seconds=~,3F~%"
                         (- (get-internal-real-time) start)
                         (- (mezzano.supervisor:thread-run-time self) cpu)
                         (- (mezzano.supervisor:thread-bytes-consed self) bytes)
                         (- mezzano.internals::*gc-time* gc))
                 (finish-output))))
           (with-open-file (*standard-output* "REMOTE:/tmp/clos-cost/variants-asm.txt"
                                             :direction :output :if-exists :supersede)
             (dolist (variant variants)
               (format t "VARIANT ~S~%" (car variant))
               (dolist (entry (cdr variant))
                 (format t "FUNCTION ~S~%" (car entry))
                 (disassemble (cdr entry))))))
      (dolist (entry originals) (setf (fdefinition (car entry)) (cdr entry))))))

(policy-experiment)
