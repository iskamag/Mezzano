;;;; Flat-vector AREF keeps bounds/type checks and complex-array semantics.
(defpackage :array-vector-access-test (:use :cl) (:export :run))
(in-package :array-vector-access-test)

(defun signals-error-p (function)
  (handler-case (progn (funcall function) nil) (error () t)))

(defun check-vector (array value)
  (let ((last (1- (array-dimension array 0))))
    (assert (eql (funcall #'(setf mezzano.internals::aref-1) value array last) value))
    (assert (eql (mezzano.internals::aref-1 array last) value))
    (assert (eql (row-major-aref array last) value))
    (dolist (bad (list -1 (array-dimension array 0) (expt 2 100) 1/2 :bad))
      (assert (signals-error-p (lambda () (mezzano.internals::aref-1 array bad))))
      (assert (signals-error-p
               (lambda () (setf (mezzano.internals::aref-1 array bad) value)))))
    (assert (eql (row-major-aref array last) value))))

(defun run ()
  (dolist (case '((t :value) (bit 1) ((unsigned-byte 8) 255)
                  ((signed-byte 32) -17) (single-float 1.5) (double-float 2.5d0)))
    (check-vector (make-array 3 :element-type (first case)) (second case)))
  (let ((v (make-array 3 :initial-element 4)))
    (assert (= (mezzano.internals::cas (mezzano.internals::aref-1 v 1) 4 9) 4))
    (assert (= (mezzano.internals::cas (mezzano.internals::aref-1 v 1) 4 12) 9))
    (assert (= (aref v 1) 9)))
  (let ((v (make-array 3 :element-type '(unsigned-byte 8))))
    (assert (signals-error-p (lambda () (setf (mezzano.internals::aref-1 v 0) -1)))))
  (let ((empty (make-array 0)))
    (assert (signals-error-p (lambda () (mezzano.internals::aref-1 empty 0)))))
  ;; AREF uses the dimension, not the fill pointer.
  (check-vector (make-array 3 :adjustable t :fill-pointer 1) :past-fill-pointer)
  (let* ((backing (make-array 6 :initial-element 0))
         (view (make-array 3 :displaced-to backing :displaced-index-offset 2)))
    (check-vector view 17)
    (assert (= (aref backing 4) 17)))
  (check-vector (make-array 3 :element-type 'character :initial-element #\a) #\Space)
  (dolist (array (list (make-array nil) (make-array '(2 2))))
    (assert (signals-error-p (lambda () (mezzano.internals::aref-1 array 0)))))
  (format t "ARRAY-VECTOR-ACCESS-PASSED~%")
  :passed)
