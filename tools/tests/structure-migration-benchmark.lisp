;;;; Measure ordinary constructors before and after an inherited layout change.
(defpackage :mezzano.structure-migration-benchmark
  (:use :cl)
  (:export :run))
(in-package :mezzano.structure-migration-benchmark)

(defstruct original-parent (a 1) (added 3))
(defstruct (original-child (:include original-parent)) (local 2))
(defstruct rebuilt-parent (a 1))
(defstruct (rebuilt-child (:include rebuilt-parent)) (local 2))

(defun original-loop (count)
  (let ((sum 0))
    (dotimes (i count sum)
      (let ((object (make-original-child)))
        (incf sum (+ (original-child-a object) (original-child-added object)
                     (original-child-local object)))))))

(defun rebuilt-loop (count)
  (let ((sum 0))
    (dotimes (i count sum)
      (let ((object (make-rebuilt-child)))
        (incf sum (+ (rebuilt-child-a object) (rebuilt-child-added object)
                     (rebuilt-child-local object)))))))

(defun median (values)
  (nth (floor (length values) 2) (sort (coerce values 'list) #'<)))

(defun trial (function count)
  (let* ((thread (mezzano.supervisor:current-thread))
         (bytes-before (mezzano.supervisor:thread-bytes-consed thread))
         (gc-before mezzano.internals::*gc-cycles*)
         (start (mezzano.supervisor:get-high-precision-timer))
         (sum (funcall function count))
         (ticks (- (mezzano.supervisor:get-high-precision-timer) start)))
    (assert (= sum (* count 6)))
    (values ticks (- (mezzano.supervisor:thread-bytes-consed thread) bytes-before)
            (- mezzano.internals::*gc-cycles* gc-before))))

(defun run (&key (pairs 11) (count 10000))
  (let ((*package* (find-package :mezzano.structure-migration-benchmark)))
    (eval '(defstruct rebuilt-parent (a 1) (added 3)))
    (assert (= (rebuilt-loop 1) 6))
    ;; Compile both loops after the change, so both have equivalent inlining
    ;; opportunities.  The regression suite separately checks old accessors.
    (eval '(defun original-loop (count)
             (let ((sum 0))
               (dotimes (i count sum)
                 (let ((object (make-original-child)))
                   (incf sum (+ (original-child-a object) (original-child-added object)
                                (original-child-local object))))))))
    (eval '(defun rebuilt-loop (count)
             (let ((sum 0))
               (dotimes (i count sum)
                 (let ((object (make-rebuilt-child)))
                   (incf sum (+ (rebuilt-child-a object) (rebuilt-child-added object)
                                (rebuilt-child-local object))))))))
    (compile 'original-loop)
    (compile 'rebuilt-loop)
    (let ((original (make-array pairs)) (rebuilt (make-array pairs))
          (ratios (make-array pairs)) (original-bytes 0) (rebuilt-bytes 0))
      (original-loop 100)
      (rebuilt-loop 100)
      (dotimes (i pairs)
        (mezzano.internals::gc :full t)
        (loop for attempt from 1 to 10
              for original-gcs = 0
              for rebuilt-gcs = 0
              do (flet ((original-trial ()
                          (multiple-value-bind (ticks bytes gcs) (trial #'original-loop count)
                            (setf (aref original i) ticks original-bytes bytes original-gcs gcs)))
                        (rebuilt-trial ()
                          (multiple-value-bind (ticks bytes gcs) (trial #'rebuilt-loop count)
                            (setf (aref rebuilt i) ticks rebuilt-bytes bytes rebuilt-gcs gcs))))
                   (if (evenp i) (progn (original-trial) (rebuilt-trial))
                       (progn (rebuilt-trial) (original-trial))))
              when (and (zerop original-gcs) (zerop rebuilt-gcs)) do (return)
              when (= attempt 10) do (error "Unable to time a GC-free constructor pair."))
        (setf (aref ratios i) (/ (float (aref rebuilt i) 1d0) (aref original i)))
        (format t "MIGRATION-CONSTRUCTOR-BENCH ~D original=~D rebuilt=~D ratio=~,4F~%"
                i (aref original i) (aref rebuilt i) (aref ratios i)))
      (format t "MIGRATION-CONSTRUCTOR-BENCH-MEDIAN original=~D rebuilt=~D ratio=~,4F original-bytes=~D rebuilt-bytes=~D~%"
              (median original) (median rebuilt) (median ratios) original-bytes rebuilt-bytes)))
  t)

(defun run-boa (&key (pairs 11) (count 100000))
  (let ((*package* (find-package :mezzano.structure-migration-benchmark)))
    (eval '(defstruct boa-original-parent (a 1) (added 3)))
    (eval '(defstruct (boa-original-child (:include boa-original-parent)
                                          (:constructor create-boa-original (&optional (local 2))))
             local))
    (compile 'create-boa-original)
    (eval '(defstruct boa-rebuilt-parent (a 1)))
    (eval '(defstruct (boa-rebuilt-child (:include boa-rebuilt-parent)
                                         (:constructor create-boa-rebuilt (&optional (local 2))))
             local))
    (compile 'create-boa-rebuilt)
    (eval '(defstruct boa-rebuilt-parent (a 1) (added 3)))
    (assert (compiled-function-p (symbol-function 'create-boa-rebuilt)))
    (let* ((original-loop
             (compile nil '(lambda (count)
                             (let ((sum 0))
                               (dotimes (i count sum)
                                 (let ((object (create-boa-original)))
                                   (incf sum (+ (boa-original-child-a object)
                                                (boa-original-child-added object)
                                                (boa-original-child-local object)))))))))
           (rebuilt-loop
             (compile nil '(lambda (count)
                             (let ((sum 0))
                               (dotimes (i count sum)
                                 (let ((object (create-boa-rebuilt)))
                                   (incf sum (+ (boa-rebuilt-child-a object)
                                                (boa-rebuilt-child-added object)
                                                (boa-rebuilt-child-local object)))))))))
           (original (make-array pairs)) (rebuilt (make-array pairs))
           (ratios (make-array pairs)) (original-bytes 0) (rebuilt-bytes 0))
      (trial original-loop 100)
      (trial rebuilt-loop 100)
      (dotimes (i pairs)
        (mezzano.internals::gc :full t)
        (loop for attempt from 1 to 10
              for original-gcs = 0
              for rebuilt-gcs = 0
              do (flet ((original-trial ()
                          (multiple-value-bind (ticks bytes gcs) (trial original-loop count)
                            (setf (aref original i) ticks original-bytes bytes original-gcs gcs)))
                        (rebuilt-trial ()
                          (multiple-value-bind (ticks bytes gcs) (trial rebuilt-loop count)
                            (setf (aref rebuilt i) ticks rebuilt-bytes bytes rebuilt-gcs gcs))))
                   (if (evenp i) (progn (original-trial) (rebuilt-trial))
                       (progn (rebuilt-trial) (original-trial))))
              when (and (zerop original-gcs) (zerop rebuilt-gcs)) do (return)
              when (= attempt 10) do (error "Unable to time a GC-free BOA constructor pair."))
        (setf (aref ratios i) (/ (float (aref rebuilt i) 1d0) (aref original i)))
        (format t "MIGRATION-BOA-BENCH ~D original=~D rebuilt=~D ratio=~,4F~%"
                i (aref original i) (aref rebuilt i) (aref ratios i)))
      (format t "MIGRATION-BOA-BENCH-MEDIAN original=~D rebuilt=~D ratio=~,4F original-bytes=~D rebuilt-bytes=~D~%"
              (median original) (median rebuilt) (median ratios) original-bytes rebuilt-bytes)))
  t)

(defun run-redefinition (&key (count 6))
  ;; Time the actual layout change and recompilation of two descendants.
  ;; There is no correct upstream baseline: it left descendants stale.
  ;; The earlier guarded branch rejected this change.
  (let ((*package* (find-package :mezzano.structure-migration-benchmark)))
    (eval '(defstruct cost-parent (a 1)))
    (eval '(defstruct (cost-child (:include cost-parent)) (b 2)))
    (eval '(defstruct (cost-leaf (:include cost-child)) (c 3)))
    (let* ((class (find-class 'cost-parent))
           (old (mezzano.internals::convert-structure-class-to-structure-definition class)))
      (eval '(defstruct cost-parent (a 1) (added 9)))
      (let ((new (mezzano.internals::convert-structure-class-to-structure-definition class))
            (times (make-array count)))
        (dotimes (i count)
          (let ((start (get-internal-real-time)))
            (mezzano.clos::redefine-structure-type class (if (evenp i) old new))
            (setf (aref times i) (- (get-internal-real-time) start))
            (format t "MIGRATION-REDEFINITION ~D time=~D units-per-second=~D~%"
                    i (aref times i) internal-time-units-per-second)))
        (format t "MIGRATION-REDEFINITION-MEDIAN time=~D units-per-second=~D~%"
                (median times) internal-time-units-per-second))))
  t)

(defun run-guard-overhead (&key (pairs 11) (count 100000))
  ;; Compare the constructor guard against the original generated constructor
  ;; on the same class, with otherwise identical slots and call sites.
  (let ((*package* (find-package :mezzano.structure-migration-benchmark)))
    (eval '(defstruct guard-overhead (a 1) (added 3) (local 2)))
    (compile 'make-guard-overhead)
    (let ((definition (mezzano.internals::convert-structure-class-to-structure-definition
                       (find-class 'guard-overhead))))
      (eval (mezzano.internals::generate-simple-defstruct-constructor
             'guard-overhead definition 'make-unguarded-overhead nil))
      (compile 'make-unguarded-overhead))
    (let* ((old (compile nil '(lambda (count)
                               (let ((sum 0))
                                 (dotimes (i count sum)
                                   (let ((object (make-unguarded-overhead)))
                                     (incf sum (+ (guard-overhead-a object)
                                                  (guard-overhead-added object)
                                                  (guard-overhead-local object)))))))))
           (new (compile nil '(lambda (count)
                               (let ((sum 0))
                                 (dotimes (i count sum)
                                   (let ((object (make-guard-overhead)))
                                     (incf sum (+ (guard-overhead-a object)
                                                  (guard-overhead-added object)
                                                  (guard-overhead-local object)))))))))
           (old-times (make-array pairs)) (new-times (make-array pairs))
           (ratios (make-array pairs)) (old-bytes 0) (new-bytes 0))
      (trial old 100)
      (trial new 100)
      (dotimes (i pairs)
        (mezzano.internals::gc :full t)
        (loop for attempt from 1 to 10
              for old-gcs = 0 for new-gcs = 0
              do (flet ((old-trial ()
                          (multiple-value-bind (ticks bytes gcs) (trial old count)
                            (setf (aref old-times i) ticks old-bytes bytes old-gcs gcs)))
                        (new-trial ()
                          (multiple-value-bind (ticks bytes gcs) (trial new count)
                            (setf (aref new-times i) ticks new-bytes bytes new-gcs gcs))))
                   (if (evenp i) (progn (old-trial) (new-trial))
                       (progn (new-trial) (old-trial))))
              when (and (zerop old-gcs) (zerop new-gcs)) do (return)
              when (= attempt 10) do (error "Unable to time a GC-free constructor pair."))
        (setf (aref ratios i) (/ (float (aref new-times i) 1d0) (aref old-times i)))
        (format t "MIGRATION-GUARD-BENCH ~D old=~D guarded=~D ratio=~,4F~%"
                i (aref old-times i) (aref new-times i) (aref ratios i)))
      (format t "MIGRATION-GUARD-BENCH-MEDIAN old=~D guarded=~D ratio=~,4F old-bytes=~D guarded-bytes=~D~%"
              (median old-times) (median new-times) (median ratios) old-bytes new-bytes)))
  t)

(defun run-metadata (&key (pairs 6))
  ;; Compare the same redefinition with accessor regeneration forced versus
  ;; the metadata-only fast path. Each trial performs two redefinitions.
  (let ((*package* (find-package :mezzano.structure-migration-benchmark)))
    (eval '(defstruct metadata-cost-parent (a 1)))
    (eval '(defstruct (metadata-cost-child (:include metadata-cost-parent)) (b 2)))
    (eval '(defstruct (metadata-cost-leaf (:include metadata-cost-child)) (c 3)))
    (let* ((class (find-class 'metadata-cost-parent))
           (old (mezzano.internals::convert-structure-class-to-structure-definition class)))
      (eval '(defstruct metadata-cost-parent (a 2)))
      (let* ((new (mezzano.internals::convert-structure-class-to-structure-definition class))
             (name 'mezzano.clos::rebuild-structure-descendant-functions)
             (optimized (fdefinition name))
             (forced (lambda (class definition recipe &optional flag)
                       (declare (ignore flag))
                       (funcall optimized class definition recipe t)))
             (before (make-array pairs)) (after (make-array pairs)))
        (unwind-protect
             (progn
               (dotimes (i pairs)
                 (flet ((trial (function times)
                          (setf (fdefinition name) function)
                          (let ((start (get-internal-real-time)))
                            (mezzano.clos::redefine-structure-type class old)
                            (mezzano.clos::redefine-structure-type class new)
                            (setf (aref times i) (- (get-internal-real-time) start)))))
                   (if (evenp i) (progn (trial forced before) (trial optimized after))
                       (progn (trial optimized after) (trial forced before))))
                 (format t "MIGRATION-METADATA ~D forced=~D optimized=~D~%"
                         i (aref before i) (aref after i)))
               (format t "MIGRATION-METADATA-MEDIAN forced=~D optimized=~D units-per-second=~D~%"
                       (median before) (median after) internal-time-units-per-second))
          (setf (fdefinition name) optimized)))))
  t)
