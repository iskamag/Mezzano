;;;; Load in a running image and call (mezzano.structure-reparent-test:run).
(defpackage :mezzano.structure-reparent-test
  (:use :cl)
  (:export :run))
(in-package :mezzano.structure-reparent-test)

(defvar *edge-events* nil)
(defvar *initialization-events* nil)

(defun class-names (classes)
  (mapcar #'class-name classes))

(defun slot-names (slots)
  (mapcar #'mezzano.clos:slot-definition-name slots))

(defun assert-direct-subclass (parent child present)
  (assert (eq (not (null (member child (mezzano.clos:class-direct-subclasses parent))))
              present)))

(defun assert-layout-predicates-agree (class definition)
  ;; The allocation-free comparison must agree with the existing comparison
  ;; against a fully constructed prospective layout.
  (let* ((old (mezzano.clos:class-layout class))
         (new (mezzano.internals::make-layout
               :class class
               :heap-size (mezzano.internals::structure-definition-size definition)
               :heap-layout (mezzano.internals::layout-heap-layout
                             (mezzano.internals::structure-definition-layout definition))
               :area (mezzano.internals::structure-definition-area definition)
               :instance-slots (mezzano.internals::convert-structure-definition-instance-slots definition))))
    (assert (eq (not (null (mezzano.clos::class-layouts-compatible-p old new)))
                (not (null (mezzano.clos::structure-definition-layout-compatible-p old definition)))))))

(defun run ()
  (let ((*package* (find-package :mezzano.structure-reparent-test)))
    (eval '(defstruct old-parent))
    (eval '(defstruct new-parent))
    (eval '(defstruct (middle (:include old-parent)) marker))
    (eval '(defstruct (leaf (:include middle)) leaf-value))
    (eval '(defstruct (grandchild (:include leaf)) grandchild-value))
    (eval '(defstruct (cousin (:include middle))))
    (eval '(defstruct (sibling (:include old-parent))))
    (eval '(defgeneric route (object)))
    (eval '(defmethod route ((object old-parent)) :old))
    (eval '(defmethod route ((object new-parent)) :new))
    (eval '(defgeneric pair-route (left right)))
    (eval '(defmethod pair-route ((left old-parent) (right old-parent)) :old))
    (eval '(defmethod pair-route ((left new-parent) (right new-parent)) :new))
    (eval '(defmethod initialize-instance :after ((object old-parent) &key &allow-other-keys)
             (push :old *initialization-events*)))
    (eval '(defmethod initialize-instance :after ((object new-parent) &key &allow-other-keys)
             (push :new *initialization-events*)))
    (let* ((old (find-class 'old-parent))
           (new (find-class 'new-parent))
           (middle (find-class 'middle))
           (leaf (find-class 'leaf))
           (grandchild (find-class 'grandchild))
           (cousin (find-class 'cousin))
           (sibling (find-class 'sibling))
           (object (make-grandchild :marker 17))
           (middle-object (make-middle :marker 19)))
      (assert-direct-subclass old middle t)
      (assert (equal (slot-names (mezzano.clos:class-direct-slots middle)) '(marker)))
      (assert-direct-subclass new middle nil)
      (assert-direct-subclass old sibling t)
      ;; Warm both single- and multiple-dispatch caches before reparenting.
      (assert (eq (route object) :old))
      (assert (eq (route middle-object) :old))
      (assert (eq (pair-route object middle-object) :old))
      (setf *initialization-events* nil)
      (make-instance 'grandchild :marker 21)
      (assert (equal *initialization-events* '(:old)))
      ;; The public MOP hooks must run, including user methods on them.
      (eval `(defmethod mezzano.clos:remove-direct-subclass :after
                 ((parent (eql ',old)) (child (eql ',middle)))
               (push :remove-old *edge-events*)))
      (eval `(defmethod mezzano.clos:add-direct-subclass :after
                 ((parent (eql ',new)) (child (eql ',middle)))
               (push :add-new *edge-events*)))
      (setf *edge-events* nil)
      (eval '(defstruct (middle (:include new-parent)) marker))
      (assert (equal (reverse *edge-events*) '(:remove-old :add-new)))
      (assert (equal (class-names (mezzano.clos:class-direct-superclasses middle))
                     '(new-parent)))
      (assert (equal (slot-names (mezzano.clos:class-direct-slots middle)) '(marker)))
      (assert-direct-subclass old middle nil)
      (assert-direct-subclass new middle t)
      (assert-direct-subclass old sibling t)
      (assert-direct-subclass middle leaf t)
      (assert-direct-subclass middle cousin t)
      (assert-direct-subclass leaf grandchild t)
      (assert (equal (class-names (mezzano.clos:class-precedence-list grandchild))
                     '(grandchild leaf middle new-parent structure-object t)))
      (assert (eq (route object) :new))
      (assert (eq (route middle-object) :new))
      (assert (eq (pair-route object middle-object) :new))
      (setf *initialization-events* nil)
      (make-instance 'grandchild :marker 22)
      (assert (equal *initialization-events* '(:new)))
      (assert (= (middle-marker object) 17))
      (mezzano.internals::gc :full t)
      (assert-direct-subclass new middle t)
      (assert (eq (route object) :new))
      ;; Repeating an identical definition must not duplicate subclass edges.
      (eval '(defstruct (middle (:include new-parent)) marker))
      (assert (= (count middle (mezzano.clos:class-direct-subclasses new)) 1))
      ;; Move the class back and verify the caches and reverse links again.
      (eval '(defstruct (middle (:include old-parent)) marker))
      (assert-direct-subclass old middle t)
      (assert-direct-subclass new middle nil)
      (assert (eq (route object) :old))
      (assert (eq (pair-route object middle-object) :old))
      (assert (equal (class-names (mezzano.clos:class-precedence-list grandchild))
                     '(grandchild leaf middle old-parent structure-object t)))
      ;; Removing :INCLUDE moves the class to STRUCTURE-OBJECT.
      (eval '(defstruct middle marker))
      (assert-direct-subclass old middle nil)
      (assert-direct-subclass (find-class 'structure-object) middle t)
      (assert (equal (class-names (mezzano.clos:class-precedence-list grandchild))
                     '(grandchild leaf middle structure-object t)))
      (eval '(defstruct (middle (:include old-parent)) marker))
      (assert-direct-subclass old middle t)
      ;; Reject a cycle before changing the class graph.
      (let ((message (handler-case
                         (progn (eval '(defstruct (old-parent (:include grandchild)))) nil)
                       (error (condition) (format nil "~A" condition)))))
        (assert (and message (search "own descendant" message :test #'char-equal))))
      (assert-direct-subclass old middle t)
      (assert (equal (class-names (mezzano.clos:class-direct-superclasses old))
                     '(structure-object)))
      (assert (eq (route object) :old)))
    ;; Distinct parents with equivalent inherited slots are safe, including
    ;; existing descendant objects and their parent accessors.
    (eval '(defstruct shared-old (first 11) (second 22)))
    (eval '(defstruct shared-new (first 11) (second 22)))
    (assert (equal (slot-names (mezzano.clos:class-direct-slots (find-class 'shared-old)))
                   '(first second)))
    (eval '(defstruct (direct-metadata (:include shared-old))
             (one 17 :type integer) (two t :read-only t)))
    (let ((class (find-class 'direct-metadata)))
      (flet ((check-direct-slots ()
               (let ((slots (mezzano.clos:class-direct-slots class)))
                 (assert (equal (slot-names slots) '(one two)))
                 (assert (eq (mezzano.clos:slot-definition-type (first slots)) 'integer))
                 (assert (= (mezzano.clos:slot-definition-initform (first slots)) 17))
                 (assert (mezzano.clos:structure-slot-definition-read-only (second slots))))))
        (check-direct-slots)
        (eval '(defstruct (direct-metadata (:include shared-new))
                 (one 17 :type integer) (two t :read-only t)))
        (check-direct-slots)))
    (eval '(defstruct (shared-middle (:include shared-old)) marker))
    (eval '(defstruct (shared-leaf (:include shared-middle))))
    (let ((object (make-shared-leaf :first 3 :second 4 :marker 5))
          (middle (find-class 'shared-middle)))
      (eval '(defstruct (shared-middle (:include shared-new)) marker))
      (assert-direct-subclass (find-class 'shared-old) middle nil)
      (assert-direct-subclass (find-class 'shared-new) middle t)
      (assert (= (shared-new-first object) 3))
      (assert (= (shared-new-second object) 4))
      (assert (= (shared-middle-marker object) 5))
      (assert (equal (class-names (mezzano.clos:class-precedence-list (class-of object)))
                     '(shared-leaf shared-middle shared-new structure-object t))))
    ;; An incompatible reparent with descendants cannot safely leave their
    ;; existing inherited layouts and slot metadata unchanged.
    (eval '(defstruct old-shape old-slot))
    (eval '(defstruct new-shape new-slot))
    (eval '(defstruct (changing (:include old-shape)) marker))
    (eval '(defstruct (changing-leaf (:include changing)) leaf-value))
    (dolist (class-name '(old-shape new-shape changing-leaf))
      (dolist (definition-name '(old-shape new-shape changing-leaf))
        (assert-layout-predicates-agree
         (find-class class-name)
         (mezzano.internals::convert-structure-class-to-structure-definition
          (find-class definition-name)))))
    ;; A same-parent layout change could otherwise alias a child's direct
    ;; slot with the newly inherited parent slot.
    (eval '(defstruct layout-parent (inherited 1)))
    (eval '(defstruct (layout-child (:include layout-parent)) (local 2)))
    (let ((object (make-layout-child :inherited 11 :local 22)))
      (dolist (definition '((defstruct layout-parent (inherited 1) (added 9))
                            (defstruct layout-parent (inherited 3))))
        (let ((message (handler-case (progn (eval definition) nil)
                         (error (condition) (format nil "~A" condition)))))
          (assert (and message (search "while changing its slots" message :test #'char-equal)))))
      (assert (= (layout-parent-inherited object) 11))
      (assert (= (layout-child-local object) 22))
      (assert (equal (slot-names (mezzano.clos:class-slots (find-class 'layout-child)))
                     '(inherited local))))
    (let* ((old (find-class 'old-shape))
           (new (find-class 'new-shape))
           (changing (find-class 'changing))
           (leaf (find-class 'changing-leaf))
           (object (make-changing-leaf :old-slot 42)))
      (let ((message (handler-case
                         (progn (eval '(defstruct (changing (:include new-shape)) marker)) nil)
                       (error (condition) (format nil "~A" condition)))))
        (assert (and message (search "while changing its slots" message :test #'char-equal))))
      (assert-direct-subclass old changing t)
      (assert-direct-subclass new changing nil)
      (assert (equal (class-names (mezzano.clos:class-direct-superclasses changing))
                     '(old-shape)))
      (assert (equal (class-names (mezzano.clos:class-precedence-list leaf))
                     '(changing-leaf changing old-shape structure-object t)))
      (assert (= (old-shape-old-slot object) 42)))
    ;; Matching physical offsets are insufficient when inherited slot
    ;; metadata would change under an existing descendant.
    (eval '(defstruct metadata-old (shared 1)))
    (eval '(defstruct metadata-new (shared 2)))
    (eval '(defstruct (metadata-middle (:include metadata-old)) local))
    (eval '(defstruct (metadata-leaf (:include metadata-middle))))
    (let ((middle (find-class 'metadata-middle)))
      (let ((message (handler-case
                         (progn (eval '(defstruct (metadata-middle (:include metadata-new)) local)) nil)
                       (error (condition) (format nil "~A" condition)))))
        (assert (and message (search "while changing its slots" message :test #'char-equal))))
      (assert-direct-subclass (find-class 'metadata-old) middle t)
      (assert-direct-subclass (find-class 'metadata-new) middle nil))
    ;; Slot documentation is part of the MOP view retained by descendants.
    (eval '(defstruct documentation-old (shared 1 :documentation "old")))
    (eval '(defstruct documentation-new (shared 1 :documentation "new")))
    (eval '(defstruct (documentation-middle (:include documentation-old)) local))
    (eval '(defstruct (documentation-leaf (:include documentation-middle))))
    (let ((middle (find-class 'documentation-middle)))
      (let ((message (handler-case
                         (progn (eval '(defstruct (documentation-middle (:include documentation-new)) local)) nil)
                       (error (condition) (format nil "~A" condition)))))
        (assert (and message (search "while changing its slots" message :test #'char-equal))))
      (assert-direct-subclass (find-class 'documentation-old) middle t)
      (assert-direct-subclass (find-class 'documentation-new) middle nil))
    ;; Without descendants, incompatible layouts still use the existing
    ;; obsolete-instance update mechanism.
    (eval '(defstruct (single (:include old-shape)) marker))
    (let ((object (make-single :old-slot 8 :marker 9))
          (class (find-class 'single)))
      (eval '(defstruct (single (:include new-shape)) marker))
      (assert-direct-subclass (find-class 'old-shape) class nil)
      (assert-direct-subclass (find-class 'new-shape) class t)
      (assert (= (single-marker object) 9))
      (assert (null (new-shape-new-slot object))))
    (format t "STRUCTURE-REPARENT-TEST-PASSED~%")
    t))

(defun run-cold ()
  (let ((*package* (find-package :mezzano.structure-reparent-test))
        (object (mezzano.internals::make-reparent-cold-leaf :shared 23 :marker 24 :leaf-value 25)))
    ;; Ensure this actually exercises the vectors built by the cold generator.
    (assert (plusp (length (mezzano.internals::layout-compatible
                            (mezzano.clos:class-layout (find-class 'mezzano.internals::reparent-cold-leaf))))))
    (assert (mezzano.internals::reparent-cold-old-p object))
    (assert (not (mezzano.internals::reparent-cold-new-p object)))
    (assert (= (mezzano.internals::reparent-cold-old-shared object) 23))
    (assert (equal (slot-names (mezzano.clos:class-direct-slots
                                (find-class 'mezzano.internals::reparent-cold-middle)))
                   '(mezzano.internals::marker)))
    (let ((*package* (find-package :mezzano.internals)))
      (eval '(defstruct (mezzano.internals::reparent-cold-middle
                         (:include mezzano.internals::reparent-cold-new))
               mezzano.internals::marker)))
    (assert (equal (slot-names (mezzano.clos:class-direct-slots
                                (find-class 'mezzano.internals::reparent-cold-middle)))
                   '(mezzano.internals::marker)))
    (assert (mezzano.internals::reparent-cold-leaf-p object))
    (assert (mezzano.internals::reparent-cold-middle-p object))
    (assert (mezzano.internals::reparent-cold-middle-p
             (mezzano.internals::make-reparent-cold-middle)))
    (assert (not (mezzano.internals::reparent-cold-old-p object)))
    (assert (mezzano.internals::reparent-cold-new-p object))
    (assert (= (mezzano.internals::reparent-cold-new-shared object) 23))
    (assert (handler-case (progn (mezzano.internals::reparent-cold-old-shared object) nil)
              (type-error () t)))
    (mezzano.internals::gc :full t)
    (assert (mezzano.internals::reparent-cold-middle-p object))
    (assert (not (mezzano.internals::reparent-cold-old-p object)))
    (assert (mezzano.internals::reparent-cold-new-p object))
    ;; A childless class can change storage; old compiled TYPEP and accessors
    ;; must handle its obsolete literal layout and existing instances safely.
    (let ((old-object (mezzano.internals::make-reparent-cold-single :shared 41 :marker 42)))
      (let ((*package* (find-package :mezzano.internals)))
        (eval '(defstruct (mezzano.internals::reparent-cold-single
                           (:include mezzano.internals::reparent-cold-different))
                 mezzano.internals::marker)))
      (let ((new-object (funcall (symbol-function 'mezzano.internals::make-reparent-cold-single)
                                 :marker 99)))
        (assert (mezzano.internals::reparent-cold-single-original-p old-object))
        (assert (mezzano.internals::reparent-cold-single-original-p new-object))
        (assert (not (mezzano.internals::reparent-cold-old-p old-object)))
        (assert (mezzano.internals::reparent-cold-different-p old-object))
        (assert (handler-case
                    (progn (mezzano.internals::reparent-cold-old-shared old-object) nil)
                  (type-error () t)))
        (assert (= (mezzano.internals::reparent-cold-single-original-marker old-object) 42))
        (assert (= (mezzano.internals::reparent-cold-single-original-marker new-object) 99))))
    (format t "STRUCTURE-REPARENT-COLD-TEST-PASSED~%")
    t))
