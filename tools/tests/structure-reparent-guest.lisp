;;;; Load in a running image and call (mezzano.structure-reparent-test:run).
(defpackage :mezzano.structure-reparent-test
  (:use :cl)
  (:export :run))
(in-package :mezzano.structure-reparent-test)

(defvar *edge-events* nil)
(defvar *initialization-events* nil)

(defun class-names (classes)
  (mapcar #'class-name classes))

(defun slot-names (slots)
  (mapcar #'mezzano.clos:slot-definition-name slots))

(defun assert-direct-subclass (parent child present)
  (assert (eq (not (null (member child (mezzano.clos:class-direct-subclasses parent))))
              present)))

(defun assert-layout-predicates-agree (class definition)
  ;; The allocation-free comparison must agree with the existing comparison
  ;; against a fully constructed prospective layout.
  (let* ((old (mezzano.clos:class-layout class))
         (new (mezzano.internals::make-layout
               :class class
               :heap-size (mezzano.internals::structure-definition-size definition)
               :heap-layout (mezzano.internals::layout-heap-layout
                             (mezzano.internals::structure-definition-layout definition))
               :area (mezzano.internals::structure-definition-area definition)
               :instance-slots (mezzano.internals::convert-structure-definition-instance-slots definition))))
    (assert (eq (not (null (mezzano.clos::class-layouts-compatible-p old new)))
                (not (null (mezzano.clos::structure-definition-layout-compatible-p old definition)))))))

(defun run ()
  (let ((*package* (find-package :mezzano.structure-reparent-test)))
    (eval '(defstruct old-parent))
    (eval '(defstruct new-parent))
    (eval '(defstruct (middle (:include old-parent)) marker))
    (eval '(defstruct (leaf (:include middle)) leaf-value))
    (eval '(defstruct (grandchild (:include leaf)) grandchild-value))
    (eval '(defstruct (cousin (:include middle))))
    (eval '(defstruct (sibling (:include old-parent))))
    (eval '(defgeneric route (object)))
    (eval '(defmethod route ((object old-parent)) :old))
    (eval '(defmethod route ((object new-parent)) :new))
    (eval '(defgeneric pair-route (left right)))
    (eval '(defmethod pair-route ((left old-parent) (right old-parent)) :old))
    (eval '(defmethod pair-route ((left new-parent) (right new-parent)) :new))
    (eval '(defmethod initialize-instance :after ((object old-parent) &key &allow-other-keys)
             (push :old *initialization-events*)))
    (eval '(defmethod initialize-instance :after ((object new-parent) &key &allow-other-keys)
             (push :new *initialization-events*)))
    (let* ((old (find-class 'old-parent))
           (new (find-class 'new-parent))
           (middle (find-class 'middle))
           (leaf (find-class 'leaf))
           (grandchild (find-class 'grandchild))
           (cousin (find-class 'cousin))
           (sibling (find-class 'sibling))
           (object (make-grandchild :marker 17))
           (middle-object (make-middle :marker 19)))
      (assert-direct-subclass old middle t)
      (assert (equal (slot-names (mezzano.clos:class-direct-slots middle)) '(marker)))
      (assert-direct-subclass new middle nil)
      (assert-direct-subclass old sibling t)
      ;; Warm both single- and multiple-dispatch caches before reparenting.
      (assert (eq (route object) :old))
      (assert (eq (route middle-object) :old))
      (assert (eq (pair-route object middle-object) :old))
      (setf *initialization-events* nil)
      (make-instance 'grandchild :marker 21)
      (assert (equal *initialization-events* '(:old)))
      ;; The public MOP hooks must run, including user methods on them.
      (eval `(defmethod mezzano.clos:remove-direct-subclass :after
                 ((parent (eql ',old)) (child (eql ',middle)))
               (push :remove-old *edge-events*)))
      (eval `(defmethod mezzano.clos:add-direct-subclass :after
                 ((parent (eql ',new)) (child (eql ',middle)))
               (push :add-new *edge-events*)))
      (setf *edge-events* nil)
      (eval '(defstruct (middle (:include new-parent)) marker))
      (assert (equal (reverse *edge-events*) '(:remove-old :add-new)))
      (assert (equal (class-names (mezzano.clos:class-direct-superclasses middle))
                     '(new-parent)))
      (assert (equal (slot-names (mezzano.clos:class-direct-slots middle)) '(marker)))
      (assert-direct-subclass old middle nil)
      (assert-direct-subclass new middle t)
      (assert-direct-subclass old sibling t)
      (assert-direct-subclass middle leaf t)
      (assert-direct-subclass middle cousin t)
      (assert-direct-subclass leaf grandchild t)
      (assert (equal (class-names (mezzano.clos:class-precedence-list grandchild))
                     '(grandchild leaf middle new-parent structure-object t)))
      (assert (eq (route object) :new))
      (assert (eq (route middle-object) :new))
      (assert (eq (pair-route object middle-object) :new))
      (setf *initialization-events* nil)
      (make-instance 'grandchild :marker 22)
      (assert (equal *initialization-events* '(:new)))
      (assert (= (middle-marker object) 17))
      (mezzano.internals::gc :full t)
      (assert-direct-subclass new middle t)
      (assert (eq (route object) :new))
      ;; Repeating an identical definition must not duplicate subclass edges.
      (eval '(defstruct (middle (:include new-parent)) marker))
      (assert (= (count middle (mezzano.clos:class-direct-subclasses new)) 1))
      ;; Move the class back and verify the caches and reverse links again.
      (eval '(defstruct (middle (:include old-parent)) marker))
      (assert-direct-subclass old middle t)
      (assert-direct-subclass new middle nil)
      (assert (eq (route object) :old))
      (assert (eq (pair-route object middle-object) :old))
      (assert (equal (class-names (mezzano.clos:class-precedence-list grandchild))
                     '(grandchild leaf middle old-parent structure-object t)))
      ;; Removing :INCLUDE moves the class to STRUCTURE-OBJECT.
      (eval '(defstruct middle marker))
      (assert-direct-subclass old middle nil)
      (assert-direct-subclass (find-class 'structure-object) middle t)
      (assert (equal (class-names (mezzano.clos:class-precedence-list grandchild))
                     '(grandchild leaf middle structure-object t)))
      (eval '(defstruct (middle (:include old-parent)) marker))
      (assert-direct-subclass old middle t)
      ;; Reject a cycle before changing the class graph.
      (let ((message (handler-case
                         (progn (eval '(defstruct (old-parent (:include grandchild)))) nil)
                       (error (condition) (format nil "~A" condition)))))
        (assert (and message (search "own descendant" message :test #'char-equal))))
      (assert-direct-subclass old middle t)
      (assert (equal (class-names (mezzano.clos:class-direct-superclasses old))
                     '(structure-object)))
      (assert (eq (route object) :old)))
    ;; Distinct parents with equivalent inherited slots are safe, including
    ;; existing descendant objects and their parent accessors.
    (eval '(defstruct shared-old (first 11) (second 22)))
    (eval '(defstruct shared-new (first 11) (second 22)))
    (assert (equal (slot-names (mezzano.clos:class-direct-slots (find-class 'shared-old)))
                   '(first second)))
    (eval '(defstruct (direct-metadata (:include shared-old))
             (one 17 :type integer) (two t :read-only t)))
    (let ((class (find-class 'direct-metadata)))
      (flet ((check-direct-slots ()
               (let ((slots (mezzano.clos:class-direct-slots class)))
                 (assert (equal (slot-names slots) '(one two)))
                 (assert (eq (mezzano.clos:slot-definition-type (first slots)) 'integer))
                 (assert (= (mezzano.clos:slot-definition-initform (first slots)) 17))
                 (assert (mezzano.clos:structure-slot-definition-read-only (second slots))))))
        (check-direct-slots)
        (eval '(defstruct (direct-metadata (:include shared-new))
                 (one 17 :type integer) (two t :read-only t)))
        (check-direct-slots)))
    (eval '(defstruct (shared-middle (:include shared-old)) marker))
    (eval '(defstruct (shared-leaf (:include shared-middle))))
    (let ((object (make-shared-leaf :first 3 :second 4 :marker 5))
          (middle (find-class 'shared-middle)))
      (eval '(defstruct (shared-middle (:include shared-new)) marker))
      (assert-direct-subclass (find-class 'shared-old) middle nil)
      (assert-direct-subclass (find-class 'shared-new) middle t)
      (assert (= (shared-new-first object) 3))
      (assert (= (shared-new-second object) 4))
      (assert (= (shared-middle-marker object) 5))
      (assert (equal (class-names (mezzano.clos:class-precedence-list (class-of object)))
                     '(shared-leaf shared-middle shared-new structure-object t))))
    ;; An incompatible reparent with descendants cannot safely leave their
    ;; existing inherited layouts and slot metadata unchanged.
    (eval '(defstruct old-shape old-slot))
    (eval '(defstruct new-shape new-slot))
    (eval '(defstruct (changing (:include old-shape)) marker))
    (eval '(defstruct (changing-leaf (:include changing)) leaf-value))
    (dolist (class-name '(old-shape new-shape changing-leaf))
      (dolist (definition-name '(old-shape new-shape changing-leaf))
        (assert-layout-predicates-agree
         (find-class class-name)
         (mezzano.internals::convert-structure-class-to-structure-definition
          (find-class definition-name)))))
    ;; A parent can add slots without aliasing existing descendant slots.
    (eval '(defstruct layout-parent (inherited 1)))
    (eval '(defstruct (layout-child (:include layout-parent)) (local 2)))
    (let ((object (make-layout-child :inherited 11 :local 22))
          (saved-constructor (symbol-function 'make-layout-child))
          (inlined-constructor (compile nil '(lambda ()
                                              (declare (inline make-layout-child))
                                              (make-layout-child :inherited 31 :local 32))))
          (old-accessor (compile nil '(lambda (x) (layout-child-local x)))))
      (eval '(defstruct layout-parent (inherited 1) (added 9)))
      (assert (= (layout-parent-inherited object) 11))
      (assert (= (funcall old-accessor object) 22))
      (assert (= (layout-parent-added object) 9))
      (assert (equal (slot-names (mezzano.clos:class-slots (find-class 'layout-child)))
                     '(inherited added local)))
      (let ((new (make-layout-child :added 18 :local 19)))
        (assert (= (layout-parent-added new) 18))
        (assert (= (layout-child-local new) 19)))
      (let ((saved (funcall saved-constructor :inherited 41 :local 42))
            (inlined (funcall inlined-constructor)))
        (assert (= (layout-parent-added saved) 9))
        (assert (= (layout-child-local saved) 42))
        (assert (= (layout-parent-added inlined) 9))
        (assert (= (layout-child-local inlined) 32)))
      ;; A saved old constructor must skip a slot removed from its class.
      (eval '(defstruct layout-parent (added 10)))
      (let ((saved (funcall saved-constructor :inherited 41 :local 42))
            (inlined (funcall inlined-constructor)))
        (assert (= (layout-parent-added saved) 10))
        (assert (= (layout-child-local saved) 42))
        (assert (= (layout-parent-added inlined) 10))))
    (let* ((old (find-class 'old-shape))
           (new (find-class 'new-shape))
           (changing (find-class 'changing))
           (leaf (find-class 'changing-leaf))
           (object (make-changing-leaf :old-slot 42 :marker 43 :leaf-value 44))
           (old-accessor (compile nil '(lambda (x) (changing-leaf-leaf-value x)))))
      (eval '(defstruct (changing (:include new-shape)) marker))
      (assert-direct-subclass old changing nil)
      (assert-direct-subclass new changing t)
      (assert (equal (class-names (mezzano.clos:class-precedence-list leaf))
                     '(changing-leaf changing new-shape structure-object t)))
      (assert (= (changing-marker object) 43))
      (assert (= (funcall old-accessor object) 44))
      (assert (null (new-shape-new-slot object)))
      (assert (not (typep object 'old-shape)))
      (assert (typep object 'new-shape))
      (let ((new-object (make-changing-leaf :new-slot 5 :leaf-value 6)))
        (assert (= (new-shape-new-slot new-object) 5))
        (assert (= (changing-leaf-leaf-value new-object) 6))))
    ;; Update inherited defaults, but retain explicit :INCLUDE overrides.
    (eval '(defstruct metadata-old (shared 1)))
    (eval '(defstruct metadata-new (shared 2)))
    (eval '(defstruct (metadata-middle (:include metadata-old)) local))
    (eval '(defstruct (metadata-leaf (:include metadata-middle))))
    (eval '(defstruct (metadata-override (:include metadata-middle (shared 1)))))
    (eval '(defstruct (metadata-middle (:include metadata-new)) local))
    (assert (= (metadata-leaf-shared (make-metadata-leaf)) 2))
    (assert (= (metadata-override-shared (make-metadata-override)) 1))
    (assert (= (mezzano.clos:slot-definition-initform
                (find 'shared (mezzano.clos:class-slots (find-class 'metadata-leaf))
                      :key #'mezzano.clos:slot-definition-name)) 2))
    ;; Identical source forms may close over different lexical values.
    (eval '(let ((seed 10))
             (defstruct dynamic-parent (value seed))
             (defstruct (dynamic-child (:include dynamic-parent)))))
    (let ((saved (symbol-function 'make-dynamic-child)))
      (eval '(let ((seed 20)) (defstruct dynamic-parent (value seed))))
      (assert (= (dynamic-child-value (make-dynamic-child)) 20))
      (assert (= (dynamic-child-value (funcall saved)) 20)))
    ;; Re-executing a compiled DEFSTRUCT site needs a fresh constructor token.
    (eval '(defun install-repeated-structure (seed)
             (defstruct repeated-structure (value seed))))
    (compile 'install-repeated-structure)
    (install-repeated-structure 10)
    (let ((saved (symbol-function 'make-repeated-structure)))
      (install-repeated-structure 20)
      (let* ((current (symbol-function 'make-repeated-structure))
             (recipe (slot-value (find-class 'repeated-structure)
                                 'mezzano.clos::definition-recipe))
             (token (getf recipe :constructor-token)))
        (assert (= (repeated-structure-value (funcall current)) 20))
        (assert (= (repeated-structure-value (funcall saved)) 20))
        (assert (compiled-function-p current))
        (assert (null (mezzano.internals::%object-ref-t
                       token mezzano.internals::+symbol-value+))))
      (install-repeated-structure 30)
      (assert (= (repeated-structure-value (funcall saved)) 30))
      (setf (find-class 'repeated-structure) nil)
      (install-repeated-structure 40)
      (assert (= (repeated-structure-value (make-repeated-structure)) 40))
      (assert (= (repeated-structure-value (funcall saved)) 40)))
    (eval '(defun install-repeated-parent (seed)
             (defstruct repeated-parent (value seed))))
    (compile 'install-repeated-parent)
    (install-repeated-parent 10)
    (eval '(defstruct (repeated-child (:include repeated-parent))))
    (let ((saved-parent (symbol-function 'make-repeated-parent))
          (saved-child (symbol-function 'make-repeated-child)))
      (install-repeated-parent 20)
      (assert (= (repeated-parent-value (make-repeated-parent)) 20))
      (assert (= (repeated-parent-value (funcall saved-parent)) 20))
      (assert (= (repeated-child-value (make-repeated-child)) 20))
      (assert (= (repeated-child-value (funcall saved-child)) 20)))
    ;; A formerly dynamic inherited default must not survive a change to a
    ;; constant, including when an older instance has skipped both updates.
    (eval '(defstruct switch-parent))
    (eval '(defstruct (switch-child (:include switch-parent)
                                    (:constructor make-switch-child)
                                    (:constructor create-switch-child (local)))
             (local 1)))
    (let ((old (make-switch-child :local 8))
          (saved (symbol-function 'make-switch-child))
          (saved-boa (symbol-function 'create-switch-child)))
      (eval '(let ((seed 10)) (defstruct switch-parent (value seed))))
      (eval '(defstruct switch-parent (value 20)))
      (assert (= (switch-child-value old) 20))
      (assert (= (switch-child-local old) 8))
      (assert (= (switch-child-value (make-switch-child)) 20))
      (assert (= (switch-child-value (funcall saved)) 20))
      (assert (= (switch-child-value (create-switch-child 3)) 20))
      (assert (= (switch-child-value (funcall saved-boa 3)) 20)))
    ;; An :INCLUDE slot name without a supplied initform inherits its default.
    (eval '(let ((seed 11))
             (defstruct bare-override-parent (value seed))
             (defstruct (bare-override-child (:include bare-override-parent (value))))))
    (let ((saved (symbol-function 'make-bare-override-child)))
      (eval '(defstruct bare-override-parent (value 22)))
      (assert (= (bare-override-child-value (make-bare-override-child)) 22))
      (assert (= (bare-override-child-value (funcall saved)) 22)))
    ;; A later keyword parameter must not shadow an earlier slot's lexical
    ;; default when a constructor is generated or rebuilt.
    (eval '(let ((b 42))
             (defstruct shadow-parent (a b) (b 1))
             (defstruct (shadow-child (:include shadow-parent)))))
    (let ((saved (symbol-function 'make-shadow-child)))
      (assert (= (shadow-child-a (funcall saved :b 7)) 42))
      (eval '(let ((b 99)) (defstruct shadow-parent (a b) (b 1))))
      (assert (= (shadow-child-a (make-shadow-child :b 7)) 99))
      (assert (= (shadow-child-a (funcall saved :b 7)) 99)))
    ;; A sealed descendant is still affected by its unsealed parent.
    (eval '(defstruct seal-parent (a 1)))
    (eval '(defstruct (seal-child (:include seal-parent) :sealed) (b 2)))
    (let ((object (make-seal-child :a 7 :b 8))
          (saved-constructor (symbol-function 'make-seal-child))
          (reader (compile nil '(lambda (x) (seal-child-b x))))
          (predicate (compile nil '(lambda (x) (typep x 'seal-child)))))
      (eval '(defstruct seal-parent (a 1) (added 3)))
      (assert (funcall predicate object))
      (assert (= (funcall reader object) 8))
      (assert (= (seal-parent-added object) 3))
      (assert (= (seal-parent-added (funcall saved-constructor)) 3)))
    ;; Documentation in descendant MOP metadata follows the new parent.
    (eval '(defstruct documentation-old (shared 1 :documentation "old")))
    (eval '(defstruct documentation-new (shared 1 :documentation "new")))
    (eval '(defstruct (documentation-middle (:include documentation-old)) local))
    (eval '(defstruct (documentation-leaf (:include documentation-middle))))
    (eval '(defstruct (documentation-middle (:include documentation-new)) local))
    (assert (equal (documentation
                    (find 'shared (mezzano.clos:class-slots (find-class 'documentation-leaf))
                          :key #'mezzano.clos:slot-definition-name) t)
                   "new"))
    ;; Class documentation and standard-constructor metadata also change
    ;; when the storage layout remains unchanged.
    (eval '(defstruct documented-class "old" value))
    (eval '(defstruct documented-class "new" value))
    (assert (equal (documentation (find-class 'documented-class) t) "new"))
    (eval '(defstruct constructor-flag value))
    (eval '(defstruct (constructor-flag (:constructor nil)) value))
    (assert (handler-case (progn (make-instance 'constructor-flag) nil)
              (error () t)))
    ;; Embedded vectors need all elements copied, even when the size rounds
    ;; to the same number of heap words.
    (eval '(defstruct vector-parent (payload 4 :type (unsigned-byte 8) :fixed-vector 3)))
    (eval '(defstruct (vector-child (:include vector-parent)) (tail 1 :type (unsigned-byte 16))))
    (let ((object (make-vector-child :tail 511))
          (reader (compile nil '(lambda (x i) (vector-parent-payload x i)))))
      (setf (vector-parent-payload object 0) 10
            (vector-parent-payload object 1) 11
            (vector-parent-payload object 2) 12)
      (eval '(defstruct vector-parent (payload 9 :type (unsigned-byte 8) :fixed-vector 5)))
      (assert (= (funcall reader object 0) 10))
      (assert (= (vector-parent-payload object 1) 11))
      (assert (= (vector-parent-payload object 2) 12))
      (assert (= (vector-parent-payload object 3) 9))
      (assert (= (vector-parent-payload object 4) 9))
      (assert (= (vector-child-tail object) 511)))
    ;; A zero-length vector has no element to carry into a new scalar slot.
    (eval '(defstruct empty-vector-parent (value 4 :type (unsigned-byte 8) :fixed-vector 0)))
    (eval '(defstruct (empty-vector-child (:include empty-vector-parent)) local))
    (let ((object (make-empty-vector-child :local 17)))
      (eval '(defstruct empty-vector-parent (value 9 :type (unsigned-byte 8))))
      (assert (= (empty-vector-parent-value object) 9))
      (assert (= (empty-vector-child-local object) 17)))
    ;; Added read-only slots can be initialized during migration.
    (eval '(defstruct readonly-parent (base 1)))
    (eval '(defstruct (readonly-child (:include readonly-parent)) local))
    (let ((object (make-readonly-child :local 8)))
      (eval '(defstruct readonly-parent (base 1) (added 7 :read-only t)))
      (assert (= (readonly-parent-added object) 7))
      (assert (= (readonly-child-local object) 8))
      (assert (= (readonly-parent-added (make-readonly-child)) 7))
      (assert (= (readonly-parent-added (make-instance 'readonly-child :added 13)) 13)))
    ;; A type can change without changing its boxed storage location.
    (eval '(defstruct type-parent (value 1 :type integer)))
    (eval '(defstruct (type-child (:include type-parent))))
    (let ((object (make-type-child))
          (writer (compile nil '(lambda (object value)
                                  (setf (type-child-value object) value)))))
      (eval '(defstruct type-parent (value 1 :type t)))
      (funcall writer object "text")
      (assert (equal (type-child-value object) "text")))
    ;; A BOA constructor keeps its lambda-list and lexical defaults.
    (eval '(defstruct boa-parent (inherited 1)))
    (eval '(let ((captured 37))
             (defstruct (boa-child (:include boa-parent)
                                    (:constructor create-boa-child (x &optional (y (+ x 1)))))
               x y (local-default captured))))
    (let ((saved (symbol-function 'create-boa-child)))
      (eval '(defstruct boa-parent (inherited 1) (added 12)))
      (dolist (object (list (create-boa-child 5) (funcall saved 5)))
        (assert (= (boa-child-x object) 5))
        (assert (= (boa-child-y object) 6))
        (assert (= (boa-child-local-default object) 37))
        (assert (= (boa-parent-added object) 12))))
    ;; Optional, keyword, aux and slot defaults retain their lexical context
    ;; and can refer to earlier BOA parameters after recompilation.
    (eval '(let ((captured 37))
             (defstruct complex-boa-parent (base 1))
             (defstruct (complex-boa-child
                         (:include complex-boa-parent)
                         (:constructor create-complex-boa
                           (x &optional (y (+ x captured))
                              &key (z (+ y captured)) &aux (w (+ z captured)))))
               x y z w (label captured))))
    (let ((saved (symbol-function 'create-complex-boa)))
      (eval '(defstruct complex-boa-parent (base 1) (added 12)))
      (assert (compiled-function-p (symbol-function 'create-complex-boa)))
      (dolist (object (list (create-complex-boa 5) (funcall saved 5)))
        (assert (= (complex-boa-child-x object) 5))
        (assert (= (complex-boa-child-y object) 42))
        (assert (= (complex-boa-child-z object) 79))
        (assert (= (complex-boa-child-w object) 116))
        (assert (= (complex-boa-child-label object) 37))
        (assert (= (complex-boa-parent-added object) 12))))
    ;; Constructors above the keyword compilation threshold use &REST.
    (eval '(defstruct large-parent (base 1)))
    (eval '(defstruct (large-child (:include large-parent))
             s00 s01 s02 s03 s04 s05 s06 s07 s08 s09 s10 s11 s12 s13 s14 s15))
    (let ((saved (symbol-function 'make-large-child)))
      (eval '(defstruct large-parent (base 1) (added 77)))
      (let ((object (funcall saved :s15 42)))
        (assert (= (large-child-s15 object) 42))
        (assert (= (large-parent-added object) 77))))
    ;; Conflicting direct slots are rejected before touching the class graph.
    (eval '(defstruct conflict-parent (existing 1)))
    (eval '(defstruct (conflict-child (:include conflict-parent)) (duplicate 2)))
    (let ((object (make-conflict-child :duplicate 7)))
      (assert (handler-case
                  (progn (eval '(defstruct conflict-parent (existing 1) (duplicate 3))) nil)
                (error () t)))
      (assert (= (conflict-child-duplicate object) 7))
      (assert (equal (slot-names (mezzano.clos:class-slots (find-class 'conflict-parent)))
                     '(existing))))
    ;; Without descendants, incompatible layouts still use the existing
    ;; obsolete-instance update mechanism.
    (eval '(defstruct (single (:include old-shape)) marker))
    (let ((object (make-single :old-slot 8 :marker 9))
          (class (find-class 'single)))
      (eval '(defstruct (single (:include new-shape)) marker))
      (assert-direct-subclass (find-class 'old-shape) class nil)
      (assert-direct-subclass (find-class 'new-shape) class t)
      (assert (= (single-marker object) 9))
      (assert (null (new-shape-new-slot object))))
    (format t "STRUCTURE-REPARENT-TEST-PASSED~%")
    t))

(defun run-cold ()
  (let ((*package* (find-package :mezzano.structure-reparent-test))
        (object (mezzano.internals::make-reparent-cold-leaf :shared 23 :marker 24 :leaf-value 25)))
    ;; Ensure this actually exercises the vectors built by the cold generator.
    (assert (plusp (length (mezzano.internals::layout-compatible
                            (mezzano.clos:class-layout (find-class 'mezzano.internals::reparent-cold-leaf))))))
    (assert (mezzano.internals::reparent-cold-old-p object))
    (assert (not (mezzano.internals::reparent-cold-new-p object)))
    (assert (= (mezzano.internals::reparent-cold-old-shared object) 23))
    (assert (equal (slot-names (mezzano.clos:class-direct-slots
