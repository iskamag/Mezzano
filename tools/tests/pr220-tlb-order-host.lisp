;;; Run after the batch helper is present:
;;;   sbcl --script tools/tests/pr220-tlb-order-host.lisp
;;; To review a separate worktree's uncommitted pager source, set
;;; PR220_TLB_PAGER_SOURCE=/absolute/path/to/supervisor/pager.lisp.
;;; Executes the production batching, release, protect and range-flush forms.

(defpackage :sys.int (:use :cl))
(defpackage :mezzano.supervisor (:use :cl))
(in-package :sys.int)
(defconstant +card-table-base+ #x10000000)
(defconstant +card-size+ #x1000)
(defconstant +card-table-entry-size+ #x1000)
(defconstant +block-map-present+ 1)
(defconstant +block-map-writable+ 2)
(defconstant +block-map-track-dirty+ 4)
(defconstant +block-map-zero-fill+ 8)

(in-package :mezzano.supervisor)
(defconstant +pager-tlb-batch-pages+ 256)
(defconstant +tlb-shootdown-batch-size+ 64)
(defvar *pager-tlb-retired-frames* (make-array +pager-tlb-batch-pages+ :initial-element nil))
(defvar *vm-lock* :mock-vm-lock)
(defvar *vm-lock-held* nil)
(defvar *tlb-shootdown-in-progress* nil)
(defvar *events* nil)
(defvar *ptes* (make-hash-table))
(defvar *blocks* (make-hash-table))
(defvar *released-frames* (make-hash-table))
(defvar *original-frames* (make-hash-table))

(defmacro ensure (condition &rest message)
  `(unless ,condition (error "Ensure failed: ~A" (list ,@message))))
(defmacro with-rw-lock-write ((lock) &body body)
  `(let ((*vm-lock-held* t))
     (declare (ignore ,lock))
     ,@body))
(defun rw-lock-write-held-p (lock) (declare (ignore lock)) *vm-lock-held*)
(defun pager-log-op (&rest args) (declare (ignore args)))
(defun panic (&rest args) (error "~{~A~}" args))
(defun stack-area-p (address) (>= address #x200000000000))
(defun mark-bit-region-p (address) (declare (ignore address)) nil)
(defun reset-fixture ()
  (setf *ptes* (make-hash-table) *blocks* (make-hash-table)
        *released-frames* (make-hash-table)
        *original-frames* (make-hash-table)
        *events* nil
        *tlb-shootdown-in-progress* nil)
  (fill *pager-tlb-retired-frames* nil))
(defun add-page (address frame &optional (flags (logior sys.int::+block-map-present+
                                                    sys.int::+block-map-writable+)))
  ;; PTE slot: virtual address, raw PTE word. Bit 0=present, bit 1=writable.
  (setf (gethash address *ptes*) (vector address (logior (ash frame 12) 3))
        (gethash address *original-frames*) frame
        (gethash address *blocks*) flags))
(defun add-absent-block (address &optional (flags sys.int::+block-map-present+))
  (setf (gethash address *blocks*) flags))
(defun get-pte-for-address (address &optional allocate)
  (declare (ignore allocate))
  (gethash address *ptes*))
(defun page-table-entry (pte &optional (index 0))
  (declare (ignore index)) (aref pte 1))
(defun (setf page-table-entry) (value pte &optional (index 0))
  (declare (ignore index))
  (push (list :pte (aref pte 0) value) *events*)
  (setf (aref pte 1) value))
(defun page-present-p (pte &optional (index 0))
  (logtest 1 (page-table-entry pte index)))
(defun pte-physical-address (value) (logand value (lognot #xfff)))
(defun update-pte (pte &key writable)
  (setf (page-table-entry pte)
        (if writable
            (logior (page-table-entry pte) 2)
            (logand (page-table-entry pte) (lognot 2)))))
(defun block-info-for-virtual-address (address) (gethash address *blocks*))
(defun set-address-flags (address flags)
  (assert *vm-lock-held*)
  (assert (not *tlb-shootdown-in-progress*))
  (push (list :flags address flags) *events*)
  (setf (gethash address *blocks*) flags))
(defun block-info-present-p (flags) (logtest sys.int::+block-map-present+ flags))
(defun block-info-zero-fill-p (flags) (logtest sys.int::+block-map-zero-fill+ flags))
(defun block-info-writable-p (flags) (logtest sys.int::+block-map-writable+ flags))
(defun block-info-track-dirty-p (flags) (logtest sys.int::+block-map-track-dirty+ flags))
(defun begin-tlb-shootdown ()
  (assert *vm-lock-held*)
  (assert (not *tlb-shootdown-in-progress*))
  (setf *tlb-shootdown-in-progress* t)
  (push :begin *events*))
(defun finish-tlb-shootdown ()
  (assert *tlb-shootdown-in-progress*)
  (setf *tlb-shootdown-in-progress* nil)
  (push :finish *events*))
(defun flush-tlb-single (address)
  (assert *tlb-shootdown-in-progress*)
  (push (list :single address) *events*))
(defun flush-tlb ()
  (assert *tlb-shootdown-in-progress*)
  (push :full *events*))
(defun release-vm-page (frame &key allow-wired stackp)
  (assert *vm-lock-held*)
  (assert (not *tlb-shootdown-in-progress*))
  (assert (not (gethash frame *released-frames*)) () "Frame released twice")
  (setf (gethash frame *released-frames*) t)
  (push (list :frame frame allow-wired stackp) *events*))
(defun release-block-at-virtual-address (address)
  ;; This mock models an allocator metadata refill on every block free. It
  ;; catches a mapped frame whose store block was freed before retirement.
  (assert *vm-lock-held*)
  (assert (not *tlb-shootdown-in-progress*))
  (let ((pte (gethash address *ptes*)))
    (assert (or (null pte) (not (page-present-p pte))) ()
            "Store block freed while its PTE remains present"))
  (let ((frame (gethash address *original-frames*)))
    (when frame
      (assert (gethash frame *released-frames*) ()
              "Store block freed before its frame was retired")))
  (push (list :block address) *events*)
  (remhash address *blocks*))

(defun load-pager-function (stream name)
  (file-position stream 0)
  (loop for position = (file-position stream)
        for line = (read-line stream nil)
        while line
        when (search (format nil "(defun ~A " name) line)
          do (file-position stream position)
             (eval (read stream))
             (return t)))
(let ((source (or (sb-ext:posix-getenv "PR220_TLB_PAGER_SOURCE")
                  (namestring (merge-pathnames "../../supervisor/pager.lisp"
                                               *load-truename*)))))
  (with-open-file (stream source)
    (dolist (name '("tlb-shootdown-range"
                    "update-memory-range-ptes-in-pager"
                    "release-memory-range-in-pager"
                    "protect-memory-range-in-pager"))
      (unless (load-pager-function stream name)
        (error "Missing production function ~A in ~A" name source)))))

(defun events () (reverse *events*))
(defun count-event (event)
  (count event (events) :test #'equal))
(defun check-range-flush (pages expected-singles expected-full)
  (reset-fixture)
  (let ((*tlb-shootdown-in-progress* t))
    (tlb-shootdown-range #x4000 (* pages #x1000)))
  (assert (= (count :full (events)) expected-full))
  (assert (= (count-if (lambda (item) (and (consp item) (eq (car item) :single)))
                       (events)) expected-singles)))
(dolist (case '((1 1 0) (64 64 0) (65 0 1) (256 0 1)))
  (apply #'check-range-flush case))

;; Fully resident stack: boundary chunks must be 1/1/2 rendezvous.
(dolist (case '((255 1) (256 1) (257 2)))
  (destructuring-bind (pages expected) case
    (reset-fixture)
    (let ((base #x200000000000))
      (dotimes (i pages) (add-page (+ base (* i #x1000)) (1+ i)))
      (release-memory-range-in-pager base (* pages #x1000) nil)
      (assert (= (count-event :begin) expected))
      (assert (= (count-event :finish) expected))
      (assert (= (count-event :full) 1))
      (assert (= (count-if (lambda (event) (and (consp event)
                                              (eq (first event) :single)))
                           (events))
                 (if (= pages 257) 1 0)))
      (assert (= (hash-table-count *released-frames*) pages))
      (assert (= (count-if (lambda (event) (and (consp event) (eq (first event) :block)))
                           (events)) pages))
      (let ((events (events))
            (next 0))
        (loop for start = (position :begin events :start next)
              for finish = (and start (position :finish events :start start))
              while start
              do (assert finish)
                 (assert (notany (lambda (event)
                                   (and (consp event)
                                        (member (first event) '(:frame :block))))
                                 (subseq events start (1+ finish))))
                 (setf next (1+ finish)))))))

;; Sparse pages across a chunk boundary: only resident frames retire; every
;; block still leaves the store. Empty chunks never send an IPI.
(reset-fixture)
(let ((base #x200000000000))
  (dotimes (i 257) (add-absent-block (+ base (* i #x1000))))
  (add-page base 11)
  (add-page (+ base (* 256 #x1000)) 12)
  (release-memory-range-in-pager base (* 257 #x1000) nil)
  (assert (= (count-event :begin) 2))
  (assert (= (hash-table-count *released-frames*) 2))
  (assert (equal (mapcar #'first
                         (remove-if-not (lambda (event) (and (consp event)
                                                            (eq (first event) :frame)))
                                        (events)))
                 '(:frame :frame))))
(reset-fixture)
(let ((base #x200000000000))
  (dotimes (i 32) (add-absent-block (+ base (* i #x1000))))
  (release-memory-range-in-pager base (* 32 #x1000) nil)
  (assert (= (count-event :begin) 0))
  (assert (= (hash-table-count *released-frames*) 0)))

(reset-fixture)
(let ((base #x200000000000))
  (dotimes (i 32) (add-absent-block (+ base (* i #x1000))))
  (protect-memory-range-in-pager base (* 32 #x1000) 0)
  (assert (= (count-event :begin) 0)))

;; Mixed final metadata actions through the real helper: remove two pages,
;; permit write on one, force read-only on one. Only removed frames retire.
(reset-fixture)
(let ((base #x200000000000))
  (dolist (entry `((0 21 0)
                   (1 22 ,(logior sys.int::+block-map-present+
                                  sys.int::+block-map-zero-fill+))
                   (2 23 ,(logior sys.int::+block-map-present+
                                  sys.int::+block-map-writable+))
                   (3 24 ,(logior sys.int::+block-map-present+
                                  sys.int::+block-map-writable+
                                  sys.int::+block-map-track-dirty+))))
    (destructuring-bind (index frame flags) entry
      (add-page (+ base (* index #x1000)) frame flags)))
  (let ((*vm-lock-held* t))
    (update-memory-range-ptes-in-pager base (* 4 #x1000) nil nil nil))
  (assert (= (count-event :begin) 1))
  (assert (= (hash-table-count *released-frames*) 2))
  (assert (not (page-present-p (gethash base *ptes*))))
  (assert (not (page-present-p (gethash (+ base #x1000) *ptes*))))
  (assert (logtest 2 (page-table-entry (gethash (+ base #x2000) *ptes*))))
  (assert (not (logtest 2 (page-table-entry (gethash (+ base #x3000) *ptes*))))))

;; The public protect path updates all block flags under the writer lock,
;; then changes the PTEs in a batch. An absent page does not cause an IPI.
(reset-fixture)
(let ((base #x200000000000))
  (add-page base 31)
  (add-absent-block (+ base #x1000))
  (protect-memory-range-in-pager base #x2000 0)
  (assert (= (count-event :begin) 1))
  (assert (= (hash-table-count *released-frames*) 1))
  (let* ((events (events))
         (first-flags (position-if (lambda (event) (and (consp event)
                                                       (eq (first event) :flags))) events))
         (first-begin (position :begin events)))
    (assert (< first-flags first-begin))))

;; Non-stack release covers both card and data pages and preserves distinct
;; wired/stack flags at retirement. Card batch completes before data batch.
(reset-fixture)
(let* ((base #x4000)
       (card (+ sys.int::+card-table-base+
                (* (truncate base sys.int::+card-size+)
                   sys.int::+card-table-entry-size+))))
  (add-page card 41)
  (add-page base 42)
  (release-memory-range-in-pager base #x1000 nil)
  (assert (= (count-event :begin) 2))
  (assert (member '(:frame 41 t nil) (events) :test #'equal))
  (assert (member '(:frame 42 nil nil) (events) :test #'equal))
  (assert (< (position (list :block card) (events) :test #'equal)
             (position :begin (events) :start (1+ (position :finish (events)))))))

(reset-fixture)
(let ((base #x200000000000))
  (add-page base 51)
  (release-memory-range-in-pager base #x1000 nil)
  (assert (member '(:frame 51 t t) (events) :test #'equal)))

(format t "PASS: real pager batch boundaries, sparse pages, actions, frame/store order and range flush.~%")
