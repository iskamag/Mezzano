;;;; Build a private image with the native worker, without network/GUI IPL.
;;;; No installed image or primary source is changed.
(load (merge-pathnames "world-stop-cross.lisp" *load-truename*))
(let* ((guest (merge-pathnames "tools/tests/world-stop-guest.lisp" *world-stop-source*))
       (llf (merge-pathnames "guest.llf" *world-stop-output*))
       (marker (merge-pathnames "loader.lisp" *world-stop-output*))
       (mezzano.compiler::*target-architecture* :x86-64)
       (mezzano.compiler::*perform-tce* nil)
       (cross-cl:*features* (cons :x86-64 cross-cl:*features*)))
  (mezzano.compiler::cross-compile-file guest :output-file llf :verbose t :print nil)
  (with-open-file (in llf :element-type '(unsigned-byte 8))
    (mezzano.cold-generator.load:validate-llf-header in :x86-64))
  (with-open-file (out marker :direction :output :if-exists :supersede)
    (write-line "(in-package :mezzano.internals)" out)
    (let ((bytes (with-open-file (in llf :element-type '(unsigned-byte 8))
                   (let ((data (make-array (file-length in) :element-type '(unsigned-byte 8))))
                     (assert (= (read-sequence data in) (length data))) data))))
      (let ((*print-readably* t) (*print-length* nil) (*print-level* nil))
        (format out "(load-llf (mini-vector-stream ~S) t)~%" (coerce bytes 'simple-vector))))
    (write-line "(mezzano.world-stop-test:run)" out))
  (let ((cold-generator::*warm-source-files*
          (append (remove "ipl.lisp" cold-generator::*warm-source-files* :test #'equal)
                  (list (namestring marker))))
        (*default-pathname-defaults* *world-stop-source*))
    (cold-generator::make-image
     (merge-pathnames "native" *world-stop-output*) :image-size (* 5 1024 1024 1024)
     :header-path (or (uiop:getenv "MEZZANO_TEST_DISK_HEADER")
                      (merge-pathnames "tools/disk-header.bin" *world-stop-source*)))
    (format t "WORLD-STOP-PRIVATE-IMAGE-BUILT~%")))
