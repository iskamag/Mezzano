;;;; Call-site SLOT-VALUE closures share weak lookup and invalidation state.
(defpackage :clos-slot-call-site-test (:use :cl) (:export :run))
(in-package :clos-slot-call-site-test)

(defclass left () ((x :initarg :x :type fixnum)))
(defclass right () ((prefix :initform :guard) (x :initarg :x :type fixnum)))

(defun read-left (object) (slot-value object 'x))
(defun read-right (object) (slot-value object 'x))
(defun write-left (value object) (setf (slot-value object 'x) value))
(defun write-right (value object) (setf (slot-value object 'x) value))

(defmethod slot-unbound ((class standard-class) (object left) name)
  (declare (ignore class))
  (assert (eq name 'x))
  (assert (mezzano.internals::%value-has-tag-p object mezzano.internals::+tag-object+))
  :unbound)

(defgeneric override-reader (object))
(defmethod override-reader ((object left)) (declare (ignore object)) :override)
(defgeneric override-writer (value object))
(defmethod override-writer (value (object left))
  (declare (ignore object)) (list :override value))

(defun run ()
  (let* ((a (make-instance 'left :x 11))
         (b (make-instance 'right :x 13))
         (reader-gf (mezzano.clos::fast-slot-value-reader 'x))
         (writer-gf (mezzano.clos::fast-slot-value-writer 'x))
         (extra-reader (mezzano.clos::make-slot-value-reader 'x))
         (extra-writer (mezzano.clos::make-slot-value-writer 'x)))
    (assert (not (mezzano.internals::funcallable-instance-p extra-reader)))
    (assert (not (mezzano.internals::funcallable-instance-p extra-writer)))
    (dotimes (i 3)
      (assert (= (read-left a) 11))
      (assert (= (read-right b) 13))
      (assert (= (funcall extra-reader a) 11)))
    (assert (= (write-left 17 a) 17))
    (assert (= (write-right 19 b) 19))
    (assert (= (read-left a) 17))
    (assert (= (read-right b) 19))
    (assert (handler-case (progn (write-left :bad a) nil) (type-error () t)))
    (assert (eq (read-left (make-instance 'left)) :unbound))
    ;; Method changes replace the shared GF's table. Every existing site must
    ;; reject its detached weak cell and follow the GF's current dispatch mode.
    (dolist (writerp '(nil t))
      (let* ((source (if writerp #'override-writer #'override-reader))
             (target (if writerp writer-gf reader-gf))
             (specializers (if writerp
                               (list (find-class 't) (find-class 'left))
                               (list (find-class 'left))))
             (method (find-method source nil specializers)))
        (unwind-protect
             (progn
               (remove-method source method)
               (add-method target method)
               (if writerp
                   (progn
                     (assert (equal (write-left 23 a) '(:override 23)))
                     (assert (equal (funcall extra-writer 29 a) '(:override 29)))
                     (assert (= (write-right 19 b) 19)))
                   (progn
                     (assert (eq (read-left a) :override))
                     (assert (eq (funcall extra-reader a) :override))
                     (assert (= (read-right b) 19)))))
          (when (eq (mezzano.clos:method-generic-function method) target)
            (remove-method target method))
          (unless (eq (mezzano.clos:method-generic-function method) source)
            (add-method source method)))))
    (assert (= (read-left a) 17))
    (assert (= (funcall extra-writer 31 a) 31))
    (eval '(defclass left () ((prefix :initform :new-guard) (x :initarg :x :type fixnum))))
    (assert (= (read-left a) 31))
    (mezzano.internals::gc :full t)
    (assert (= (funcall extra-reader a) 31))
    (assert (= (write-left 37 a) 37))
    (assert (eq (slot-value a 'prefix) :new-guard))
    (assert (= (read-right b) 19)))
  (format t "CLOS-SLOT-CALL-SITE-PASSED~%")
  :passed)
