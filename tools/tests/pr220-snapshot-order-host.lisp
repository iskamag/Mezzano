;;; Run with: sbcl --script tools/tests/pr220-snapshot-order-host.lisp
;;; Execute both real snapshot CoW walkers on a synthetic four-level table.

(defpackage :sys.int (:use :cl))
(defpackage :mezzano.supervisor (:use :cl))
(in-package :sys.int)
(defvar mezzano.supervisor::*events* nil)
(defvar mezzano.supervisor::*tlb-shootdown-in-progress* nil)
(defvar *entries* (make-hash-table :test #'equal))
(defun memref-unsigned-byte-64 (address index)
  (gethash (list address index) *entries* 0))
(defun (setf memref-unsigned-byte-64) (value address index)
  (when (= address #x4000)
    (assert mezzano.supervisor::*tlb-shootdown-in-progress*)
    (push :pte mezzano.supervisor::*events*))
  (setf (gethash (list address index) *entries*) value))
(defun %cr3 () #x1000)

(in-package :mezzano.supervisor)
(defvar *tlb-shootdown-in-progress* nil)
(defvar *events* nil)
(defconstant +x86-64-pte-address-mask+ #xFFFFFFFFF000)
(defconstant +x86-64-pte-present+ 1)
(defconstant +x86-64-pte-write+ 2)
(defconstant +x86-64-pte-accessed+ #x20)
(defconstant +x86-64-pte-dirty+ #x40)
(defconstant +x86-64-pte-copy-on-write+ #x400)
(defconstant +arm64-tte-address-mask+ #xFFFFFFFFF000)
(defconstant +arm64-tte-present+ 1)
(defconstant +arm64-tte-dirty+ #x40)
(defconstant +arm64-tte-copy-on-write+ #x400)
(defun convert-to-pmap-address (address) address)
(defun %ttbr0-el1 () #x1000)
(defun pte-physical-address (entry) (logand entry +arm64-tte-address-mask+))
(defun make-pte (frame &key copy-on-write)
  (logior (ash frame 12) (if copy-on-write +arm64-tte-copy-on-write+ 0)))
(defun snapshot-add-writeback-frame (frame)
  (assert (= frame 5))
  (assert (not *tlb-shootdown-in-progress*))
  (push :prepare *events*))
(defun begin-tlb-shootdown ()
  (setf *tlb-shootdown-in-progress* t)
  (push :begin *events*))
(defun tlb-shootdown-all ()
  (assert *tlb-shootdown-in-progress*)
  (push :flush *events*))
(defun flush-tlb ()
  (assert *tlb-shootdown-in-progress*)
  (push :flush *events*))
(defun finish-tlb-shootdown ()
  (setf *tlb-shootdown-in-progress* nil)
  (push :finish *events*))
(defun panic (&rest args) (error "~{~A~}" args))

(defun load-walker (path)
  (with-open-file (stream (merge-pathnames path *load-truename*))
    (loop for position = (file-position stream)
          for line = (read-line stream nil)
          while line
          when (search "(defun snapshot-mark-cow-dirty-pages " line)
            do (file-position stream position)
               (eval (read stream))
               (return))))

(defun check-walker (path)
  (clrhash sys.int::*entries*)
  (setf *events* nil *tlb-shootdown-in-progress* nil)
  (setf (gethash '(#x1000 1) sys.int::*entries*) #x2021
        (gethash '(#x2000 0) sys.int::*entries*) #x3021
        (gethash '(#x3000 0) sys.int::*entries*) #x4021
        (gethash '(#x4000 0) sys.int::*entries*) #x5063)
  (load-walker path)
  (snapshot-mark-cow-dirty-pages)
  (let ((events (reverse *events*)))
    (assert (equal events '(:prepare :begin :pte :flush :finish)))))

(check-walker "../../supervisor/x86-64/snapshot.lisp")
(check-walker "../../supervisor/arm64/snapshot.lisp")
(format t "PASS: both real snapshot walkers prepare metadata before CoW PTE rendezvous.~%")
