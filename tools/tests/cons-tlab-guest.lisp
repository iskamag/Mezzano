;;;; Target-only allocation/GC regression. See cons-tlab-image.lisp for a
;;;; private image which runs this before the normal network/GUI IPL.
(defpackage :mezzano.cons-tlab-test (:use :cl) (:export :run))
(in-package :mezzano.cons-tlab-test)

(defun check (test reason)
  (unless test
    (mezzano.supervisor:panic "Cons TLAB test: " reason)))

(defun make-chain (count seed &optional (accounting t))
  (let* ((thread (mezzano.supervisor:current-thread))
         (before (mezzano.supervisor:thread-bytes-consed thread))
         (head nil))
    (dotimes (i count)
      (setf head (cons (+ seed i) head)))
    (when accounting
      (check (= (- (mezzano.supervisor:thread-bytes-consed thread) before)
                (* count 16))
             :allocation-accounting))
    head))

(defun check-chain (head count seed)
  (loop for i downfrom (1- count) to 0
        do (check (consp head) :chain-length)
           (check (= (car head) (+ seed i)) :chain-value)
           (setf head (cdr head)))
  (check (null head) :chain-end))

(defun check-boundary ()
  ;; Fill a real TLAB exactly, retaining the final cons across the refill.
  ;; Prevent GC/footholds from invalidating the boundary while checking it.
  (let ((first (cons :first :cdr)))
    (mezzano.supervisor:without-footholds
      (mezzano.supervisor:with-pseudo-atomic
        (let* ((thread (mezzano.supervisor:current-thread))
               (limit (mezzano.supervisor::thread-cons-tlab-limit thread))
               (remaining (- limit (mezzano.supervisor::thread-cons-tlab-bump thread)))
               (last first))
          (dotimes (i (truncate remaining 16))
            (multiple-value-bind (cell ignored failurep)
                (mezzano.runtime::do-cons i last)
              (declare (ignore ignored))
              (check (not failurep) :last-slot-available)
              (setf last cell)))
          (check (= (mezzano.supervisor::thread-cons-tlab-bump thread) limit)
                 :exact-limit)
          (multiple-value-bind (a b failurep)
              (mezzano.runtime::do-cons :car :cdr)
            (check (and (eq a :car) (eq b :cdr) failurep) :exhaustion-values))
          (let ((cell (cons last first)))
            (check (and (eq (car cell) last) (eq (cdr cell) first)) :refill-values)
            (check (= (- (mezzano.supervisor::thread-cons-tlab-limit thread)
                         (mezzano.supervisor::thread-cons-tlab-bump thread))
                      (- mezzano.internals::+cons-tlab-size+ 16))
                   :refill-size)))))))

(defun check-foothold-restart-1 (function)
  ;; Check every saved PC: only PCs in the restart region rewind.
  ;; The injection path calls this helper before publishing an interrupt frame.
  (let* ((base (logand (mezzano.internals::lisp-object-address function) -16))
         (size (mezzano.internals::function-code-size function))
         (expected (make-array size :initial-element nil))
         (thread (mezzano.supervisor::%make-thread "Cons restart probe"))
         (previous 0)
         (restart nil))
    (flet ((entry (start framep interruptp pushed-values pushed-values-register
                   layout-address layout-length multiple-values incoming-arguments
                   block-or-tagbody-thunk extra-registers restartp)
             (declare (ignore framep interruptp pushed-values pushed-values-register
                              layout-address layout-length multiple-values incoming-arguments
                              block-or-tagbody-thunk extra-registers))
             (loop for pc from previous below start do (setf (aref expected pc) restart))
             (setf previous start restart (and restartp start))))
      (declare (dynamic-extent #'entry))
      (mezzano.internals::map-function-gc-metadata #'entry function))
    (loop for pc from previous below size do (setf (aref expected pc) restart))
    (dotimes (pc size)
      (setf (mezzano.supervisor:thread-state-rip thread) (+ base pc))
      (mezzano.supervisor::restart-cons-allocation thread)
      (check (= (mezzano.supervisor:thread-state-rip thread)
                (+ base (or (aref expected pc) pc))) :foothold-restart-pc))))

(defun check-threads ()
  (let ((threads (make-array 4))
        (ready (make-array 4))
        (results (make-array 4))
        (resume (mezzano.supervisor:make-event)))
    (dotimes (i 4)
      (setf (aref ready i) (mezzano.supervisor:make-event))
      (let ((index i))
        (setf (aref threads i)
              (mezzano.supervisor:make-thread
               (lambda ()
                 (let* ((seed (* index 1000000))
                        (head (make-chain 20000 seed)))
                   (setf (aref results index) head
                         (mezzano.supervisor:event-state (aref ready index)) t)
                   (mezzano.supervisor:event-wait resume)
                   (check-chain head 20000 seed)
                   (setf head (make-chain 60000 seed))
                   (check-chain head 60000 seed)
                   (setf (aref results index) head)
                   :passed))
               :name "Cons TLAB regression"))))
    (dotimes (i 4)
      (mezzano.supervisor:event-wait (aref ready i)))
    ;; All four workers retain live conses and an unused TLAB tail while parked.
    (dotimes (cycle 2)
      (mezzano.internals::gc :full (= cycle 1))
      (dotimes (i 4)
        (let ((thread (aref threads i)))
          (check (zerop (mezzano.supervisor::thread-cons-tlab-bump thread)) :gc-bump-reset)
          (check (zerop (mezzano.supervisor::thread-cons-tlab-limit thread)) :gc-limit-reset))
        (check-chain (aref results i) 20000 (* i 1000000))))
    (setf (mezzano.supervisor:event-state resume) t)
    ;; Collect while the workers allocate and cross many refill boundaries.
    (dotimes (cycle 8)
      (mezzano.internals::gc :full (oddp cycle)))
    (dotimes (i 4)
      (let ((values (mezzano.supervisor:thread-join (aref threads i))))
        (check (equal values '(:passed)) :worker-completion))
      (check-chain (aref results i) 60000 (* i 1000000)))
    (mezzano.internals::gc :full t)
    (dotimes (i 4)
      (check-chain (aref results i) 60000 (* i 1000000)))))

(defun check-allocating-footholds ()
  (let* ((stop (vector nil))
         (callbacks (vector 0 nil))
         (ready (mezzano.supervisor:make-event))
         (worker (mezzano.supervisor:make-thread
                  (lambda ()
                    (setf (mezzano.supervisor:event-state ready) t)
                    (loop until (aref stop 0)
                          do (check-chain (make-chain 5000 71 nil) 5000 71))
                    :passed)
                  :name "Cons foothold regression")))
    (mezzano.supervisor:event-wait ready)
    (dotimes (i 100)
      (mezzano.supervisor:establish-thread-foothold
       worker (lambda ()
                (let ((head (make-chain 100 37 nil)))
                  (check-chain head 100 37)
                  (setf (aref callbacks 1) head)
                  (incf (aref callbacks 0)))))
      (when (zerop (mod i 10)) (mezzano.internals::gc)))
    (loop until (= (aref callbacks 0) 100) do (mezzano.supervisor:thread-yield))
    (setf (aref stop 0) t)
    (check (equal (mezzano.supervisor:thread-join worker) '(:passed)) :foothold-worker)
    (check-chain (aref callbacks 1) 100 37)))

(defun run ()
  (mezzano.supervisor:debug-print-line "CONS-TLAB-TEST-BEGIN")
  (let* ((layout (mezzano.internals::%instance-layout (mezzano.supervisor:current-thread)))
         (bits (mezzano.internals::layout-heap-layout layout)))
    (check (and (bit-vector-p bits)
                (zerop (bit bits mezzano.supervisor::+thread-cons-tlab-bump+))
                (zerop (bit bits mezzano.supervisor::+thread-cons-tlab-limit+)))
           :raw-buffer-slots-not-roots))
  (check-boundary)
  (mezzano.supervisor:debug-print-line "CONS-TLAB-BOUNDARY-PASSED")
  (check-chain (make-chain 100000 17) 100000 17)
  (mezzano.supervisor:debug-print-line "CONS-TLAB-REFILL-ACCOUNTING-PASSED")
  (check-foothold-restart-1 #'mezzano.runtime::do-cons)
  (check-foothold-restart-1 #'cons)
  (mezzano.supervisor:debug-print-line "CONS-TLAB-FOOTHOLD-RESTART-PASSED")
  (check-threads)
  (mezzano.supervisor:debug-print-line "CONS-TLAB-SMP-GC-PASSED")
  (check-allocating-footholds)
  (mezzano.supervisor:debug-print-line "CONS-TLAB-ALLOCATING-FOOTHOLDS-PASSED")
  (let ((pinned (mezzano.internals::cons-in-area :pinned :cdr :pinned))
        (wired (mezzano.internals::cons-in-area :wired :cdr :wired)))
    (mezzano.internals::gc :full t)
    (check (and (eq (car pinned) :pinned) (eq (cdr pinned) :cdr)
                (eq (car wired) :wired) (eq (cdr wired) :cdr)) :static-conses))
  (mezzano.supervisor:debug-print-line "CONS-TLAB-TEST-PASSED"))
