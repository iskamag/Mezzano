;;;; Run after the cold regression in structure-reparent-image.lisp.
;;;; Measures definition-time overhead and cached dispatch after reparenting.
(defpackage :mezzano.structure-reparent-benchmark
  (:use :cl)
  (:export :run))
(in-package :mezzano.structure-reparent-benchmark)

(defstruct base-a)
(defstruct base-b)
(defstruct (original (:include base-a)) value)
(defstruct (revised (:include base-a)) value)
(defstruct (hot-middle (:include base-a)) value)
(defstruct (hot-leaf (:include hot-middle)))
(defgeneric route (object))
(defmethod route ((object base-a)) 7)
(defmethod route ((object base-b)) 7)

;; The original two-argument population function is kept too, so the
;; baseline does not inherit the new resolved-parent optimization.
(in-package :mezzano.internals)
(defun benchmark-original-direct-slots (sdef)
  (let* ((direct-slots (remove-if (lambda (slot)
                                    (and (structure-definition-parent sdef)
                                         (find (structure-slot-definition-name slot)
                                               (structure-definition-slots sdef)
                                               :key #'structure-slot-definition-name)))
                                  (structure-definition-slots sdef)))
         (class (find-class 'mezzano.clos::structure-direct-slot-definition))
         (layout (mezzano.runtime::instance-access-by-name class 'mezzano.clos::slot-storage-layout)))
    (loop for slot in direct-slots
          collect (let ((new (%allocate-instance layout)))
                    (setf (mezzano.runtime::instance-access-by-name new 'mezzano.clos::name)
                          (structure-slot-definition-name slot))
                    (setf (mezzano.runtime::instance-access-by-name new 'mezzano.clos::type)
                          (structure-slot-definition-type slot))
                    (setf (mezzano.runtime::instance-access-by-name new 'mezzano.clos::read-only)
                          (structure-slot-definition-read-only slot))
                    (setf (mezzano.runtime::instance-access-by-name new 'mezzano.clos::initform)
                          (structure-slot-definition-initform slot))
                    (setf (mezzano.runtime::instance-access-by-name new 'mezzano.clos::fixed-vector)
                          (structure-slot-definition-fixed-vector slot))
                    (setf (mezzano.runtime::instance-access-by-name new 'mezzano.clos::align)
                          (structure-slot-definition-align slot))
                    (setf (mezzano.runtime::instance-access-by-name new 'mezzano.clos::dcas-sibling)
                          (structure-slot-definition-dcas-sibling slot))
                    (setf (mezzano.runtime::instance-access-by-name new 'mezzano.clos::documentation)
                          (structure-slot-definition-documentation slot))
                    new))))

(defun benchmark-original-populate (new-class sdef)
  (let* ((parent (structure-definition-parent sdef))
         (parent-class (or (and parent (%defstruct parent))
                           (find-class 'structure-object))))
    (when (mezzano.runtime::instance-access-by-name parent-class 'mezzano.clos::sealed)
      (error "Attempted to make structure class ~S that includes sealed structure ~S"
             (structure-definition-name sdef)
             (mezzano.runtime::instance-access-by-name parent-class 'mezzano.clos::name)))
    (setf (mezzano.runtime::instance-access-by-name new-class 'mezzano.clos::name)
          (structure-definition-name sdef))
    (setf (mezzano.runtime::instance-access-by-name new-class 'mezzano.clos::direct-superclasses)
          (list parent-class))
    (setf (mezzano.runtime::instance-access-by-name new-class 'mezzano.clos::direct-slots)
          (benchmark-original-direct-slots sdef))
    (setf (mezzano.runtime::instance-access-by-name new-class 'mezzano.clos::precedence-list)
          (list* new-class (mezzano.runtime::instance-access-by-name parent-class 'mezzano.clos::precedence-list)))
    (setf (mezzano.runtime::instance-access-by-name new-class 'mezzano.clos::effective-slots)
          (convert-structure-definition-effective-slots sdef))
    (setf (mezzano.runtime::instance-access-by-name new-class 'mezzano.clos::direct-default-initargs) '())
    (setf (mezzano.runtime::instance-access-by-name new-class 'mezzano.clos::finalized-p) t)
    (setf (mezzano.runtime::instance-access-by-name new-class 'mezzano.clos::default-initargs) '())
    (setf (mezzano.runtime::instance-access-by-name new-class 'mezzano.clos::sealed)
          (structure-definition-sealed sdef))
    (setf (mezzano.runtime::instance-access-by-name new-class 'mezzano.clos::allocation-area)
          (structure-definition-area sdef))
    (setf (mezzano.runtime::instance-access-by-name new-class 'mezzano.clos::parent) parent-class)
    (setf (mezzano.runtime::instance-access-by-name new-class 'mezzano.clos::constructor) nil)
    (setf (mezzano.runtime::instance-access-by-name new-class 'documentation)
          (structure-definition-docstring sdef))
    (setf (mezzano.runtime::instance-access-by-name new-class 'mezzano.clos::has-standard-constructor)
          (structure-definition-has-standard-constructor sdef))))

(defun benchmark-original-slot-compatible-p (class new-slot)
  (let ((old-slot (find (structure-slot-definition-name new-slot)
                        (mezzano.runtime::instance-access-by-name class 'mezzano.clos::effective-slots)
                        :key (lambda (slot)
                               (mezzano.runtime::instance-access-by-name slot 'mezzano.clos::name)))))
    (and old-slot
         (equal (structure-slot-definition-type new-slot)
                (mezzano.runtime::instance-access-by-name old-slot 'mezzano.clos::type))
         (eql (structure-slot-definition-read-only new-slot)
              (mezzano.runtime::instance-access-by-name old-slot 'mezzano.clos::read-only))
         (eql (structure-slot-definition-location new-slot)
              (mezzano.runtime::instance-access-by-name old-slot 'mezzano.clos::location))
         (eql (structure-slot-definition-fixed-vector new-slot)
              (mezzano.runtime::instance-access-by-name old-slot 'mezzano.clos::fixed-vector))
         (eql (structure-slot-definition-align new-slot)
              (mezzano.runtime::instance-access-by-name old-slot 'mezzano.clos::align))
         (eql (structure-slot-definition-dcas-sibling new-slot)
              (mezzano.runtime::instance-access-by-name old-slot 'mezzano.clos::dcas-sibling))
         (equal (structure-slot-definition-initform new-slot)
                (mezzano.runtime::instance-access-by-name old-slot 'mezzano.clos::initform)))))

;; The upstream compatibility path, including its original slot comparator.
(defun benchmark-original-structure-compatible-p (class sdef)
  (let* ((parent (structure-definition-parent sdef))
         (parent-class (or (and parent (%defstruct parent))
                           (find-class 'structure-object))))
    (and (eql (mezzano.runtime::instance-access-by-name class 'mezzano.clos::name)
              (structure-definition-name sdef))
         (eql (mezzano.runtime::instance-access-by-name class 'mezzano.clos::parent) parent-class)
         (eql (mezzano.runtime::instance-access-by-name class 'mezzano.clos::allocation-area)
              (structure-definition-area sdef))
         (eql (layout-heap-size (mezzano.runtime::instance-access-by-name class 'mezzano.clos::slot-storage-layout))
              (structure-definition-size sdef))
         (equal (layout-heap-layout (mezzano.runtime::instance-access-by-name class 'mezzano.clos::slot-storage-layout))
                (layout-heap-layout (structure-definition-layout sdef)))
         (eql (mezzano.runtime::instance-access-by-name class 'mezzano.clos::sealed)
              (structure-definition-sealed sdef))
         (eql (length (mezzano.runtime::instance-access-by-name class 'mezzano.clos::effective-slots))
              (length (structure-definition-slots sdef)))
         (every (lambda (slot) (benchmark-original-slot-compatible-p class slot))
                (structure-definition-slots sdef)))))

(defun benchmark-original-layout-compatible-p (object layout)
  (declare (optimize (speed 3) (safety 0) (debug 0)))
  (when (instance-p object)
    (loop with object-layout of-type layout = (%instance-layout object)
          with compatible of-type simple-vector = (layout-compatible object-layout)
          for candidate across compatible
            thereis (eq candidate layout))))
(in-package :mezzano.structure-reparent-benchmark)

;; The upstream implementation, retained under another name for timing
;; slot-default changes on structures without descendants.
(defun baseline-redefine (class sdef)
  (assert (not (eql class (find-class 'structure-object))))
  (assert (not (mezzano.clos:class-sealed class)) () "Cannot redefined sealed struct ~S" class)
  (let ((new-layout (mezzano.internals::make-layout
                     :class class
                     :hash (mezzano.clos::safe-class-hash class)
                     :obsolete nil
                     :heap-size (mezzano.internals::structure-definition-size sdef)
                     :heap-layout (mezzano.internals::layout-heap-layout
                                   (mezzano.internals::structure-definition-layout sdef))
                     :area (mezzano.internals::structure-definition-area sdef)
                     :instance-slots (mezzano.internals::convert-structure-definition-instance-slots sdef)
                     :compatible (make-array 0 :area :wired)))
        (prev-layout (mezzano.clos:class-layout class)))
    (mezzano.internals::benchmark-original-populate class sdef)
    (when (not (mezzano.clos::class-layouts-compatible-p prev-layout new-layout))
      (setf (mezzano.runtime::instance-access-by-name class 'mezzano.clos::slot-storage-layout)
            new-layout)
      (setf (mezzano.internals::layout-obsolete prev-layout) new-layout)))
  class)

(defun definition-with (class parent initform)
  (let* ((source (mezzano.internals::convert-structure-class-to-structure-definition class))
         (slots
           (loop for slot in (mezzano.internals::structure-definition-slots source)
                 collect (mezzano.internals::make-struct-slot-definition
                          (mezzano.internals::structure-slot-definition-name slot)
                          (mezzano.internals::structure-slot-definition-accessor slot)
                          initform
                          (mezzano.internals::structure-slot-definition-type slot)
                          (mezzano.internals::structure-slot-definition-read-only slot)
                          (mezzano.internals::structure-slot-definition-location slot)
                          (mezzano.internals::structure-slot-definition-fixed-vector slot)
                          (mezzano.internals::structure-slot-definition-align slot)
                          (mezzano.internals::structure-slot-definition-dcas-sibling slot)
                          (mezzano.internals::structure-slot-definition-documentation slot)))))
    (mezzano.internals::make-struct-definition
     (mezzano.internals::structure-definition-name source) slots parent
     (mezzano.internals::structure-definition-area source)
     (mezzano.internals::structure-definition-size source)
     (mezzano.internals::layout-heap-layout (mezzano.internals::structure-definition-layout source))
     (mezzano.internals::structure-definition-sealed source)
     (mezzano.internals::structure-definition-docstring source)
     (mezzano.internals::structure-definition-has-standard-constructor source))))

(defun definition-trial (function class first second iterations)
  (let* ((thread (mezzano.supervisor:current-thread))
         (bytes-before (mezzano.supervisor:thread-bytes-consed thread))
         (gc-before mezzano.internals::*gc-cycles*)
         (start (mezzano.supervisor:get-high-precision-timer)))
    (dotimes (i iterations)
      (funcall function class (if (evenp i) first second)))
    (let ((ticks (- (mezzano.supervisor:get-high-precision-timer) start))
          (bytes (- (mezzano.supervisor:thread-bytes-consed thread) bytes-before))
          (gcs (- mezzano.internals::*gc-cycles* gc-before)))
      (assert (plusp ticks))
      (assert (plusp bytes))
      (assert (zerop gcs))
      (assert (= 1 (mezzano.clos:slot-definition-initform
                    (first (mezzano.clos:class-slots class)))))
      (values ticks bytes))))

(defun compatibility-trial (function class definition iterations)
  (let* ((thread (mezzano.supervisor:current-thread))
         (bytes-before (mezzano.supervisor:thread-bytes-consed thread))
         (gc-before mezzano.internals::*gc-cycles*)
         (start (mezzano.supervisor:get-high-precision-timer)))
    (dotimes (i iterations)
      (assert (funcall function class definition)))
    (let ((ticks (- (mezzano.supervisor:get-high-precision-timer) start))
          (bytes (- (mezzano.supervisor:thread-bytes-consed thread) bytes-before)))
      (assert (plusp ticks))
      (assert (= gc-before mezzano.internals::*gc-cycles*))
      (values ticks bytes))))

(defun dispatch-loop (object count)
  (declare (optimize (speed 3) (safety 0) (debug 0)) (type fixnum count))
  (let ((sum 0))
    (declare (type fixnum sum))
    (dotimes (i count sum)
      (incf sum (the fixnum (route object))))))

(defun dispatch-trial (object count)
  (let* ((thread (mezzano.supervisor:current-thread))
         (bytes-before (mezzano.supervisor:thread-bytes-consed thread))
         (gc-before mezzano.internals::*gc-cycles*)
         (start (mezzano.supervisor:get-high-precision-timer))
         (value (dispatch-loop object count))
         (ticks (- (mezzano.supervisor:get-high-precision-timer) start))
         (bytes (- (mezzano.supervisor:thread-bytes-consed thread) bytes-before)))
    (assert (= value (* count 7)))
    (assert (zerop bytes))
    (assert (= gc-before mezzano.internals::*gc-cycles*))
    ticks))

(defun median (vector)
  (let ((sorted (sort (copy-seq vector) #'<)))
    (aref sorted (floor (length sorted) 2))))

(defun layout-trial (function object layout expected iterations)
  (let* ((thread (mezzano.supervisor:current-thread))
         (bytes-before (mezzano.supervisor:thread-bytes-consed thread))
         (gc-before mezzano.internals::*gc-cycles*)
         (start (mezzano.supervisor:get-high-precision-timer))
         (matches 0))
    (dotimes (i iterations)
      (when (funcall function object layout)
        (incf matches)))
    (let ((ticks (- (mezzano.supervisor:get-high-precision-timer) start)))
      (assert (= matches (if expected iterations 0)))
      (assert (= bytes-before (mezzano.supervisor:thread-bytes-consed thread)))
      (assert (= gc-before mezzano.internals::*gc-cycles*))
      ticks)))

(defun layout-benchmark (label function object layout expected pairs calls)
  (let ((old-ticks (make-array pairs)) (new-ticks (make-array pairs))
        (ratios (make-array pairs)))
    (layout-trial #'mezzano.internals::benchmark-original-layout-compatible-p object layout expected 100)
    (layout-trial function object layout expected 100)
    (dotimes (i pairs)
      (flet ((old-trial ()
               (setf (aref old-ticks i)
                     (layout-trial #'mezzano.internals::benchmark-original-layout-compatible-p
                                   object layout expected calls)))
             (new-trial ()
               (setf (aref new-ticks i) (layout-trial function object layout expected calls))))
        (if (evenp i) (progn (old-trial) (new-trial))
            (progn (new-trial) (old-trial))))
      (setf (aref ratios i) (/ (float (aref new-ticks i) 1d0) (aref old-ticks i)))
      (format t "REPARENT-BENCH-LAYOUT ~A ~D old=~D new=~D ratio=~,4F~%"
              label i (aref old-ticks i) (aref new-ticks i) (aref ratios i)))
    (format t "REPARENT-BENCH-LAYOUT-MEDIAN ~A old=~D new=~D ratio=~,4F bytes=0~%"
            label (median old-ticks) (median new-ticks) (median ratios))))

(defun run (&key (pairs 11) (definitions 1000) (compatibility-checks 5000) (calls 200000))
  (let ((*package* (find-package :mezzano.structure-reparent-benchmark)))
    (let* ((a (find-class 'base-a))
           (b (find-class 'base-b))
           (old-class (find-class 'original))
           (new-class (find-class 'revised))
           (middle (find-class 'hot-middle))
           (object (make-hot-leaf))
           (old-zero (definition-with old-class a 0))
           (old-one (definition-with old-class a 1))
           (new-zero (definition-with new-class a 0))
           (new-one (definition-with new-class a 1))
           (middle-a (definition-with middle a nil))
           (middle-b (definition-with middle b nil))
           (old-ticks (make-array pairs)) (new-ticks (make-array pairs))
           (ratios (make-array pairs)) (compat-old (make-array pairs))
           (compat-new (make-array pairs)) (compat-ratios (make-array pairs))
           (a-ticks (make-array pairs))
           (b-ticks (make-array pairs)) (dispatch-ratios (make-array pairs))
           (old-bytes 0) (new-bytes 0) (compat-old-bytes 0) (compat-new-bytes 0))
      (assert (evenp definitions))
      (format t "~&REPARENT-BENCH-BEGIN pairs=~D definitions=~D compatibility-checks=~D dispatch-calls=~D~%"
              pairs definitions compatibility-checks calls)
      (definition-trial #'baseline-redefine old-class old-zero old-one 2)
      (definition-trial #'mezzano.clos::redefine-structure-type new-class new-zero new-one 2)
      (route object)
      (dispatch-loop object 128)
      (mezzano.internals::gc :full t)
      (dotimes (i pairs)
        (flet ((old-trial ()
                 (multiple-value-bind (ticks bytes)
                     (definition-trial #'baseline-redefine old-class old-zero old-one definitions)
                   (setf (aref old-ticks i) ticks old-bytes bytes)))
               (new-trial ()
                 (multiple-value-bind (ticks bytes)
                     (definition-trial #'mezzano.clos::redefine-structure-type new-class new-zero new-one definitions)
                   (setf (aref new-ticks i) ticks new-bytes bytes))))
          (if (evenp i) (progn (old-trial) (new-trial))
              (progn (new-trial) (old-trial))))
        (setf (aref ratios i) (/ (float (aref new-ticks i) 1d0) (aref old-ticks i)))
        (format t "REPARENT-BENCH-DEF ~D old=~D new=~D ratio=~,4F~%"
                i (aref old-ticks i) (aref new-ticks i) (aref ratios i)))
      (format t "REPARENT-BENCH-DEF-MEDIAN old=~D new=~D ratio=~,4F old-bytes=~D new-bytes=~D~%"
              (median old-ticks) (median new-ticks) (median ratios) old-bytes new-bytes)
      (dotimes (i pairs)
        (flet ((old-trial ()
                 (multiple-value-bind (ticks bytes)
                     (compatibility-trial #'mezzano.internals::benchmark-original-structure-compatible-p
                                          old-class old-one compatibility-checks)
                   (setf (aref compat-old i) ticks compat-old-bytes bytes)))
               (new-trial ()
                 (multiple-value-bind (ticks bytes)
                     (compatibility-trial #'mezzano.internals::structure-definition-trivially-compatible-p
                                          old-class old-one compatibility-checks)
                   (setf (aref compat-new i) ticks compat-new-bytes bytes))))
          (if (evenp i) (progn (old-trial) (new-trial))
              (progn (new-trial) (old-trial))))
        (setf (aref compat-ratios i) (/ (float (aref compat-new i) 1d0) (aref compat-old i)))
        (format t "REPARENT-BENCH-COMPAT ~D old=~D new=~D ratio=~,4F~%"
                i (aref compat-old i) (aref compat-new i) (aref compat-ratios i)))
      (format t "REPARENT-BENCH-COMPAT-MEDIAN old=~D new=~D ratio=~,4F old-bytes=~D new-bytes=~D~%"
              (median compat-old) (median compat-new) (median compat-ratios)
              compat-old-bytes compat-new-bytes)
      (let ((cold-object (mezzano.internals::make-reparent-cold-leaf))
            (present (mezzano.clos:class-layout (find-class 'mezzano.internals::reparent-cold-new)))
            (absent (mezzano.clos:class-layout (find-class 'mezzano.internals::reparent-cold-old))))
        (layout-benchmark "TYPEP-HIT" #'mezzano.internals::structure-layout-typep
                          cold-object present t pairs calls)
        (layout-benchmark "TYPEP-MISS" #'mezzano.internals::structure-layout-typep
                          cold-object absent nil pairs calls)
        (layout-benchmark "SLOT-HIT" #'mezzano.internals::structure-layout-compatible-p
                          cold-object present t pairs calls)
        (layout-benchmark "SLOT-MISS" #'mezzano.internals::structure-layout-compatible-p
                          cold-object absent nil pairs calls))
      (dotimes (i pairs)
        (flet ((a-trial ()
                 (mezzano.clos::redefine-structure-type middle middle-a)
                 (assert (= (route object) 7))
                 (setf (aref a-ticks i) (dispatch-trial object calls)))
               (b-trial ()
                 (mezzano.clos::redefine-structure-type middle middle-b)
                 (assert (= (route object) 7))
                 (setf (aref b-ticks i) (dispatch-trial object calls))))
          (if (evenp i) (progn (a-trial) (b-trial))
              (progn (b-trial) (a-trial))))
        (setf (aref dispatch-ratios i) (/ (float (aref b-ticks i) 1d0) (aref a-ticks i)))
        (format t "REPARENT-BENCH-DISPATCH ~D a=~D b=~D ratio=~,4F~%"
                i (aref a-ticks i) (aref b-ticks i) (aref dispatch-ratios i)))
      (format t "REPARENT-BENCH-DISPATCH-MEDIAN a=~D b=~D ratio=~,4F~%"
              (median a-ticks) (median b-ticks) (median dispatch-ratios))
      (format t "REPARENT-BENCH-PASSED~%")
      (finish-output))))
