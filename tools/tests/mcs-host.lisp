;;; Run with: sbcl --script tools/tests/mcs-host.lisp
;;; The real scheduler lock functions run with synthetic wired CPU objects.

(defpackage :sys.int (:use :cl))
(defpackage :mezzano.supervisor (:use :cl))
(in-package :sys.int)
(defvar *cas-mutex* (sb-thread:make-mutex :name "MCS host CAS"))
(defvar *after-cas-hook* nil)
(defun symbol-global-value (symbol) (symbol-value symbol))
(defun cpu-relax () (sb-thread:thread-yield))
(defmacro cas (place old new)
  (declare (ignore place))
  (let ((expected (gensym)) (replacement (gensym)) (previous (gensym)))
    `(let* ((,expected ,old)
            (,replacement ,new)
            (,previous (sb-thread:with-mutex (*cas-mutex*)
                         (let ((before mezzano.supervisor::*global-thread-lock*))
                           (when (eq before ,expected)
                             (setf mezzano.supervisor::*global-thread-lock* ,replacement))
                           before))))
       (when (and (eq ,previous ,expected) *after-cas-hook*)
         (funcall *after-cas-hook* ,previous ,replacement))
       ,previous)))

(in-package :mezzano.supervisor)
(defvar *global-thread-lock* nil)
(defvar *this-cpu* nil)
(defvar *interrupts-disabled* t)
(defstruct cpu mcs-next mcs-locked)
(defun local-cpu () *this-cpu*)
(defun ensure-interrupts-disabled ()
  (unless *interrupts-disabled* (error "MCS lock used with interrupts on")))
(defmacro ensure (condition &rest message)
  `(unless ,condition (error "~{~A~}" (list ,@message))))
(defun panic (&rest message)
  (error "~{~A~}" message))

(defun load-lock-functions ()
  (with-open-file (stream (merge-pathnames "../../supervisor/thread.lisp" *load-truename*))
    (loop for position = (file-position stream)
          for line = (read-line stream nil)
          while line
          when (or (search "(defun acquire-global-thread-lock ()" line)
                   (search "(defun release-global-thread-lock ()" line))
            do (file-position stream position)
               (eval (read stream)))))
(load-lock-functions)

(defun check (condition message)
  (unless condition (error "~A" message)))
(defun wait-until (predicate description)
  (let ((deadline (+ (get-internal-real-time) (* 3 internal-time-units-per-second))))
    (loop until (funcall predicate)
          do (when (> (get-internal-real-time) deadline)
               (error "Timeout waiting for ~A" description))
             (sleep 0.001))))

;;; Fast path, recursive-owner rejection, and release to an empty tail.
(setf *global-thread-lock* nil)
(let ((*this-cpu* (make-cpu)))
  (acquire-global-thread-lock)
  (check (and (eq *global-thread-lock* *this-cpu*)
              (cpu-mcs-locked *this-cpu*))
         "Uncontended acquisition failed")
  (handler-case
      (progn (acquire-global-thread-lock)
             (error "Recursive acquire unexpectedly succeeded"))
    (error (condition)
      (when (search "unexpectedly succeeded" (princ-to-string condition))
        (error condition))))
  (release-global-thread-lock)
  (check (and (null *global-thread-lock*)
              (null (cpu-mcs-locked *this-cpu*)))
         "Uncontended release did not clear tail/node"))

;;; Queue four CPUs in known order while CPU 0 owns the lock.
(setf *global-thread-lock* nil)
(let* ((cpus (loop repeat 5 collect (make-cpu)))
       (threads nil)
       (order nil)
       (*this-cpu* (first cpus)))
  (acquire-global-thread-lock)
  (loop for cpu in (rest cpus)
        for index from 1
        for predecessor in cpus
        do (let ((waiter-cpu cpu)
                 (waiter-index index))
             (push (sb-thread:make-thread
                    (lambda ()
                      (let ((*this-cpu* waiter-cpu) (*interrupts-disabled* t))
                        (acquire-global-thread-lock)
                        (push waiter-index order)
                        (release-global-thread-lock)))
                    :name (format nil "MCS waiter ~D" waiter-index))
                   threads))
           (wait-until (lambda ()
                         (and (eq *global-thread-lock* cpu)
                              (eq (cpu-mcs-next predecessor) cpu)))
                       "ordered MCS enqueue"))
  (release-global-thread-lock)
  (dolist (thread threads) (sb-thread:join-thread thread))
  (check (equal (reverse order) '(1 2 3 4)) "MCS handoff lost FIFO order")
  (check (null *global-thread-lock*) "MCS tail remained after handoff"))

;;; A successor may exchange the tail before publishing its next link.
(setf *global-thread-lock* nil)
(let* ((owner (make-cpu))
       (waiter (make-cpu))
       (tail-exchanged nil)
       (permit-link nil)
       (released nil)
       (*this-cpu* owner))
  (setf sys.int::*after-cas-hook*
        (lambda (previous replacement)
          (when (and (eq previous owner) (eq replacement waiter))
            (setf tail-exchanged t)
            (loop until permit-link do (sb-thread:thread-yield)))))
  (acquire-global-thread-lock)
  (let ((waiting-thread
          (sb-thread:make-thread
           (lambda ()
             (let ((*this-cpu* waiter) (*interrupts-disabled* t))
               (acquire-global-thread-lock)
               (release-global-thread-lock))))))
    (wait-until (lambda () tail-exchanged) "tail exchange before link")
    (let ((release-thread
            (sb-thread:make-thread
             (lambda ()
               (let ((*this-cpu* owner) (*interrupts-disabled* t))
                 (release-global-thread-lock)
                 (setf released t))))))
      (sleep 0.01)
      (check (not released) "Owner released before successor linked")
      (setf permit-link t)
      (sb-thread:join-thread waiting-thread)
      (sb-thread:join-thread release-thread)
      (check (and released (null *global-thread-lock*))
             "Delayed successor handoff did not complete")))
  (setf sys.int::*after-cas-hook* nil))

;;; The stack transition must precede the only switch-path release on both ISAs.
(defun file-text (relative)
  (with-open-file (stream (merge-pathnames relative *load-truename*))
    (let ((text (make-string (file-length stream))))
      (read-sequence text stream)
      text)))
(let ((common (file-text "../../supervisor/thread.lisp"))
      (x86 (file-text "../../supervisor/x86-64/thread.lisp"))
      (arm (file-text "../../supervisor/arm64/thread.lisp")))
  (check (search "(%%finish-switch-via-cpu-stack new-thread)" common)
         "Common switch bypasses stack trampoline")
  (let* ((finish (search "(defun %%finish-switch-on-cpu-stack" common))
         (release (and finish (search "(release-global-thread-lock)" common :start2 finish)))
         (restore (and release (search "(if (thread-full-save-p new-thread)" common :start2 release))))
    (check (and finish release restore (< finish release restore))
           "Release is not in private-stack finish function"))
  (check (< (search "(sys.lap-x86:mov64 :rsp (:object-location nil #.+x86-64-cpu-wired-stack-pointer+))" x86)
            (search "(sys.lap-x86:call (:named-call %%finish-switch-on-cpu-stack))" x86))
         "x86 calls release before moving to private stack")
  (check (and (not (search "(:symbol-global-cell *global-thread-lock*)" x86))
              (not (search "(:symbol-global-cell *global-thread-lock*)" arm)))
         "A restore path still releases the lock on the old stack")
  (let* ((start (search "(sys.int::define-lap-function %%finish-switch-via-cpu-stack" arm))
         (select (and start (search "(mezzano.lap.arm64:msr :spsel 1)" arm :start2 start)))
         (top (and select (search "(mezzano.lap.arm64:add :sp :x27 0)" arm :start2 select)))
         (call (and top (search "(mezzano.lap.arm64:named-call %%finish-switch-on-cpu-stack)" arm :start2 top))))
    (check (and start select top call (< start select top call))
           "ARM calls release before moving to SP_EL1")))

(format t "MCS host: FIFO, delayed link, no nesting, private stack transition passed~%")
