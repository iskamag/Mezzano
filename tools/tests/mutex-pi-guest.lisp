;;;; Target-only mutex priority inheritance regression. RUN is called by a
;;;; private test image after scheduler initialization; loading is inert.
(defpackage :mezzano.mutex-pi-test (:use :cl) (:export :run))
(in-package :mezzano.mutex-pi-test)

(defun check (test reason)
  (unless test
    (mezzano.supervisor:panic "Mutex PI regression: " reason)))

(defun await-waiter (thread mutex)
  (loop repeat 100000
        when (mezzano.supervisor::safe-without-interrupts (thread mutex)
               (mezzano.supervisor::with-global-thread-lock ()
                 (and (eql (mezzano.supervisor::thread-state thread) :sleeping)
                      (eql (mezzano.supervisor::thread-waiting-mutex thread) mutex))))
          do (return-from await-waiter t)
        do (mezzano.supervisor:thread-yield))
  (check nil :waiter-timeout))

(defun await-event (event)
  (loop repeat 100000
        when (mezzano.supervisor:event-state event)
          do (return-from await-event t)
        do (mezzano.supervisor:thread-yield))
  (check nil :event-timeout))

(defun check-priority (thread expected)
  (check (mezzano.supervisor::safe-without-interrupts (thread expected)
           (mezzano.supervisor::with-global-thread-lock ()
             (eql (mezzano.supervisor:thread-priority thread) expected)))
         :effective-priority))

(defun run-release-order (high-first)
  (let* ((a (mezzano.supervisor:make-mutex "PI A"))
         (b (mezzano.supervisor:make-mutex "PI B"))
         (ready (mezzano.supervisor:make-event))
         (release-first (mezzano.supervisor:make-event))
         (first-done (mezzano.supervisor:make-event))
         (release-second (mezzano.supervisor:make-event))
         (owner (mezzano.supervisor:make-thread
                 (lambda ()
                   (mezzano.supervisor:acquire-mutex a)
                   (mezzano.supervisor:acquire-mutex b)
                   (setf (mezzano.supervisor:event-state ready) t)
                   (mezzano.supervisor:event-wait release-first)
                   (mezzano.supervisor:release-mutex (if high-first a b))
                   (setf (mezzano.supervisor:event-state first-done) t)
                   (mezzano.supervisor:event-wait release-second)
                   (mezzano.supervisor:release-mutex (if high-first b a))
                   :owner-done)
                 :name "PI low owner" :priority :low)))
    ;; The controller thread is normal priority and OWNER is low priority.
    ;; Polling with THREAD-YIELD here would starve OWNER on one CPU.
    (mezzano.supervisor:event-wait ready)
    (let ((high (mezzano.supervisor:make-thread
                  (lambda ()
                    (mezzano.supervisor:with-mutex (a) :high-done))
                  :name "PI high waiter" :priority :high))
          (normal (mezzano.supervisor:make-thread
                    (lambda ()
                      (mezzano.supervisor:with-mutex (b) :normal-done))
                    :name "PI normal waiter" :priority :normal)))
      (await-waiter high a)
      (await-waiter normal b)
      (check-priority owner :high)
      (setf (mezzano.supervisor:event-state release-first) t)
      (await-event first-done)
      (check-priority owner (if high-first :normal :high))
      (setf (mezzano.supervisor:event-state release-second) t)
      (check (equal (mezzano.supervisor:thread-join owner) '(:owner-done)) :owner-join)
      (check (equal (mezzano.supervisor:thread-join high) '(:high-done)) :high-join)
      (check (equal (mezzano.supervisor:thread-join normal) '(:normal-done)) :normal-join)
      (check-priority owner :low))))

(defun run-transitive ()
  (let* ((a (mezzano.supervisor:make-mutex "PI chain A"))
         (b (mezzano.supervisor:make-mutex "PI chain B"))
         (low-ready (mezzano.supervisor:make-event))
         (middle-ready (mezzano.supervisor:make-event))
         (release-a (mezzano.supervisor:make-event))
         (after-a (mezzano.supervisor:make-event))
         (release-b (mezzano.supervisor:make-event))
         (low (mezzano.supervisor:make-thread
               (lambda ()
                 (mezzano.supervisor:acquire-mutex a)
                 (setf (mezzano.supervisor:event-state low-ready) t)
                 (mezzano.supervisor:event-wait release-a)
                 (mezzano.supervisor:release-mutex a)
                 :low-done)
               :name "PI chain low" :priority :low)))
    ;; Block until LOW owns A, so strict priority cannot starve it.
    (mezzano.supervisor:event-wait low-ready)
    (let ((middle (mezzano.supervisor:make-thread
                   (lambda ()
                     (mezzano.supervisor:acquire-mutex b)
                     (setf (mezzano.supervisor:event-state middle-ready) t)
                     (mezzano.supervisor:acquire-mutex a)
                     (mezzano.supervisor:release-mutex a)
                     (setf (mezzano.supervisor:event-state after-a) t)
                     (mezzano.supervisor:event-wait release-b)
                     (mezzano.supervisor:release-mutex b)
                     :middle-done)
                   :name "PI chain middle" :priority :normal)))
      (mezzano.supervisor:event-wait middle-ready)
      (await-waiter middle a)
      (let ((high (mezzano.supervisor:make-thread
                    (lambda ()
                      (mezzano.supervisor:with-mutex (b) :high-done))
                    :name "PI chain high" :priority :high)))
        (await-waiter high b)
        (check-priority middle :high)
        (check-priority low :high)
        (setf (mezzano.supervisor:event-state release-a) t)
        (mezzano.supervisor:event-wait after-a)
        (check-priority low :low)
        (check-priority middle :high)
        (setf (mezzano.supervisor:event-state release-b) t)
        (check (equal (mezzano.supervisor:thread-join middle) '(:middle-done))
               :middle-join)
        (check (equal (mezzano.supervisor:thread-join high) '(:high-done))
               :chain-high-join)
        (check (equal (mezzano.supervisor:thread-join low) '(:low-done))
               :chain-low-join)
        (check-priority middle :normal)))))

(defun run-transfer-with-waiters ()
  (let* ((mutex (mezzano.supervisor:make-mutex "PI transfer"))
         (ready (mezzano.supervisor:make-event))
         (release-owner (mezzano.supervisor:make-event))
         (first-owns (mezzano.supervisor:make-event))
         (release-first (mezzano.supervisor:make-event))
         (owner (mezzano.supervisor:make-thread
                 (lambda ()
                   (mezzano.supervisor:acquire-mutex mutex)
                   (setf (mezzano.supervisor:event-state ready) t)
                   (mezzano.supervisor:event-wait release-owner)
                   (mezzano.supervisor:release-mutex mutex)
                   :owner-done)
                 :name "PI transfer owner" :priority :low)))
    (mezzano.supervisor:event-wait ready)
    (let ((first (mezzano.supervisor:make-thread
                   (lambda ()
                     (mezzano.supervisor:acquire-mutex mutex)
                     (setf (mezzano.supervisor:event-state first-owns) t)
                     (mezzano.supervisor:event-wait release-first)
                     (mezzano.supervisor:release-mutex mutex)
                     :first-done)
                   :name "PI first waiter" :priority :normal)))
      (await-waiter first mutex)
      (let ((second (mezzano.supervisor:make-thread
                      (lambda ()
                        (mezzano.supervisor:with-mutex (mutex) :second-done))
                      :name "PI second waiter" :priority :high)))
        (await-waiter second mutex)
        (check-priority owner :high)
        (setf (mezzano.supervisor:event-state release-owner) t)
        (mezzano.supervisor:event-wait first-owns)
        (check-priority owner :low)
        (check-priority first :high)
        (setf (mezzano.supervisor:event-state release-first) t)
        (check (equal (mezzano.supervisor:thread-join first) '(:first-done))
               :first-transfer-join)
        (check (equal (mezzano.supervisor:thread-join second) '(:second-done))
               :second-transfer-join)
        (check (equal (mezzano.supervisor:thread-join owner) '(:owner-done))
               :transfer-owner-join)
        (check-priority first :normal)))))

(defun run-foothold-withdrawal ()
  (let* ((mutex (mezzano.supervisor:make-mutex "PI foothold"))
         (ready (mezzano.supervisor:make-event))
         (release-owner (mezzano.supervisor:make-event))
         (owner (mezzano.supervisor:make-thread
                 (lambda ()
                   (mezzano.supervisor:acquire-mutex mutex)
                   (setf (mezzano.supervisor:event-state ready) t)
                   (mezzano.supervisor:event-wait release-owner)
                   (mezzano.supervisor:release-mutex mutex)
                   :owner-done)
                 :name "PI foothold owner" :priority :low)))
    (mezzano.supervisor:event-wait ready)
    (let ((waiter (mezzano.supervisor:make-thread
                   (lambda ()
                     (mezzano.supervisor:with-mutex (mutex) :unexpected-acquire))
                   :name "PI foothold waiter" :priority :high)))
      (await-waiter waiter mutex)
      (check-priority owner :high)
      (mezzano.supervisor:terminate-thread waiter)
      (multiple-value-bind (result donep)
          (mezzano.supervisor:thread-join waiter)
        (declare (ignore result))
        (check donep :foothold-join))
      (check-priority owner :low)
      (setf (mezzano.supervisor:event-state release-owner) t)
      (check (equal (mezzano.supervisor:thread-join owner) '(:owner-done))
             :foothold-owner-join))))

(defun run ()
  (mezzano.supervisor:debug-print-line "MUTEX-PI-TEST-BEGIN")
  (run-release-order t)
  (run-release-order nil)
  (run-transitive)
  (run-transfer-with-waiters)
  (run-foothold-withdrawal)
  (mezzano.supervisor:debug-print-line "MUTEX-PI-TEST-PASSED")
  :passed)
