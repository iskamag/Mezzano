;;; Execute source PI functions against a deterministic scheduler model.
;;; From Mezzano/: sbcl --script tools/tests/mutex-pi-host.lisp
(defpackage :mutex-pi-host (:use :cl))
(in-package :mutex-pi-host)

(defun source-form (file name)
  (let* ((source (with-open-file (stream file)
                   (let ((text (make-string (file-length stream))))
                     (read-sequence text stream) text)))
         (start (search (string-downcase (format nil "(defun ~A " name)) source)))
    (assert start () "Missing source function ~A" name)
    (read-from-string source nil nil :start start)))
(defpackage :sys.int (:use :cl))
(defstruct thread (priority :normal) (base-priority :normal)
  (owned-mutexes nil) (waiting-mutex nil) (state :sleeping) (queue nil)
  (wait-item nil) (unsleep-helper nil) (unsleep-helper-argument nil))
(defstruct mutex owner owned-next pi-linked-p head (state :unlocked) name
  (contested-count 0))
(defvar *global-locked* t)
(defvar *high-queue* nil)
(defvar *normal-queue* nil)
(defvar *low-queue* nil)
(defun ensure-global-thread-lock-held () (assert *global-locked*))
(defun run-queue-for-priority (priority)
  (ecase priority (:high :high) (:normal :normal) (:low :low)))
(defun run-queue-linked-p (thread) (thread-queue thread))
(defun run-queue-remove (thread queue)
  (assert (eql (thread-queue thread) queue))
  (setf (thread-queue thread) nil))
(defun push-run-queue (thread)
  (setf (thread-queue thread) (run-queue-for-priority (thread-priority thread))))
(defmacro do-wait-queue ((thread mutex &optional result) &body body)
  `(dolist (,thread (mutex-head ,mutex) ,result) ,@body))
(defun wait-queue-empty-p (mutex) (null (mutex-head mutex)))
(defun pop-wait-queue (mutex) (pop (mutex-head mutex)))
(defun wake-thread-1 (thread)
  (setf (thread-state thread) :runnable)
  (push-run-queue thread))
(defun panic (&rest args) (error "Panic: ~S" args))
(dolist (name '(thread-priority-rank thread-priority-higher-p
                set-thread-effective-priority))
  (eval (source-form "supervisor/thread.lisp" name)))
(dolist (name '(mutex-link-owner mutex-unlink-owner mutex-effective-priority
                mutex-propagate-priority mutex-wait-cycle-p
                mutex-waiter-removed mutex-release-locked))
  (eval (source-form "supervisor/sync.lisp" name)))

(defun owner (priority)
  (let ((thread (make-thread :priority priority :base-priority priority
                             :state :runnable)))
    (push-run-queue thread)
    thread))
(defun waiter (priority mutex)
  (make-thread :priority priority :base-priority priority
               :waiting-mutex mutex :state :sleeping))
(defun check-priority (thread expected)
  (assert (eql (thread-priority thread) expected))
  (when (eql (thread-state thread) :runnable)
    (assert (eql (thread-queue thread)
                 (run-queue-for-priority expected)))))

;; Two owned mutexes: releasing either order retains the other donation.
(dolist (release-high-first '(nil t))
  (let* ((low (owner :low))
         (high-mutex (make-mutex))
         (normal-mutex (make-mutex))
         (high (waiter :high high-mutex))
         (normal (waiter :normal normal-mutex)))
    (mutex-link-owner high-mutex low)
    (mutex-link-owner normal-mutex low)
    (setf (mutex-head high-mutex) (list high)
          (mutex-head normal-mutex) (list normal))
    (mutex-propagate-priority low)
    (check-priority low :high)
    (if release-high-first
        (progn
          (mutex-release-locked high-mutex)
          (check-priority low :normal)
          (mutex-release-locked normal-mutex))
        (progn
          (mutex-release-locked normal-mutex)
          (check-priority low :high)
          (mutex-release-locked high-mutex)))
    (check-priority low :low)))

;; FIFO transfer keeps donations from the remaining waiter.
(let* ((low (owner :low))
       (mutex (make-mutex))
       (first (waiter :normal mutex))
       (second (waiter :high mutex)))
  (mutex-link-owner mutex low)
  (setf (mutex-head mutex) (list first second))
  (mutex-propagate-priority low)
  (mutex-release-locked mutex)
  (assert (eql (mutex-owner mutex) first))
  (assert (null (thread-waiting-mutex first)))
  (check-priority low :low)
  (check-priority first :high)
  (mutex-release-locked mutex)
  (check-priority first :normal)
  (assert (eql (mutex-owner mutex) second)))

;; Donation and withdrawal propagate through a blocked owner.
(let* ((first (owner :low))
       (second (owner :normal))
       (a (make-mutex))
       (b (make-mutex))
       (high (waiter :high b)))
  (mutex-link-owner a first)
  (mutex-link-owner b second)
  (setf (thread-state second) :sleeping
        (thread-queue second) nil
        (thread-waiting-mutex second) a
        (mutex-head a) (list second)
        (mutex-head b) (list high))
  (mutex-propagate-priority second)
  (check-priority second :high)
  (check-priority first :high)
  (setf (mutex-head b) nil)
  (mutex-waiter-removed b high)
  (check-priority second :normal)
  (check-priority first :normal)
  (assert (mutex-wait-cycle-p first second)))

;; Supervisor is an execution domain, not a transferable donation.
(let* ((ordinary (owner :normal))
       (mutex (make-mutex))
       (supervisor (waiter :supervisor mutex)))
  (mutex-link-owner mutex ordinary)
  (setf (mutex-head mutex) (list supervisor))
  (mutex-propagate-priority ordinary)
  (check-priority ordinary :high)
  (assert (eql (thread-base-priority ordinary) :normal))
  (setf (mutex-head mutex) nil)
  (mutex-waiter-removed mutex supervisor)
  (check-priority ordinary :normal))
;; Execute the actual acquisition/release front ends, including the
;; allocator-era path before the scheduler is initialized.
(defvar *mutex-pi-ready* nil)
(defvar *lock-violations-are-fatal* t)
(defvar *pseudo-atomic* nil)
(defvar *current* nil)
(defvar *interrupts-excluded* nil)
(defvar *before-global-lock* nil)
(defun current-thread () *current*)
(defmacro safe-without-interrupts ((&rest captures) &body body)
  (declare (ignore captures)) `(let ((*interrupts-excluded* t)) ,@body))
(defmacro sys.int::cas (place old new)
  `(let ((previous ,place))
     (when *mutex-pi-ready*
       (assert (and *interrupts-excluded* *global-locked*)))
     (when (eql previous ,old) (setf ,place ,new))
     previous))
(defmacro sys.int::atomic-incf (place) `(incf ,place))
(defmacro thread-pool-blocking-hijack (&rest ignored)
  (declare (ignore ignored)) nil)
(defun acquire-global-thread-lock ()
  (assert *interrupts-excluded*)
  (when *before-global-lock*
    (let ((hook *before-global-lock*))
      (setf *before-global-lock* nil)
      (funcall hook)))
  (assert (not *global-locked*))
  (setf *global-locked* t))
(defun release-global-thread-lock () (assert *global-locked*) (setf *global-locked* nil))
(defun lock-wait-queue (mutex) (declare (ignore mutex)))
(defun unlock-wait-queue (mutex) (declare (ignore mutex)))
(dolist (name '(mutex-held-p check-mutex-release-consistence
                acquire-mutex acquire-mutex-slow-path release-mutex))
  (eval (source-form "supervisor/sync.lisp" name)))
(let* ((*global-locked* nil)
       (*mutex-pi-ready* nil)
       (*current* (owner :normal))
       (mutex (make-mutex)))
  (assert (acquire-mutex mutex))
  (assert (eql (mutex-owner mutex) *current*))
  (assert (not (mutex-pi-linked-p mutex)))
  ;; Transitioning to the live scheduler must still allow the early holder
  ;; to release; no PI list entry existed before initialization.
  (setf *mutex-pi-ready* t)
  (release-mutex mutex)
  (assert (eql (mutex-state mutex) :unlocked))
  (assert (acquire-mutex mutex))
  (assert (mutex-pi-linked-p mutex))
  (assert (eql (mutex-state mutex) :locked))
  (release-mutex mutex)
  (assert (null (thread-owned-mutexes *current*))))
;; Force the slow path to acquire immediately before the fast path takes the
;; scheduler lock. The fast CAS must then fail; publishing before the lock
;; would expose an ownerless mutex to the slow path.
(let* ((*global-locked* nil)
       (*mutex-pi-ready* t)
       (*current* (owner :normal))
       (other (owner :normal))
       (mutex (make-mutex))
       (*before-global-lock*
         (lambda ()
           (assert (eql (mutex-state mutex) :unlocked))
           (safe-without-interrupts ()
             (acquire-mutex-slow-path nil nil mutex other)))))
  (assert (null (acquire-mutex mutex nil)))
  (assert (eql (mutex-owner mutex) other))
  (assert (mutex-pi-linked-p mutex))
  (assert (eql (mutex-state mutex) :locked)))
;; The actual UNSLEEP-THREAD foothold/cancellation path must remove a
;; mutex waiter and withdraw its donation before making it runnable.
(defmacro with-global-thread-lock (() &body body)
  `(progn (acquire-global-thread-lock)
          (unwind-protect (progn ,@body) (release-global-thread-lock))))
(defmacro with-symbol-spinlock ((place) &body body)
  (declare (ignore place))
  `(with-global-thread-lock () ,@body))
(defmacro ensure (condition &rest ignored)
  (declare (ignore ignored)) `(assert ,condition))
(defun wait-queue-p (object) (mutex-p object))
(defun remove-from-wait-queue (thread mutex)
  (setf (mutex-head mutex) (remove thread (mutex-head mutex))))
(defvar *forced-calls* 0)
(defun force-call-on-thread (&rest ignored)
  (declare (ignore ignored)) (incf *forced-calls*))
(eval (source-form "supervisor/thread.lisp" 'unsleep-thread))
(let* ((*global-locked* t)
       (low (owner :low))
       (mutex (make-mutex))
       (high (waiter :high mutex)))
  (mutex-link-owner mutex low)
  (setf (mutex-head mutex) (list high)
        (thread-wait-item high) mutex
        (thread-unsleep-helper high) :retry)
  (mutex-propagate-priority low)
  (check-priority low :high)
  (setf *global-locked* nil)
  (unsleep-thread high)
  (check-priority low :low)
  (assert (null (mutex-head mutex)))
  (assert (null (thread-waiting-mutex high)))
  (assert (eql (thread-state high) :runnable))
  (assert (= *forced-calls* 1)))
(format t "Mutex PI host checks passed: nested orders, transfer, runnable moves, transitive withdrawal, cycles, supervisor cap.~%")
