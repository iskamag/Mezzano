;;;; Run with sbcl --script tools/tests/format-early-host.lisp.
;;;; Load the early implementation into a private package on SBCL.
(defpackage :mezzano.internals (:use :cl))
(defpackage :mezzano.gray (:use :cl) (:export #:stream-line-column))
(defpackage :mezzano.format (:use :cl) (:shadow #:format #:formatter))
(declaim (declaration mezzano.internals::lambda-name))
(load (merge-pathnames "../../system/format.lisp" *load-truename*))

(let ((early (symbol-function (find-symbol "FORMAT" :mezzano.format)))
      (cases '(("~5A" "xy")
               ("~5@A" "xy")
               ("~5,3,1,'*A" "xy")
               ("~5,3,1,'*@S" "xy")
               ("~5:@A" nil)
               ("~vA/~D" 5 "xy" 9)
               ("~v[~D~;~D~]" 1 9)
               ("~D tr~:@P / ~D win~:P" 7 1)
               ("~P ~P ~@P" :foo 1.0 1)
               ("~D ~:P~D" 2 5)
               ("~{~D~:P~}" (1 2))
               ("~@{~D~:P~}" 1 2)
               ("~:[~:P~;~:P~]" nil)
               ("~@?~:P" "~D" 1)
               ("~?~P" "~D~:P" (2) 1))))
  (dolist (case cases)
    (let ((expected (apply #'format nil case))
          (actual (apply early nil case)))
      (assert (string= actual expected) () "~S: got ~S, expected ~S" case actual expected)))
  (let ((object (list :a)) (*print-circle* t))
    (setf (cdr object) object)
    (assert (string= (funcall early nil "~20@S" object)
                     (format nil "~20@S" object))))
  (format t "Early format host regressions: ~D checks passed.~%" (1+ (length cases))))
