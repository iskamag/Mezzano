;;;; Target-only worker. Load this LLF wired in an isolated native image.
;;;; The final deliberate THROW must panic before the outer catch can return.
(defpackage :mezzano.world-stop-test (:use :cl) (:export :run))
(in-package :mezzano.world-stop-test)
(mezzano.internals::defglobal *mutation* 0)
(mezzano.internals::defglobal *allocation-control* nil)
(defun check (test reason)
  (unless test (mezzano.supervisor:panic "World-stop native test: " reason)))
(defun normal-worker ()
  (let ((thread (mezzano.supervisor:current-thread)))
    (check (eq thread mezzano.supervisor::*world-stopper*) :actual-stopper)
    (check (plusp (mezzano.supervisor::thread-inhibit-footholds thread)) :foothold-inhibition)
    (check (null (mezzano.supervisor::thread-allow-with-footholds thread)) :foothold-reopening)
    (check (null (mezzano.supervisor::thread-thread-pool thread)) :pool-inhibition)
    (setf *mutation* 17)
    (values 17 nil :third)))
(defun failed-worker ()
  (normal-worker)
  (mezzano.supervisor:debug-print-line "WORLD-STOP-NATIVE-FAILURE-ARMED")
  (throw 'native-abort :escaped))
(defun run ()
  (mezzano.supervisor:debug-print-line "WORLD-STOP-NATIVE-BEGIN")
  (let* ((thread (mezzano.supervisor:current-thread))
         (before (mezzano.supervisor:thread-bytes-consed thread)))
    (setf *allocation-control* (cons :allocation-control 17))
    (check (< before (mezzano.supervisor:thread-bytes-consed thread)) :allocation-calibration))
  (let* ((thread (mezzano.supervisor:current-thread))
         (before (mezzano.supervisor:thread-bytes-consed thread)))
    ;; Includes the first call; no warm-up is excluded from this counter.
    (dotimes (i 8)
      (multiple-value-bind (a b c)
          (mezzano.supervisor:call-with-world-stopped-or-panic #'normal-worker)
        (check (and (= a 17) (null b) (eq c :third)) :multiple-values))
      (check (not (eq thread mezzano.supervisor::*world-stopper*)) :released))
    (check (= before (mezzano.supervisor:thread-bytes-consed thread)) :entry-allocation))
  (mezzano.supervisor:debug-print-line "WORLD-STOP-NATIVE-NORMAL-PASSED")
  (catch 'native-abort
    (mezzano.supervisor:call-with-world-stopped-or-panic #'failed-worker))
  (mezzano.supervisor:debug-print-line "WORLD-STOP-NATIVE-ESCAPED")
  (mezzano.supervisor:panic "World-stop failure escaped!"))
