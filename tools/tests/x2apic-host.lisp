;;; Run with: sbcl --script tools/tests/x2apic-host.lisp
;;; Execute the real LAPIC access and IPI functions with synthetic registers.

(defpackage :mezzano.supervisor (:use :cl))
(defpackage :sys.lap-x86 (:use :cl))
(export '(sys.lap-x86::mov64 sys.lap-x86::shr64 sys.lap-x86::mov32
          sys.lap-x86::wrmsr sys.lap-x86::xor32 sys.lap-x86::ret)
        :sys.lap-x86)
(defpackage :sys.int (:use :cl) (:export #:msr #:%cpuid))
(in-package :sys.int)
(defconstant +n-fixnum-bits+ 1)
(defvar mezzano.supervisor::*irq-disabled* nil)
(defvar *msrs* (make-hash-table))
(defvar *events* nil)
(defvar *cpuid-values* '(0 0 0 0))
(defun msr (register) (gethash register *msrs* 0))
(defun (setf msr) (value register)
  (setf (gethash register *msrs*) value)
  (push (list :msr register value mezzano.supervisor::*irq-disabled*) *events*)
  value)
(defun %cpuid (leaf subleaf)
  (assert (and (= leaf 1) (= subleaf 0)))
  (assert mezzano.supervisor::*irq-disabled*)
  (values-list *cpuid-values*))

(in-package :mezzano.supervisor)
(defvar *irq-disabled* nil)
(defvar *lapic-address* nil)
(defvar *lapic-x2apic-mode* nil)
(defvar *cpus* nil)
(defvar *current-cpu* nil)
(defvar *mmio* (make-hash-table))
(defmacro safe-without-interrupts ((&rest captures) &body body)
  (declare (ignore captures))
  `(let ((*irq-disabled* t)) ,@body))
(defun physical-memref-unsigned-byte-32 (address)
  (gethash address *mmio* 0))
(defun (setf physical-memref-unsigned-byte-32) (value address)
  (setf (gethash address *mmio*) value)
  (push (list :mmio address value *irq-disabled*) sys.int::*events*)
  value)
(defstruct x86-64-cpu apic-id state)
(defun local-cpu ()
  ;; An unguarded iteration can move from CPU A to B between selections.
  (unless *irq-disabled*
    (setf *current-cpu* (second *cpus*)))
  *current-cpu*)

(defun load-cpu-forms ()
  (let ((source (merge-pathnames "../../supervisor/x86-64/cpu.lisp" *load-truename*))
        (names '(lapic-reg lapic-eoi lapic-initialized-p lapic-x2apic-p
                 send-ipi send-self-ipi send-ipi-to-cpu send-ipi-to-all
                 broadcast-ipi x2apic-supported-p read-local-apic-id)))
    (with-open-file (stream source)
      (loop for position = (file-position stream)
            for line = (read-line stream nil)
            while line
            when (and (>= (length line) 7)
                      (string= line "(defun " :end1 7))
              do (let* ((name-start 7)
                        (name-end (position #\Space line :start name-start))
                        (name (and name-end (subseq line name-start name-end))))
                   (when (or (member (and name (intern (string-upcase name))) names)
                             (search "(defun (setf lapic-reg)" line))
                     (file-position stream position)
                     (eval (read stream))))))))
(defconstant +x2apic-msr-base+ #x800)
(defconstant +x2apic-msr-icr+ #x830)
(defconstant +x2apic-msr-self-ipi+ #x83f)
(defconstant +icr-all-including-self+ (ash 2 18))
(defconstant +icr-all-excluding-self+ (ash 3 18))
(defconstant +lapic-reg-id+ #x02)
(defconstant +lapic-reg-eoi+ #x0b)
(defconstant +lapic-reg-interrupt-command-low+ #x30)
(defconstant +lapic-reg-interrupt-command-high+ #x31)
(defconstant +ipi-type-fixed+ 0)
(defconstant +icr-level-assert+ #x4000)
(defconstant +cpuid-feature-x2apic+ 21)

(defun load-icr-lap-form ()
  (with-open-file (stream (merge-pathnames "../../supervisor/x86-64/cpu.lisp" *load-truename*))
    (loop for position = (file-position stream)
          for line = (read-line stream nil)
          while line
          when (search "(sys.int::define-lap-function %write-x2apic-icr " line)
            do (file-position stream position)
               (return (read stream)))))
(defvar *icr-lap-form* (load-icr-lap-form))
(assert (equal (third *icr-lap-form*) '((target command))))
(assert (equal (fourth *icr-lap-form*) '(:gc :no-frame :layout #*0)))
(defun execute-icr-lap (target command)
  ;; Minimal interpreter for this helper's register operations. It checks the
  ;; actual LAP form, including return convention and WRMSR register packing.
  (let ((registers (make-hash-table))
        (write nil))
    (setf (gethash :r8 registers) (ash target 1)
          (gethash :r9 registers) (ash command 1)
          (gethash :r14 registers) :nil-object)
    (dolist (instruction (cdddr *icr-lap-form*))
      (when (consp instruction)
        (let ((op (symbol-name (first instruction))))
          (cond ((string= op "GC") nil)
                ((string= op "MOV64")
                 (setf (gethash (second instruction) registers)
                       (gethash (third instruction) registers)))
                ((string= op "SHR64")
                 (setf (gethash (second instruction) registers)
                       (ash (gethash (second instruction) registers)
                            (- (third instruction)))))
                ((string= op "MOV32")
                 (setf (gethash (second instruction) registers)
                       (logand (third instruction) #xffffffff)))
                ((string= op "WRMSR")
                 (assert (= (gethash :ecx registers) #x830))
                 (setf write (logior (ash (logand (gethash :rdx registers) #xffffffff) 32)
                                     (logand (gethash :rax registers) #xffffffff))))
                ((string= op "XOR32")
                 (assert (eq (second instruction) (third instruction)))
                 (setf (gethash (second instruction) registers) 0))
                ((string= op "RET") nil)
                (t (error "Unexpected ICR LAP instruction: ~S" instruction))))))
    (assert (eql (gethash :ecx registers) 0))
    (assert (eq (gethash :r8 registers) :nil-object))
    (assert write)
    write))
(defun %write-x2apic-icr (target command)
  (assert *irq-disabled*)
  (let ((value (execute-icr-lap target command)))
    (setf (gethash #x830 sys.int::*msrs*) value)
    (push (list :msr #x830 value *irq-disabled*) sys.int::*events*)
    (values)))
(define-condition apic-id-panic (error) ())
(defun panic (&rest messages)
  (declare (ignore messages))
  (error 'apic-id-panic))
(load-cpu-forms)
(defun load-secondary-id-guard ()
  (with-open-file (stream (merge-pathnames "../../supervisor/x86-64/cpu.lisp" *load-truename*))
    (loop for position = (file-position stream)
          for line = (read-line stream nil)
          while line
          when (search "(defun register-secondary-cpu (apic-id)" line)
            do (file-position stream position)
               (let ((definition (read stream)))
                 (return (eval `(lambda (apic-id) ,(fourth definition))))))))
(defvar *secondary-id-guard* (load-secondary-id-guard))

(defun check (condition message)
  (unless condition (error "~A" message)))
(defun reset-registers ()
  (clrhash *mmio*)
  (clrhash sys.int::*msrs*)
  (setf sys.int::*events* nil))
(defun events () (reverse sys.int::*events*))

;; Register access uses APIC MMIO register spacing or x2APIC MSR numbering.
(reset-registers)
(let ((*lapic-address* #xfee00000) (*lapic-x2apic-mode* nil))
  (setf (lapic-reg #x0b) #x1234)
  (check (= (gethash #xfee000b0 *mmio*) #x1234) "xAPIC register address")
  (check (= (lapic-reg #x0b) #x1234) "xAPIC register read")
  (lapic-eoi)
  (check (= (gethash #xfee000b0 *mmio*) 0) "xAPIC EOI"))
(reset-registers)
(let ((*lapic-x2apic-mode* t))
  (setf (lapic-reg #x0b) #x100000007)
  (check (= (sys.int::msr #x80b) 7) "x2APIC register write truncation")
  (setf (gethash #x80b sys.int::*msrs*) #xabcdef0123456789)
  (check (= (lapic-reg #x0b) #x23456789) "x2APIC register read truncation")
  (lapic-eoi)
  (check (= (sys.int::msr #x80b) 0) "x2APIC EOI"))

;; Full 32-bit physical APIC ID in x2APIC ICR; legacy high-byte destination.
(reset-registers)
(let ((*lapic-x2apic-mode* t))
  (send-ipi #x12345678 6 #x42)
  (check (equal (events) (list (list :msr #x830 #x1234567800004642 t)))
         "x2APIC directed IPI word")
  (setf (gethash #x802 sys.int::*msrs*) #x12345678)
  (check (= (read-local-apic-id) #x12345678) "x2APIC ID must be 32 bits")
  (reset-registers)
  (send-self-ipi #x55)
  (check (equal (events) (list (list :msr #x83f #x55 t)))
         "x2APIC self-IPI register"))
(dolist (target '(#x40000000 #xffffffff))
  (reset-registers)
  (let ((*lapic-x2apic-mode* t))
    (send-ipi target 6 #x42)
    (check (equal (events)
                  (list (list :msr #x830 (logior (ash target 32) #x4642) t)))
           "full-width x2APIC destination was truncated")))
(reset-registers)
(let ((*lapic-address* #xfee00000) (*lapic-x2apic-mode* nil))
  (setf (gethash (+ *lapic-address* #x20) *mmio*) #xab000000)
  (check (= (read-local-apic-id) #xab) "legacy APIC ID must be high byte")
  (send-ipi #xab 5 #x44)
  (check (equal (events) (list (list :mmio (+ *lapic-address* #x310) #xab000000 t)
                               (list :mmio (+ *lapic-address* #x300) #x4544 t)))
         "xAPIC INIT ICR high/low order and bits")
  (reset-registers)
  (setf (gethash (+ *lapic-address* #x20) *mmio*) #xab000000)
  (send-self-ipi #x55)
  (check (equal (events) (list (list :mmio (+ *lapic-address* #x310) #xab000000 t)
                               (list :mmio (+ *lapic-address* #x300) #x4055 t)))
         "legacy self-IPI target"))
(let ((*lapic-x2apic-mode* nil))
  (funcall *secondary-id-guard* #xff)
  (handler-case
      (progn (funcall *secondary-id-guard* #x100)
             (error "xAPIC accepted a CPU ID outside eight bits"))
    (apic-id-panic () t)))
(let ((*lapic-x2apic-mode* t))
  (funcall *secondary-id-guard* #xffffffff))

;; Broadcast guard and complete x2APIC shorthand words.
(reset-registers)
(let ((*lapic-address* nil) (*lapic-x2apic-mode* t))
  (broadcast-ipi 0 #x61)
  (check (null (events)) "early broadcast must be suppressed"))
(let ((*lapic-address* nil) (*lapic-x2apic-mode* t))
  (makunbound '*lapic-address*)
  (broadcast-ipi 0 #x61)
  (check (null (events)) "unbound early LAPIC address must suppress broadcast"))
(let ((*lapic-address* #xfee00000) (*lapic-x2apic-mode* t))
  (broadcast-ipi 0 #x61)
  (broadcast-ipi 0 #x62 t)
  (check (equal (events) (list (list :msr #x830 #xc4061 t)
                               (list :msr #x830 #x84062 t)))
         "x2APIC shorthand or interrupt exclusion"))

(reset-registers)
(let* ((*lapic-address* #xfee00000)
       (*lapic-x2apic-mode* nil)
       (self (make-x86-64-cpu :apic-id 1 :state :online))
       (peer (make-x86-64-cpu :apic-id 2 :state :online))
       (offline (make-x86-64-cpu :apic-id 3 :state :offline))
       (*cpus* (list self peer offline))
       (*current-cpu* self))
  (broadcast-ipi 0 #x71)
  (check (equal (events) (list (list :mmio (+ *lapic-address* #x310) #x02000000 t)
                               (list :mmio (+ *lapic-address* #x300) #x4071 t)))
         "xAPIC broadcast must exclude self/offline and inhibit migration")
  (check (eq *current-cpu* self) "broadcast allowed simulated migration")
  (reset-registers)
  (broadcast-ipi 0 #x72 t)
  (check (equal (events) (list (list :mmio (+ *lapic-address* #x310) #x01000000 t)
                               (list :mmio (+ *lapic-address* #x300) #x4072 t)
                               (list :mmio (+ *lapic-address* #x310) #x02000000 t)
                               (list :mmio (+ *lapic-address* #x300) #x4072 t)))
         "xAPIC including-self broadcast"))

;; x2APIC is CPUID.1:ECX[21], not EAX/EBX/EDX.
(let ((sys.int::*cpuid-values* (list (ash 1 21) (ash 1 21) 0 (ash 1 21))))
  (check (not (x2apic-supported-p)) "CPUID used the wrong return register"))
(let ((sys.int::*cpuid-values* (list 0 0 (ash 1 21) 0)))
  (check (x2apic-supported-p) "CPUID ECX feature bit not read"))

(format t "x2APIC host paths: access, ICR, broadcast, CPUID, APIC IDs passed~%")
