;;; Host checks of the actual IO-APIC functions with mocked MMIO and boot hooks.
;;; Run: sbcl --script tools/tests/io-apic-host.lisp
(defpackage :sys.int (:use :cl))
(defpackage :io-apic-host (:use :cl))
(in-package :io-apic-host)

(defparameter *source* (with-open-file (stream "supervisor/x86-64/io-apic.lisp")
                         (let ((string (make-string (file-length stream))))
                           (read-sequence string stream)
                           string)))
(defun source-form (kind name)
  (let ((start (search (string-downcase (format nil "(~A ~A " kind name)) *source*)))
    (assert start () "Missing source form ~A ~A" kind name)
    (read-from-string *source* nil nil :start start)))
(dolist (name '(+io-apic-reg-index+ +io-apic-reg-data+ +io-apic-version+ +io-apic-redirection+
                +io-apic-entry-mask+ +io-apic-base-vector+ +io-apic-ipi-gap-start+
                +io-apic-ipi-gap-end+ +io-apic-last-vector+ +io-apic-max-gsi+))
  (eval (source-form 'defconstant name)))
(defstruct io-apic id address (gsi-base 0) (max-redirection 0) (mmio-base 4096) (lock :unlocked))
(defvar *io-apics* nil)
(defvar *io-apic-irqs* nil)
(defvar *io-apic-active-p* nil)
(defvar *isa-irq-to-gsi* nil)
(defvar *gsi-flags* nil)
(defvar *handlers* (make-array 256 :initial-element nil))
(defun sys.int::make-simple-vector (size &optional area)
  (declare (ignore area)) (make-array size :initial-element 0))
(defun sys.int::simple-vector-length (vector) (length vector))
(defvar *selector* 0)
(defvar *registers* (make-hash-table))
(defvar *interleave* nil)
(defvar *pending-interleave* nil)
(defvar *interrupts-disabled* nil)
(defvar *mmio-writes* nil)
(defun hook-user-interrupt (vector handler) (setf (aref *handlers* vector) handler))
(defun debug-print-line (&rest args) (declare (ignore args)))
(defmacro safe-without-interrupts ((&rest captures) &body body)
  (declare (ignore captures)) `(let ((*interrupts-disabled* t)) ,@body))
(defmacro with-place-spinlock ((place) &body body)
  `(progn
     (assert *interrupts-disabled*)
     (assert (eq ,place :unlocked))
     (setf ,place :locked)
     (unwind-protect (progn ,@body)
       (setf ,place :unlocked)
       (when *pending-interleave*
         (setf *pending-interleave* nil)
         (io-apic-write-unlocked (first *io-apics*) #x14 #xbb)))))
(defun physical-memref-unsigned-byte-32 (address)
  (assert *interrupts-disabled*)
  (assert (= address (+ 4096 +io-apic-reg-data+)))
  (gethash *selector* *registers* 0))
(defun (setf physical-memref-unsigned-byte-32) (value address)
  (assert *interrupts-disabled*)
  (push (list *selector* address value) *mmio-writes*)
  (cond ((= address 4096)
         (setf *selector* value)
         (when *interleave*
           (setf *interleave* nil *pending-interleave* t)))
        ((= address (+ 4096 +io-apic-reg-data+))
         (setf (gethash *selector* *registers*) value))
        (t (error "Unexpected MMIO address ~X" address)))
  value)
(defconstant +4k-page-size+ 4096)
(defvar *i8259-irqs* nil)
(defvar *bsp-cpu*)
(defvar *fake-controller-p* nil)
(defun x86-64-cpu-apic-id (cpu) (declare (ignore cpu)) 0)
(defun acpi-madt-ioapic-p (entry) (declare (ignore entry)) *fake-controller-p*)
(defun acpi-madt-ioapic-address (entry) (declare (ignore entry)) 4096)
(defun acpi-madt-ioapic-id (entry) (declare (ignore entry)) 1)
(defvar *fake-gsi-base* 180)
(defun acpi-madt-ioapic-global-system-interrupt-base (entry)
  (declare (ignore entry)) *fake-gsi-base*)
(defun map-physical-memory-early (&rest args) (declare (ignore args)))
(defun align-down (address size) (* (floor address size) size))
(defun gsi-flags-polarity (flags) (declare (ignore flags)) :high)
(defun gsi-flags-trigger (flags) (declare (ignore flags)) :edge)
(defun io-apic-configure-entry (&rest args) (declare (ignore args)))
(defun make-irq (&rest args) (list :irq (getf args :platform-number)))
(defmacro push-wired (item place) `(push ,item ,place))
(dolist (name '(gsi->vector vector->gsi io-apic-read-unlocked
                io-apic-write-unlocked io-apic-read
                io-apic-write-redirection-unlocked io-apic-write-redirection
                io-apic-set-mask io-apic-mask-irq io-apic-unmask-irq
                io-apic-find-entry init-one-io-apic init-io-apic-controllers
                hook-io-apic-interrupt-handlers initialize-io-apics))
  (eval (source-form 'defun name)))

(assert (= +io-apic-max-gsi+ 188))
(assert (= (gsi->vector 79) #x7f))
(assert (= (gsi->vector 80) #x90))
(assert (= (gsi->vector +io-apic-max-gsi+) #xfc))
(assert (= (vector->gsi #xfc) +io-apic-max-gsi+))
(init-io-apic-controllers #() 0)
(assert (every #'null *io-apic-irqs*))
(setf *io-apics* (list (make-io-apic :gsi-base 0 :max-redirection 1)
                       (make-io-apic :gsi-base 188 :max-redirection 0))
      *io-apic-irqs* (make-array 189 :initial-element nil))
(setf (aref *io-apic-irqs* 0) :irq0
      (aref *io-apic-irqs* 1) :irq1
      (aref *io-apic-irqs* 188) :irq188)
(loop for vector from #xfd to #xff do (setf (aref *handlers* vector) :lapic))
(hook-io-apic-interrupt-handlers)
(assert (eq (aref *handlers* (gsi->vector 0)) 'io-apic-interrupt-handler))
(assert (null (aref *handlers* (gsi->vector 2))))
(assert (eq (aref *handlers* #xfc) 'io-apic-interrupt-handler))
(loop for vector from #xfd to #xff do (assert (eq (aref *handlers* vector) :lapic)))

(setf *interleave* t)
(io-apic-write-redirection (first *io-apics*) 1 #x12340000000000aa)
(assert (= (gethash #x12 *registers*) #xaa))
(assert (= (gethash #x13 *registers*) #x12340000))
(assert (= (gethash #x14 *registers*) #xbb))
(setf *mmio-writes* nil)
(io-apic-unmask-irq 1)
(assert (every (lambda (write) (not (= (first write) #x13))) *mmio-writes*))
(assert (zerop (logand (gethash #x12 *registers*) +io-apic-entry-mask+)))
(setf *mmio-writes* nil)
(io-apic-mask-irq 1)
(assert (every (lambda (write) (not (= (first write) #x13))) *mmio-writes*))
(assert (= (gethash #x13 *registers*) #x12340000))
(assert (not (zerop (logand (gethash #x12 *registers*) +io-apic-entry-mask+))))

;; A controller crossing the vector limit must be rejected before it is published.
(defvar *old-apics* *io-apics*)
(setf (gethash 1 *registers*) (ash 23 16))
(assert (null (init-one-io-apic :entry 0)))
(assert (eq *io-apics* *old-apics*))

;; Public lookup only exposes routed GSIs, including ISA remaps.
(defparameter *interrupt-source*
  (with-open-file (stream "supervisor/x86-64/interrupts.lisp")
    (let ((string (make-string (file-length stream))))
      (read-sequence string stream) string)))
(defun io-apic-active-p () *io-apic-active-p*)
(defun sys.int::%object-ref-t (vector index) (aref vector index))
(let ((*source* *interrupt-source*)
      (*io-apic-active-p* t)
      (*isa-irq-to-gsi* (make-array 16 :initial-element 0)))
  (setf (aref *isa-irq-to-gsi* 1) 1
        (aref *isa-irq-to-gsi* 2) 2)
  (eval (source-form 'defun 'platform-irq))
  (assert (eq (platform-irq 1) :irq1))
  (assert (null (platform-irq 2)))
  (assert (null (platform-irq 189)))
  (assert (null (platform-irq 256))))

;; Controller setup on a later boot creates fresh IRQ objects. This matches
;; INITIALIZE-I8259, which also replaces each IRQ object on every boot.
(let ((*fake-controller-p* t)
      (*fake-gsi-base* 0)
      (*gsi-flags* (make-array 256 :initial-element 0)))
  (setf (gethash 1 *registers*) (ash 15 16))
  (init-io-apic-controllers #(:controller) 1)
  (let ((old-irq (aref *io-apic-irqs* 1)))
    (init-io-apic-controllers #(:controller) 1)
    (assert (not (eq old-irq (aref *io-apic-irqs* 1))))
    (assert (null (aref *io-apic-irqs* 16)))))

;; A restart must reach controller setup and handler registration again.
(defvar *init-count* 0)
(defvar *hook-count* 0)
(defvar *final-count* 0)
(defun acpi-get-table (predicate) (declare (ignore predicate)) :madt)
(defun acpi-madt-table-controllers (madt) (declare (ignore madt)) #())
(defun process-isa-overrides (&rest ignored)
  (declare (ignore ignored)) (setf *isa-irq-to-gsi* (make-array 16 :initial-element 0)))
(defun init-io-apic-controllers (&rest ignored)
  (declare (ignore ignored))
  (incf *init-count*)
  (setf *io-apics* (list (make-io-apic))
        *io-apic-irqs* (make-array 189 :initial-element :irq))
  t)
(defun finalize-io-apic-init () (incf *final-count*) (setf *io-apic-active-p* t))
(defun hook-io-apic-interrupt-handlers () (incf *hook-count*))
;; Rebind the host replacement since INITIALIZE-IO-APICS calls the same name.
(let ((*io-apics* (list (make-io-apic))))
  (initialize-io-apics)
  (initialize-io-apics))
(assert (= *init-count* 2))
(assert (= *hook-count* 2))
(assert (= *final-count* 2))
;; A device IRQ can make a worker runnable while the interrupted thread's
;; one-shot timer is off. EOI must precede the scheduling opportunity.
(defvar *delivery-events* nil)
(defun irq-deliver (frame irq)
  (assert (eq frame :frame))
  (assert (eq irq :irq))
  (push :deliver *delivery-events*))
(defun lapic-eoi () (push :eoi *delivery-events*))
(defun maybe-preempt-via-interrupt (frame)
  (assert (eq frame :frame))
  (assert (eq (first *delivery-events*) :eoi))
  (push :preempt *delivery-events*))
(eval (source-form 'defun 'io-apic-interrupt-handler))
(setf *io-apic-irqs* (make-array 189 :initial-element nil))
(setf (aref *io-apic-irqs* 1) :irq)
(io-apic-interrupt-handler :frame (gsi->vector 1))
(assert (equal (reverse *delivery-events*) '(:deliver :eoi :preempt)))
(setf *delivery-events* nil)
(io-apic-interrupt-handler :frame (gsi->vector 2))
(assert (equal (reverse *delivery-events*) '(:eoi :preempt)))

(format t "IO-APIC host checks passed: vector boundaries, sparse hooks, serialized register writes, mask RMW, restart, preemption.~%")
